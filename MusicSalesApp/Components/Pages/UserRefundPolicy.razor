@page "/user-refund-policy"
@inherits UserRefundPolicyModel

<PageTitle>User Refund Policy - Streamtunes</PageTitle>

<div class="container my-5">
    <h1 class="mb-4">User Refund Policy</h1>
    
    <p class="text-muted"><strong>Effective Date:</strong> January 8, 2026</p>

    <div class="terms-content">
        <section class="mb-4">
            <p>
                All subscription payments are non-refundable.
            </p>
            
            <p>We do not offer refunds for:</p>
            <ul>
                <li>Partial billing periods</li>
                <li>Unused streaming time</li>
                <li>Account inactivity</li>
            </ul>
            
            <p>
                Subscriptions may be canceled at any time to prevent future charges.
            </p>
        </section>
    </div>
</div>
