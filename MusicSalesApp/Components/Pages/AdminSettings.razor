@page "/admin/settings"
@inherits AdminSettingsModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using Syncfusion.Blazor.Calendars
@attribute [Authorize(Policy = Permissions.ManageUsers)]

<PageTitle>Application Settings</PageTitle>

<h3>Application Settings</h3>

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading settings...</p>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @_errorMessage
    </div>
}
else
{
    <div class="card settings-card">
        <div class="card-header">
            <h5 class="mb-0">Platform Settings</h5>
        </div>
        <div class="card-body">
            @if (_successMessage != null)
            {
                <SfMessage Severity="MessageSeverity.Success" ShowCloseIcon="true" Closed="() => _successMessage = null">
                    @_successMessage
                </SfMessage>
            }
            
            @if (_validationErrors.Any())
            {
                <SfMessage Severity="MessageSeverity.Error">
                    <strong>Validation Errors:</strong>
                    <ul class="mb-0">
                        @foreach (var error in _validationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </SfMessage>
            }

            <div class="row mb-4">
                <div class="col-md-3">
                    <label class="form-label">Subscription Price (USD) <span class="text-danger">*</span></label>
                    <SfNumericTextBox @bind-Value="_subscriptionPrice" 
                                     Format="C2"
                                     Min="0.01m"
                                     Max="999.99m"
                                     Decimals="2"
                                     Step="0.01m"
                                     Placeholder="Enter subscription price"
                                     CssClass="e-outline" />
                    <small class="text-muted">
                        Monthly subscription price for new subscribers. Existing subscribers will continue at their original rate.
                    </small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Stream Pay Rate (per 1000 streams) <span class="text-danger">*</span></label>
                    <SfNumericTextBox @bind-Value="_streamPayRateDisplay" 
                                     Format="C2"
                                     Min="0.01m"
                                     Max="100m"
                                     Decimals="2"
                                     Step="0.25m"
                                     Placeholder="Enter pay rate"
                                     CssClass="e-outline" />
                    <small class="text-muted">
                        Amount paid to creators per 1000 streams (default $5.00). This applies to all new creators onboarded after this setting is changed.
                    </small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Stream Qualifying Seconds <span class="text-danger">*</span></label>
                    <SfNumericTextBox @bind-Value="_streamQualifyingSeconds" 
                                     Format="N0"
                                     Min="1"
                                     Max="300"
                                     Decimals="0"
                                     Step="1"
                                     Placeholder="Enter seconds"
                                     CssClass="e-outline" />
                    <small class="text-muted">
                        Number of continuous seconds of playback that qualifies as a stream (default 30). This applies to all new creators onboarded after this setting is changed.
                    </small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max Audio Upload Size (MB) <span class="text-danger">*</span></label>
                    <SfNumericTextBox @bind-Value="_maxAudioUploadSizeMB" 
                                     Format="N0"
                                     Min="1"
                                     Max="500"
                                     Decimals="0"
                                     Step="10"
                                     Placeholder="Enter size in MB"
                                     CssClass="e-outline" />
                    <small class="text-muted">
                        Maximum file size in MB allowed for audio uploads (default 100). Changes take effect immediately for all users.
                    </small>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <label class="form-label">Max Image Upload Size (MB) <span class="text-danger">*</span></label>
                    <SfNumericTextBox @bind-Value="_maxImageUploadSizeMB" 
                                     Format="N0"
                                     Min="1"
                                     Max="100"
                                     Decimals="0"
                                     Step="1"
                                     Placeholder="Enter size in MB"
                                     CssClass="e-outline" />
                    <small class="text-muted">
                        Maximum file size in MB allowed for cover art image uploads (default 20). Changes take effect immediately for all users.
                    </small>
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Note:</strong> When you change these settings:
                <ul class="mb-0">
                    <li><strong>Subscription Price:</strong> Existing subscribers continue at their original rate; new subscribers get the new price.</li>
                    <li><strong>Stream Pay Rate:</strong> This is used as the default for new creators. Existing creators keep their current rate unless manually updated.</li>
                    <li><strong>Stream Qualifying Seconds:</strong> This is used as the default for new creators. Existing creators keep their current value unless manually updated.</li>
                    <li><strong>Max Audio Upload Size:</strong> Changes apply immediately to all future uploads.</li>
                    <li><strong>Max Image Upload Size:</strong> Changes apply immediately to all future cover art uploads.</li>
                </ul>
            </div>

            <div class="d-flex gap-2 mt-4">
                <SfButton OnClick="CancelChanges" 
                          Content="Cancel" 
                          CssClass="e-btn e-outline" 
                          Disabled="@(!_hasChanges || _isSaving)" />
                <SfButton OnClick="SaveSettings" 
                          IsPrimary="true" 
                          Disabled="@(!_hasChanges || _isSaving)" 
                          CssClass="e-btn e-primary">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save Changes
                </SfButton>
            </div>
        </div>
    </div>

    <div class="card settings-card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Admin Email Notifications</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Configure which events trigger admin notification emails to admin@streamtunes.net.</p>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyRegistration" id="notifyRegistration" />
                        <label class="form-check-label" for="notifyRegistration">User Registration</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyEmailConfirmed" id="notifyEmailConfirmed" />
                        <label class="form-check-label" for="notifyEmailConfirmed">Email Confirmed</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyTaxFormCompleted" id="notifyTaxFormCompleted" />
                        <label class="form-check-label" for="notifyTaxFormCompleted">W8/W9 Tax Form Completed</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyCreatorStatusGained" id="notifyCreatorStatusGained" />
                        <label class="form-check-label" for="notifyCreatorStatusGained">Creator Status Gained</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyCreatorStatusLost" id="notifyCreatorStatusLost" />
                        <label class="form-check-label" for="notifyCreatorStatusLost">Creator Status Lost</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyUploadCompleted" id="notifyUploadCompleted" />
                        <label class="form-check-label" for="notifyUploadCompleted">Song / Cover Art Upload</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifySongRenamed" id="notifySongRenamed" />
                        <label class="form-check-label" for="notifySongRenamed">Song Renamed</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifySongArtUpdated" id="notifySongArtUpdated" />
                        <label class="form-check-label" for="notifySongArtUpdated">Song Art Updated</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_notifyTipFraudPrevented" id="notifyTipFraudPrevented" />
                        <label class="form-check-label" for="notifyTipFraudPrevented">Tip Fraud Prevented</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <SfButton OnClick="CancelNotificationChanges" 
                          Content="Cancel" 
                          CssClass="e-btn e-outline" 
                          Disabled="@(!_hasNotificationChanges || _isSavingNotifications)" />
                <SfButton OnClick="SaveNotificationSettings" 
                          IsPrimary="true" 
                          Disabled="@(!_hasNotificationChanges || _isSavingNotifications)" 
                          CssClass="e-btn e-primary">
                    @if (_isSavingNotifications)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save Notification Settings
                </SfButton>
            </div>
        </div>
    </div>

    <div class="card settings-card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Tax Bandits Maintenance Window</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Configure an upcoming Tax Bandits maintenance window. When enabled and the end time is in the future, new creators will see a warning that tax form submission is unavailable during this period, and 1099 transaction reporting will be delayed until after the window ends.</p>

            @if (_maintenanceSuccessMessage != null)
            {
                <SfMessage Severity="MessageSeverity.Success" ShowCloseIcon="true" Closed="() => _maintenanceSuccessMessage = null">
                    @_maintenanceSuccessMessage
                </SfMessage>
            }

            @if (_maintenanceValidationErrors.Any())
            {
                <SfMessage Severity="MessageSeverity.Error">
                    <strong>Validation Errors:</strong>
                    <ul class="mb-0">
                        @foreach (var error in _maintenanceValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </SfMessage>
            }

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" @bind="_maintenanceEnabled" id="maintenanceEnabled" />
                <label class="form-check-label" for="maintenanceEnabled"><strong>Enable Maintenance Window</strong></label>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label">Start Date/Time (Eastern) <span class="text-danger">*</span></label>
                    <SfDateTimePicker TValue="DateTime?" @bind-Value="_maintenanceStartEastern"
                                     Placeholder="Select start date/time"
                                     CssClass="e-outline"
                                     Enabled="@_maintenanceEnabled" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">End Date/Time (Eastern) <span class="text-danger">*</span></label>
                    <SfDateTimePicker TValue="DateTime?" @bind-Value="_maintenanceEndEastern"
                                     Placeholder="Select end date/time"
                                     CssClass="e-outline"
                                     Enabled="@_maintenanceEnabled" />
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Note:</strong> All times are entered in Eastern Time (ET) and stored as UTC internally.
                <ul class="mb-0">
                    <li>When enabled and the end time is in the future, creators will see a warning about tax form unavailability during this window, displayed in their local time zone.</li>
                    <li>1099 transaction reporting to Tax Bandits will be automatically delayed until the maintenance window ends.</li>
                    <li>The warning will automatically stop displaying once the end time has passed.</li>
                </ul>
            </div>

            <div class="d-flex gap-2 mt-4">
                <SfButton OnClick="CancelMaintenanceChanges" 
                          Content="Cancel" 
                          CssClass="e-btn e-outline" 
                          Disabled="@(!_hasMaintenanceChanges || _isSavingMaintenance)" />
                <SfButton OnClick="SaveMaintenanceSettings" 
                          IsPrimary="true" 
                          Disabled="@(!_hasMaintenanceChanges || _isSavingMaintenance)" 
                          CssClass="e-btn e-primary">
                    @if (_isSavingMaintenance)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save Maintenance Settings
                </SfButton>
            </div>
        </div>
    </div>
}
