@page "/register"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Popups
@inherits RegisterModel

<PageTitle>Create your account</PageTitle>

@*
    Same shell as Login - see the .auth-page block in app.css for why the panel keeps one
    palette in both themes.

    The submit here is cta-primary, NOT the violet Login uses. AGENTS.md picks a tier by
    audience and lists "register" under cta-primary alongside subscribe and play: these are
    listener actions, and the accent fill is the listener colour.

    The three fields stay InputText rather than SfTextBox. EditForm + DataAnnotations is what
    validates this page, and RegisterTests drives input#email / #password / #confirm directly.
*@
<div class="auth-page">
    <aside class="auth-panel">
        <img src="@Assets["images/logo-dark-small.png"]" alt="StreamTunes" class="auth-panel-logo" />

        <div class="auth-panel-copy">
            <p class="auth-panel-eyebrow">Independent music, streamed</p>
            <h1 class="auth-panel-title">Join StreamTunes.</h1>
            @* Registration collects no payment and starts no trial, so this promises only what
               a free account actually gets. *@
            <p class="auth-panel-body">Free to join. Stream the featured songs in full, build playlists and follow the artists you like.</p>
        </div>

        <div class="auth-panel-rule"></div>
    </aside>

    <section class="auth-form-col">
        <div class="auth-form">
            @if (showVerificationSection)
            {
                <h2 class="auth-title">Verify your email</h2>
                <p class="auth-subtitle">One more step before you can stream.</p>
            }
            else if (IsGoogleRegistrationPending)
            {
                <h2 class="auth-title">Almost there</h2>
                <p class="auth-subtitle">Google has given us your email address. Accept the policies below to finish creating your Google account.</p>
            }
            else
            {
                <h2 class="auth-title">Create your account</h2>
                <p class="auth-subtitle">We&rsquo;ll email you a link to verify your address.</p>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="auth-alert auth-alert-info" role="status">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                    <span>@successMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert" role="alert">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                    <span>@errorMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(infoMessage))
            {
                <div class="auth-alert auth-alert-info" role="status">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M11 7h2v2h-2V7zm0 4h2v6h-2v-6zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20z" /></svg>
                    <span>@infoMessage</span>
                </div>
            }

            @if (showVerificationSection)
            {
                <p class="auth-verify-lead">A verification email has been sent to <strong>@Email</strong>.</p>
                <p class="auth-verify-lead">Click the link in it to finish setting up your account. The link expires in <strong>10 minutes</strong>.</p>

                <SfButton OnClick="ResendVerificationEmail"
                          Disabled="@(!canResendEmail || isSubmitting)"
                          Content="@(isSubmitting ? "Sending..." : "Resend Verification Email")"
                          CssClass="e-btn cta-primary auth-submit" />

                @if (!canResendEmail)
                {
                    <p class="auth-countdown">You can request a new one in <strong>@FormatRemainingTime(secondsRemaining)</strong></p>
                }

                <div class="auth-rule"></div>

                <h3 class="auth-subhead">Change your email address</h3>
                <p class="auth-subhead-note">Made a typo? Update it and we will send a new link.</p>

                <div class="auth-field">
                    <label for="newEmail" class="auth-label">New email address</label>
                    <SfTextBox ID="newEmail" @bind-Value="NewEmail" Placeholder="you@example.com" CssClass="e-outline" />
                </div>

                <SfButton OnClick="ChangeEmail" Disabled="@isSubmitting"
                          Content="@(isSubmitting ? "Updating..." : "Update Email & Send New Verification")"
                          CssClass="e-btn e-outline auth-provider" />
            }
            else if (IsGoogleRegistrationPending)
            {
                <div class="auth-field">
                    <label for="googleEmail" class="auth-label">Email</label>
                    <SfTextBox ID="googleEmail" Value="@Email" Enabled="false" CssClass="e-outline" />
                    <p class="auth-hint">From your Google account.</p>
                </div>

                <RegisterPolicyBlock AcceptTermsOfUse="AcceptTermsOfUse"
                                     AcceptTermsOfUseChanged="v => AcceptTermsOfUse = v"
                                     AcceptPrivacyPolicy="AcceptPrivacyPolicy"
                                     AcceptPrivacyPolicyChanged="v => AcceptPrivacyPolicy = v"
                                     AcceptRefundPolicy="AcceptRefundPolicy"
                                     AcceptRefundPolicyChanged="v => AcceptRefundPolicy = v"
                                     ReceiveNewSongEmails="ReceiveNewSongEmails"
                                     ReceiveNewSongEmailsChanged="v => ReceiveNewSongEmails = v"
                                     OnShowTerms="ShowTermsOfUse"
                                     OnShowPrivacy="ShowPrivacyPolicy"
                                     OnShowRefund="ShowRefundPolicy" />

                <form method="post" action="@GoogleAuthRoutes.WebRegisterPath">
                    <input name="__RequestVerificationToken" type="hidden" value="@antiForgeryToken" />
                    <input type="hidden" name="@ExternalAuthFormFields.PendingRegistrationToken" value="@PendingGoogleRegistrationToken" />
                    <input type="hidden" name="@ExternalAuthFormFields.Email" value="@Email" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptTermsOfUse" value="@AcceptTermsOfUse.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptPrivacyPolicy" value="@AcceptPrivacyPolicy.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptRefundPolicy" value="@AcceptRefundPolicy.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.ReceiveNewSongEmails" value="@ReceiveNewSongEmails.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.ReturnUrl" value="@RegistrationReturnUrl" />

                    <SfButton Type="ButtonType.Submit" Disabled="@(!CanRegister)" Content="Complete Google Sign Up" CssClass="e-btn cta-primary auth-submit" />
                </form>
            }
            else
            {
                <EditForm Model="this" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="auth-field">
                        <label for="email" class="auth-label">Email</label>
                        <InputText id="email" class="form-control auth-input" @bind-Value="Email" placeholder="you@example.com" />
                    </div>
                    <div class="auth-field">
                        <label for="password" class="auth-label">Password</label>
                        <InputText id="password" class="form-control auth-input" type="password" @bind-Value="Password" placeholder="Choose a password" />
                        <p class="auth-hint">Must be at least 8 characters and include upper, lower, digit, and symbol.</p>
                    </div>
                    <div class="auth-field">
                        <label for="confirm" class="auth-label">Confirm password</label>
                        <InputText id="confirm" class="form-control auth-input" type="password" @bind-Value="ConfirmPassword" placeholder="Repeat the password" />
                    </div>

                    <RegisterPolicyBlock AcceptTermsOfUse="AcceptTermsOfUse"
                                         AcceptTermsOfUseChanged="v => AcceptTermsOfUse = v"
                                         AcceptPrivacyPolicy="AcceptPrivacyPolicy"
                                         AcceptPrivacyPolicyChanged="v => AcceptPrivacyPolicy = v"
                                         AcceptRefundPolicy="AcceptRefundPolicy"
                                         AcceptRefundPolicyChanged="v => AcceptRefundPolicy = v"
                                         ReceiveNewSongEmails="ReceiveNewSongEmails"
                                         ReceiveNewSongEmailsChanged="v => ReceiveNewSongEmails = v"
                                         OnShowTerms="ShowTermsOfUse"
                                         OnShowPrivacy="ShowPrivacyPolicy"
                                         OnShowRefund="ShowRefundPolicy" />

                    <SfButton Type="ButtonType.Submit" Disabled="@(isSubmitting || !CanRegister)" Content="@(isSubmitting ? "Please wait..." : "Register")" CssClass="e-btn cta-primary auth-submit" />
                </EditForm>

                <div class="auth-divider"><span>or</span></div>

                <form method="post" action="@GoogleAuthRoutes.WebStartPath">
                    <input name="__RequestVerificationToken" type="hidden" value="@antiForgeryToken" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptTermsOfUse" value="@AcceptTermsOfUse.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptPrivacyPolicy" value="@AcceptPrivacyPolicy.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.AcceptRefundPolicy" value="@AcceptRefundPolicy.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.ReceiveNewSongEmails" value="@ReceiveNewSongEmails.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="@ExternalAuthFormFields.ReturnUrl" value="@RegistrationReturnUrl" />

                    <SfButton Type="ButtonType.Submit" IsPrimary="false" CssClass="e-btn e-outline google-auth-button auth-provider">
                        <img src="/images/google_logo.svg" alt="" class="google-auth-icon" />
                        <span>Continue with Google</span>
                    </SfButton>
                </form>
            }

            <p class="auth-footer">Already have an account? <a href="@LoginUrl" class="auth-link auth-link-strong">Log in</a></p>
        </div>
    </section>
</div>

<!-- Terms of Use Dialog -->
<SfDialog @ref="_termsDialog" Width="90%" Height="80%" IsModal="true" ShowCloseIcon="true" Visible="false" CssClass="legal-dialog">
    <DialogTemplates>
        <Header>Terms of Use</Header>
        <Content>
            <iframe src="/terms-of-use" class="legal-iframe" title="Terms of Use"></iframe>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Close" OnClick="CloseTermsDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Privacy Policy Dialog -->
<SfDialog @ref="_privacyDialog" Width="90%" Height="80%" IsModal="true" ShowCloseIcon="true" Visible="false" CssClass="legal-dialog">
    <DialogTemplates>
        <Header>Privacy Policy</Header>
        <Content>
            <iframe src="/privacy-policy" class="legal-iframe" title="Privacy Policy"></iframe>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Close" OnClick="ClosePrivacyDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Refund Policy Dialog -->
<SfDialog @ref="_refundDialog" Width="90%" Height="80%" IsModal="true" ShowCloseIcon="true" Visible="false" CssClass="legal-dialog">
    <DialogTemplates>
        <Header>Refund Policy</Header>
        <Content>
            <iframe src="/user-refund-policy" class="legal-iframe" title="Refund Policy"></iframe>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Close" OnClick="CloseRefundDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
