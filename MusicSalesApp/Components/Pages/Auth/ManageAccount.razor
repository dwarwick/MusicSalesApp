@page "/manage-account"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@attribute [Authorize(Policy = Permissions.ValidatedUser)]
@inherits ManageAccountModel

<PageTitle>Manage account</PageTitle>

@*
    One column of work, not a wall of cards. The section ORDER is unchanged, because it was
    already right: the thing people come here for is the subscription, and it sits second.

    The settings-* vocabulary is deliberately not manage-*: Creator Settings is the same kind
    of surface and reuses every piece of it.
*@
<div class="settings-page">
    @if (_loading)
    {
        <div class="settings-loading" role="status">
            <span class="settings-spinner" aria-hidden="true"></span>
            <span>Loading your account&hellip;</span>
        </div>
    }
    else if (!_isAuthenticated)
    {
        <div class="settings-main">
            <div class="settings-alert settings-alert-warn" role="alert">
                <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                <span>You must be logged in to manage your account.</span>
            </div>
        </div>
    }
    else
    {
        @* Needs about 1030px beside a readable column, so it appears from 1200px only. *@
        <nav class="settings-nav" aria-label="Sections on this page">
            <p class="settings-nav-heading">On this page</p>
            @* Fragment-ONLY hrefs do not work here. Blazor intercepts internal anchor
               clicks and resolves the target against <base href="/">, so href="#account"
               navigates to the home page carrying a fragment rather than staying put.
               The route has to be spelled out. *@
            <a href="@SectionLink("account")" class="settings-nav-link">Account</a>
            <a href="@SectionLink("subscription")" class="settings-nav-link">Subscription</a>
            <a href="@SectionLink("email-preferences")" class="settings-nav-link">Email preferences</a>
            <a href="@SectionLink(AppPageRoutes.ManageAccountFollowingSection)" class="settings-nav-link">Following</a>
            <a href="@SectionLink(AppPageRoutes.ManageAccountArtistMessagesSection)" class="settings-nav-link">Artist messages</a>
            <a href="@SectionLink("passkeys")" class="settings-nav-link">Passkeys</a>
            <a href="@SectionLink("password")" class="settings-nav-link">Password</a>
            <a href="@SectionLink("close-account")" class="settings-nav-link settings-nav-link-danger">Close account</a>
        </nav>

        <div class="settings-main">
            <div class="settings-head">
                <p class="settings-head-eyebrow">Your account</p>
                <h1 class="settings-head-title">Manage account</h1>
                <p class="settings-head-note">Signed in as <strong class="settings-head-email">@_userEmail</strong></p>
            </div>

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="settings-alert settings-alert-info" role="status">
                    <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                    <span>@_successMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="settings-alert settings-alert-warn" role="alert">
                    <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                    <span>@_errorMessage</span>
                </div>
            }

            <div class="settings-column">

                <section class="settings-card" id="account">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Account</p>
                            <h2 class="settings-title">Your details</h2>
                        </div>
                    </div>
                    <div class="fact-rows">
                        <div class="fact-row">
                            <span class="fact-label">Email address</span>
                            <span class="fact-value">@_userEmail</span>
                        </div>
                    </div>
                </section>
                <section class="settings-card" id="@AppPageRoutes.ManageAccountSubscriptionSection">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Subscription</p>
                            <h2 class="settings-title">@SubscriptionCardTitle</h2>
                        </div>
                        @if (_hasSubscription)
                        {
                            @* A pill with a dot, not a coloured word: hue alone is not a state
                               indicator, and "Renews Off" printed in a colour was exactly that. *@
                            <span class="status-pill @(IsNonRenewingSubscription ? "status-pill-warn" : "")">
                                <span class="status-pill-dot" aria-hidden="true"></span>@DisplaySubscriptionStatus
                            </span>
                        }
                        else if (HasUnresolvedPayPalAgreement)
                        {
                            <span class="status-pill status-pill-warn">
                                <span class="status-pill-dot" aria-hidden="true"></span>Needs attention
                            </span>
                        }
                    </div>

                    @if (_hasSubscription)
                    {
                        <div class="subscription-details">
                            <div class="fact-rows">
                                <div class="fact-row">
                                    <span class="fact-label">Status</span>
                                    <span class="fact-value">@DisplaySubscriptionStatus</span>
                                </div>
                                <div class="fact-row">
                                    <span class="fact-label">Monthly Price</span>
                                    <span class="fact-value">@CurrentMonthlyPriceDisplay</span>
                                </div>
                                <div class="fact-row">
                                    <span class="fact-label">Billed via</span>
                                    <span class="fact-value">@(_billingSource ?? "PayPal")</span>
                                </div>
                                @if (_startDate.HasValue)
                                {
                                    <div class="fact-row">
                                        <span class="fact-label">Started</span>
                                        <span class="fact-value">@FormatUserDate(_startDate)</span>
                                    </div>
                                }
                                @if (_nextBillingDate.HasValue)
                                {
                                    <div class="fact-row">
                                        <span class="fact-label">Next Billing Date</span>
                                        <span class="fact-value">@FormatUserDate(_nextBillingDate)</span>
                                    </div>
                                }
                                @if (_endDate.HasValue)
                                {
                                    <div class="fact-row">
                                        <span class="fact-label">@SubscriptionEndDateLabel</span>
                                        <span class="fact-value">@FormatUserDateTimeWithTimeZone(_endDate)</span>
                                    </div>
                                }
                            </div>

                            <p class="settings-prose subscription-note">@ActiveSubscriptionMessage</p>
                            <p class="settings-tz">All subscription dates and times shown in @SubscriptionTimeZoneLabel.</p>

                            @if (ShowCancelSubscriptionButton && !_cancelling)
                            {
                                <div class="settings-actions">
                                    <SfButton OnClick="@CancelSubscription" CssClass="e-btn settings-btn settings-btn-danger-outline">@(ShouldUseExternalSubscriptionManagement ? "Manage Subscription" : "Cancel Subscription")</SfButton>
                                </div>
                            }
                            else if (_cancelling)
                            {
                                <p class="settings-working">Processing...</p>
                            }
                        </div>
                    }

                    @if (HasUnresolvedPayPalAgreement)
                    {
                        <div class="subscription-details">
                            <p class="settings-prose">@PayPalMismatchGuidance</p>
                            <p class="settings-prose">Starting another recurring StreamTunes subscription is temporarily blocked to prevent overlapping charges. Creator tips and other one-time payments are not affected.</p>
                            @if (!string.IsNullOrWhiteSpace(_mismatchCorrelationId))
                            {
                                <p class="settings-tz">Support reference: @_mismatchCorrelationId</p>
                            }
                            <div class="settings-actions">
                                <SfButton OnClick="@RefreshSubscription"
                                          Disabled="@(_refreshingSubscription || _cancelling)"
                                          CssClass="e-btn settings-btn settings-btn-violet">
                                    @(_refreshingSubscription ? "Refreshing..." : "Refresh Subscription")
                                </SfButton>
                                @if (CanOpenPayPal)
                                {
                                    <SfButton OnClick="@OpenPayPal" Disabled="@_refreshingSubscription" CssClass="e-btn settings-btn">Open PayPal</SfButton>
                                }
                                <SfButton OnClick="@ContactSupport" Disabled="@_refreshingSubscription" CssClass="e-btn settings-btn">Contact Support</SfButton>
                                <SfButton OnClick="@CancelSubscription"
                                          Disabled="@(_refreshingSubscription || _cancelling)"
                                          CssClass="e-btn settings-btn settings-btn-danger-outline">
                                    @(_cancelling ? "Stopping..." : "Stop PayPal Billing")
                                </SfButton>
                            </div>
                        </div>
                    }

                    @if (CanCreateNewSubscription)
                    {
                        <div class="subscription-description">
                            <p class="settings-prose">@SubscriptionOfferLead</p>

                            <div class="subscription-terms">
                                <p class="settings-subhead">Subscription Terms:</p>
                                <ul class="terms-list">
                                    @if (HasFreeTrialOffer)
                                    {
                                        <li>Your <strong>@TrialDurationDisplay free trial</strong> is followed by recurring billing of <strong>@OfferRegularTermsDisplay</strong>.</li>
                                        <li>If you cancel during the free trial, you will not be charged and your full streaming access will continue through the end of the trial.</li>
                                    }
                                    else
                                    {
                                        <li>A recurring fee of <strong>@OfferRegularTermsDisplay</strong> will continue until you cancel.</li>
                                    }
                                    <li>Recurring charges follow the cadence shown above, subject to your billing provider's policy.</li>
                                    <li>After cancellation, full streaming access continues through the provider-confirmed trial-end or paid-through date.</li>
                                    <li>You can cancel at any time through your StreamTunes account. PayPal billing is stopped immediately, with no future renewal charge.</li>
                                </ul>
                            </div>

                            <div class="terms-agreement">
                                <SfCheckBox @bind-Checked="_agreeToTerms" Label="I agree to the subscription terms and conditions" TChecked="bool" />
                            </div>

                            @if (!_subscribing)
                            {
                                <div class="settings-actions">
                                    <SfButton OnClick="@Subscribe" Disabled="@(!_agreeToTerms)" CssClass="e-btn settings-btn settings-btn-violet">@SubscribeButtonLabel</SfButton>
                                </div>
                            }
                            else
                            {
                                <p class="settings-working">Processing your subscription...</p>
                            }
                        </div>
                    }
                </section>

                <section class="settings-card" id="email-preferences">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Email preferences</p>
                            <h2 class="settings-title">What we send you</h2>
                            <p class="settings-note">Account and billing emails are always sent &mdash; these control the rest.</p>
                        </div>
                    </div>
                    <div class="settings-check">
                        <SfCheckBox @bind-Checked="_receiveNewSongEmails" TChecked="bool" Label="Receive email notifications when new music is added" />
                    </div>
                    @* The two follow-feature switches. There is no in-app equivalent to switch off:
                       the notification IS the record, and muting one artist is done per artist in
                       the Following section rather than site-wide here. *@
                    <div class="settings-check">
                        <SfCheckBox @bind-Checked="_receiveArtistReleaseEmails" TChecked="bool" Label="Email me when artists I follow release new music" />
                    </div>
                    <div class="settings-check">
                        <SfCheckBox @bind-Checked="_receiveArtistMessageEmails" TChecked="bool" Label="Email me when an artist I follow sends me a message" />
                    </div>
                    @* Push settings live here even though the web cannot receive a push: they are
                       account-level and control what the StreamTunes app does on every device
                       signed in to this account.

                       The whole block is hidden until an admin switches push on, label included.
                       Until the phone apps are in the stores nothing can arrive, and a preference
                       that quietly does nothing is worse than no preference at all. *@
                    @if (_pushNotificationsEnabled)
                    {
                        <div class="settings-check">
                            <SfCheckBox @bind-Checked="_receiveArtistReleasePush" TChecked="bool" Label="Send a notification to my phone when artists I follow release new music" />
                        </div>
                        <div class="settings-check">
                            <SfCheckBox @bind-Checked="_receiveArtistMessagePush" TChecked="bool" Label="Send a notification to my phone when an artist I follow sends me a message" />
                        </div>
                        @* A cap on interruptions, not a delay setting: on a window the app sends
                           one summary covering everything that happened in it. Applies to both
                           kinds above, which is why it sits below them rather than beside one. *@
                        <div class="settings-field">
                            <label class="settings-label" for="artist-push-frequency">How often</label>
                            <SfDropDownList TValue="ArtistPushFrequency"
                                            TItem="ArtistPushFrequencyOption"
                                            ID="artist-push-frequency"
                                            DataSource="@ArtistPushFrequencyOptions"
                                            @bind-Value="_artistPushFrequency">
                                <DropDownListFieldSettings Text="Text" Value="Value" />
                            </SfDropDownList>
                        </div>
                        <p class="settings-hint">Phone notifications need the StreamTunes app, and only reach devices you are signed in on. Choosing a window means at most one notification in that time, summarising whatever happened.</p>
                    }
                    @* Never gated on the checkbox. Switching a notification OFF is a save like
                       any other - the terms checkbox on the subscription card gates its button
                       because agreement is a precondition, which is not the case here. *@
                    <div class="settings-actions">
                        <SfButton Content="@(_savingEmailPreferences ? "Saving..." : "Save Preferences")"
                                  Disabled="@_savingEmailPreferences"
                                  OnClick="SaveEmailPreferences"
                                  CssClass="e-btn settings-btn settings-btn-violet" />
                        @if (!string.IsNullOrEmpty(_emailPreferencesStatus))
                        {
                            <span class="settings-inline-status @(_emailPreferencesFailed ? "settings-inline-status-bad" : "")" role="status">@_emailPreferencesStatus</span>
                        }
                    </div>
                </section>

                @* The unread counts in Following are produced by the section below it, so the
                   two are wired together here rather than either reaching for the other. *@
                <FollowedArtistsSection @ref="_followedArtistsSection" UserId="@CurrentUserId" />

                <ArtistMessagesSection UserId="@CurrentUserId"
                                       OnMessagesChanged="RefreshFollowedArtistsAsync" />

                <section class="settings-card" id="passkeys">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Passkeys</p>
                            <h2 class="settings-title">Sign in without a password</h2>
                            @* Passwordless, NOT a second factor. There is no 2FA in this app, and
                               the copy must not imply one. *@
                            <p class="settings-note">Passkeys provide a secure and convenient way to sign in without a password. They replace your password rather than adding a second step.</p>
                        </div>
                    </div>

                    @if (_passkeys.Any())
                    {
                        @* A row each, not an SfGrid. A data grid is right for a hundred rows;
                           most people have one or two, and a grid makes two rows look like a
                           report - and forces a horizontal scroll on a phone. *@
                        <div class="passkey-rows">
                            @foreach (var passkey in _passkeys)
                            {
                                <div class="passkey-row">
                                    <span class="passkey-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="9" r="4" /><path d="M12.5 11.5 20 19v2h-3v-2h-2v-2h-2z" /></svg>
                                    </span>
                                    <span class="passkey-detail">
                                        <span class="passkey-name">@passkey.Name</span>
                                        <span class="passkey-meta">Added @passkey.CreatedAt.ToLocalTime().ToString("g") &middot; last used @passkey.LastUsedAt.ToLocalTime().ToString("g")</span>
                                    </span>
                                    <span class="passkey-actions">
                                        <SfButton Content="Rename" OnClick="() => ShowRenameDialog(passkey)" CssClass="e-btn settings-btn settings-btn-small" />
                                        <SfButton Content="Delete" OnClick="() => ShowDeleteConfirmDialog(passkey)" CssClass="e-btn settings-btn settings-btn-small settings-btn-danger-outline" />
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="settings-empty">
                            <span class="settings-empty-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="9" r="4" /><path d="M12.5 11.5 20 19v2h-3v-2h-2v-2h-2z" /></svg>
                            </span>
                            <p class="settings-empty-title">You don't have any passkeys yet.</p>
                            <p class="settings-empty-body">Add one and you can sign in with your fingerprint, face or device PIN instead of typing a password.</p>
                        </div>
                    }

                    <div class="settings-actions">
                        <SfButton Content="Add Passkey" OnClick="ShowAddPasskeyDialog" CssClass="e-btn settings-btn settings-btn-violet" />
                    </div>
                </section>

                <section class="settings-card" id="password">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Password</p>
                            <h2 class="settings-title">Change your password</h2>
                        </div>
                    </div>

                    <div class="settings-field">
                        <label for="currentPassword" class="settings-label">Current Password</label>
                        <SfTextBox @bind-Value="_currentPassword" ID="currentPassword" Type="InputType.Password" Placeholder="Enter current password" CssClass="e-outline" />
                    </div>

                    <div class="settings-field">
                        <label for="newPassword" class="settings-label">New Password</label>
                        <SfTextBox @bind-Value="_newPassword" ID="newPassword" Type="InputType.Password" Placeholder="Enter new password" CssClass="e-outline" />
                        <p class="settings-hint">Must be at least 8 characters and include upper, lower, digit, and symbol.</p>
                    </div>

                    <div class="settings-field">
                        <label for="confirmPassword" class="settings-label">Confirm New Password</label>
                        <SfTextBox @bind-Value="_confirmPassword" ID="confirmPassword" Type="InputType.Password" Placeholder="Confirm new password" CssClass="e-outline" />
                    </div>

                    <div class="settings-actions">
                        <SfButton Content="Change Password" OnClick="ChangePassword" CssClass="e-btn settings-btn settings-btn-violet" />
                        @if (!string.IsNullOrEmpty(_passwordStatus))
                        {
                            <span class="settings-inline-status @(_passwordFailed ? "settings-inline-status-bad" : "")" role="status">@_passwordStatus</span>
                        }
                    </div>
                </section>

                @* Destructive actions sit in a bordered zone at the end of the page, never
                   inline between two ordinary settings. *@
                <section class="settings-card settings-card-danger" id="close-account">
                    <div class="settings-section-head">
                        <div>
                            <p class="settings-eyebrow">Close account</p>
                            <h2 class="settings-title">Close your StreamTunes account</h2>
                        </div>
                    </div>
                    <p class="settings-prose">Warning: Closing your account will prevent you from logging in.</p>
                    <div class="settings-guard">
                        <svg class="settings-guard-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                        <span>You cannot close an account with an active subscription, and active creators must stop being a creator first.</span>
                    </div>
                    <div class="settings-actions">
                        <SfButton Content="Close My Account" OnClick="ShowAccountClosureDialog" CssClass="e-btn settings-btn settings-btn-danger" />
                    </div>
                </section>

            </div>
        </div>
    }
</div>

<!-- Add Passkey Dialog -->
<SfDialog @ref="_addPasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Add Passkey</Header>
        <Content>
            <div class="mb-3">
                <label for="passkeyName" class="e-label">Passkey Name</label>
                <SfTextBox @bind-Value="_newPasskeyName" ID="passkeyName" Placeholder="e.g., My Laptop, iPhone" CssClass="e-outline" />
                <small class="form-text">Choose a name to help you identify this passkey.</small>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Create" OnClick="AddPasskey" />
            <SfButton Content="Cancel" OnClick="CloseAddPasskeyDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
<!-- Rename Passkey Dialog -->
<SfDialog @ref="_renamePasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Rename Passkey</Header>
        <Content>
            <div class="mb-3">
                <label for="renamePasskeyName" class="e-label">New Name</label>
                <SfTextBox @bind-Value="_renamePasskeyName" ID="renamePasskeyName" Placeholder="Enter new name" CssClass="e-outline" />
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Save" OnClick="RenamePasskey" />
            <SfButton Content="Cancel" OnClick="CloseRenameDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Delete Passkey Confirm Dialog -->
<SfDialog @ref="_deletePasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Delete Passkey</Header>
        <Content>
            <p>Are you sure you want to delete the passkey "@_selectedPasskey?.Name"?</p>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Delete" OnClick="DeletePasskey" />
            <SfButton Content="Cancel" OnClick="CloseDeletePasskeyDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Account Closure Options Dialog -->
<SfDialog @ref="_accountClosureDialog" Width="600px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Close Account</Header>
        <Content>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <SfMessage Severity="MessageSeverity.Error" CssClass="mb-3">@_errorMessage</SfMessage>
            }
            @if (_hasPurchasedMusic)
            {
                <div class="mb-3">
                    <p><strong>You have purchased music on this website.</strong></p>
                    <p>Please choose how you would like to close your account:</p>
                    
                    <div class="alert alert-warning mt-3">
                        <h6>Suspend Account</h6>
                        <p>You will not be able to log in, and you will not receive any communications from us. If you decide to re-enable your account in the future, your account can be restored.</p>
                    </div>
                    
                    <div class="alert alert-danger mt-3">
                        <h6>Delete Account Permanently</h6>
                        <p>All your account data including playlists and subscription records will be permanently deleted. If you create a new account in the future, your deleted playlists and settings will not be restored. <strong>This action cannot be undone!</strong></p>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
                    <p>All your data including playlists and subscriptions will be permanently deleted.</p>
                </div>
            }
        </Content>
        <FooterTemplate>
            @if (_hasPurchasedMusic)
            {
                <SfButton IsPrimary="true" Content="Suspend Account" OnClick="ShowSuspendConfirmDialog" />
                <SfButton CssClass="e-danger" Content="Delete Permanently" OnClick="ShowDeleteConfirmDialog" />
                <SfButton Content="Cancel" OnClick="CloseAccountClosureDialog" />
            }
            else
            {
                <SfButton CssClass="e-danger" Content="Delete Account" OnClick="ShowDeleteConfirmDialog" />
                <SfButton Content="Cancel" OnClick="CloseAccountClosureDialog" />
            }
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Suspend Account Confirm Dialog -->
<SfDialog @ref="_suspendAccountDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Suspend Account</Header>
        <Content>
            <p>Type your email address to confirm account suspension:</p>
            <SfTextBox @bind-Value="_accountActionConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
            <div class="mt-3">
                <small>You can re-enable your account by contacting support.</small>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Suspend My Account" OnClick="SuspendAccount" />
            <SfButton Content="Cancel" OnClick="CloseSuspendAccountDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Delete Account Confirm Dialog -->
<SfDialog @ref="_deleteAccountDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Delete Account</Header>
        <Content>
            <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
            <p>All your account data including playlists and subscription records will be permanently deleted.</p>
            <p>Type your email address to confirm:</p>
            <SfTextBox @bind-Value="_accountActionConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Delete My Account" OnClick="DeleteAccount" />
            <SfButton Content="Cancel" OnClick="CloseDeleteAccountDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
