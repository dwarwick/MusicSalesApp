@page "/login"
@rendermode InteractiveServer
@inherits LoginModel

<PageTitle>Log in</PageTitle>

@*
    Split screen. The panel is a BRAND surface, so it keeps one palette in both site themes -
    the same call the players made - and its base is --st-navy rather than --st-brand-gradient,
    because white on that gradient's #0186fd stop is 3.6:1 and fails AA.

    The submit is cta-secondary/hero-secondary-cta. AGENTS.md picks a tier by AUDIENCE, and
    logging in is an account action. This is not the home hero's documented exception, where
    Log In is cta-quiet because the hero is a listener surface.
*@
<div class="auth-page">
    <aside class="auth-panel">
        @* logo-mark.png, not logo-dark-small.png: that one bakes its background to the dark
           app-bar colour #181c1f, so it reads as a black box anywhere else. *@
        <img src="@Assets.Root("images/logo-mark.png")" alt="StreamTunes" class="auth-panel-logo" />

        <div class="auth-panel-copy">
            <p class="auth-panel-eyebrow">Independent music, streamed</p>
            <h1 class="auth-panel-title">Welcome back.</h1>
            <p class="auth-panel-body">Your library, your playlists and every full song &mdash; right where you left them.</p>
        </div>

        <div class="auth-panel-rule"></div>
    </aside>

    <section class="auth-form-col">
        <div class="auth-form">
            <h2 class="auth-title">Log in</h2>
            <p class="auth-subtitle">Use the email address on your StreamTunes account.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert" role="alert">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <form method="post" action="/account/login">
                @* Renders the __RequestVerificationToken field. Not hand-rolled, because these
                   pages are @rendermode InteractiveServer: OnInitialized runs again over the
                   circuit, where GetAndStoreTokens cannot write a cookie to a response that has
                   already been sent. AntiforgeryStateProvider carries the token across that
                   boundary instead. *@
                <AntiforgeryToken />

                @* The field is named "username" because that is what /account/login binds and
                   what FindByEmailOrUsernameAsync takes. It is labelled Email because a username
                   is always the email here: every path that creates or renames an account sets
                   UserName to it - AuthenticationService:81, WebGoogleAuthController:261,
                   MobileAuthController:314, and both email-change paths. *@
                <div class="auth-field">
                    <label for="username" class="auth-label">Email</label>
                    <SfTextBox @bind-Value="@usernameValue" ID="username" Name="username" Placeholder="you@example.com" CssClass="e-outline" HtmlAttributes="@(new Dictionary<string, object> { { "required", "required" } })" />
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label for="password" class="auth-label">Password</label>
                        <a href="/forgot-password" class="auth-link">Forgot password?</a>
                    </div>
                    <SfTextBox ID="password" Name="password" Type="InputType.Password" Placeholder="Enter your password" CssClass="e-outline" HtmlAttributes="@(new Dictionary<string, object> { { "required", "required" } })" />
                </div>

                @if (showReactivateCheckbox)
                {
                    <div class="auth-reactivate">
                        <SfCheckBox @bind-Checked="@reactivateAccount" Label="Reactivate my suspended account" TChecked="bool" />
                        <input type="hidden" name="reactivateAccount" value="@reactivateAccount.ToString().ToLower()" />
                    </div>
                }

                @* The hidden input matters: an unticked HTML checkbox posts nothing at all, so
                   without it "off" and "field absent" would be indistinguishable. *@
                <div class="auth-check">
                    <SfCheckBox @bind-Checked="@rememberMe" Label="Keep me signed in on this device" TChecked="bool" />
                    <input type="hidden" name="@ExternalAuthFormFields.RememberMe" value="@rememberMe.ToString().ToLowerInvariant()" />
                </div>

                <input type="hidden" name="@ExternalAuthFormFields.ReturnUrl" value="@LoginReturnUrl" />

                <SfButton Type="ButtonType.Submit" Content="Log in" CssClass="e-btn cta-secondary hero-secondary-cta auth-submit" />
            </form>

            <div class="auth-divider"><span>or</span></div>

            <div class="auth-providers">
                <SfButton IsPrimary="false" CssClass="e-btn e-outline google-auth-button auth-provider" OnClick="ContinueWithGoogle">
                    <img src="/images/google_logo.svg" alt="" class="google-auth-icon" />
                    <span>Continue with Google</span>
                </SfButton>
                <SfButton IsPrimary="false" CssClass="e-btn e-outline auth-provider" OnClick="LoginWithPasskey">
                    <svg class="auth-provider-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <circle cx="9" cy="9" r="4" />
                        <path d="M12.5 11.5 20 19v2h-3v-2h-2v-2h-2z" />
                    </svg>
                    <span>Log in with a passkey</span>
                </SfButton>
            </div>

            @* Register links back to Login already; this is the other half of that pair. *@
            <p class="auth-footer">Don&rsquo;t have an account? <a href="@RegisterUrl" class="auth-link auth-link-strong">Register</a></p>

            @if (isDevelopment)
            {
                <p class="auth-dev-hint">Hint: Use email "admin@app.com" or "user@app.com" with password "Password_123"</p>
            }
        </div>
    </section>
</div>
