@page "/song/{SongTitle}"
@inherits SongPlayerModel

<PageTitle>@(!string.IsNullOrEmpty(_artistName) ? $"{_artistName} - {_displayTitle}" : _displayTitle) - StreamTunes</PageTitle>

@* SEO-visible metadata rendered during static SSR *@
<div class="song-seo-content" style="position: absolute; left: -9999px; overflow: hidden;">
    <h1>@_displayTitle</h1>
    @if (!string.IsNullOrEmpty(_artistName))
    {
        <p>Artist: <a href="/artist/@Uri.EscapeDataString(_artistName)">@_artistName</a></p>
    }
    @if (!string.IsNullOrEmpty(_genre))
    {
        <p>Genre: <a href="/genre/@Uri.EscapeDataString(_genre)">@_genre</a></p>
    }
    <p>Listen to @_displayTitle on StreamTunes — unlimited music streaming.</p>
</div>

<SongPlayerInteractive SongTitle="@SongTitle"
                      TipStatus="@TipStatus"
                      TipPayPalToken="@TipPayPalToken" />
