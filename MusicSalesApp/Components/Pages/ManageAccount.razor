@page "/manage-account"
@using MusicSalesApp.Models
@using Syncfusion.Blazor.Notifications
@inherits ManageAccountModel

<PageTitle>Manage Account</PageTitle>

<!-- Toast notification for real-time updates -->
<SfToast @ref="_toastRef" ShowCloseButton="true" NewestOnTop="true" ShowProgressBar="true" Timeout="5000">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="container mt-4">
    <h2>Manage Account</h2>

    @if (_loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!_isAuthenticated)
    {
        <SfMessage Severity="MessageSeverity.Warning">You must be logged in to manage your account.</SfMessage>
    }
    else
    {
        <!-- User Email Section -->
        <div class="user-email-section mb-4">
            <p class="user-email"><strong>Account Email:</strong> @_userEmail</p>
        </div>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <SfMessage Severity="MessageSeverity.Success">@_successMessage</SfMessage>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <SfMessage Severity="MessageSeverity.Error">@_errorMessage</SfMessage>
        }

        <!-- Password Change Section -->
        <SfCard CssClass="mb-4">
            <CardHeader Title="Change Password" />
            <CardContent>
                <div class="mb-3">
                    <label for="currentPassword" class="e-label">Current Password</label>
                    <SfTextBox @bind-Value="_currentPassword" ID="currentPassword" Type="InputType.Password" Placeholder="Enter current password" CssClass="e-outline" />
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="e-label">New Password</label>
                    <SfTextBox @bind-Value="_newPassword" ID="newPassword" Type="InputType.Password" Placeholder="Enter new password" CssClass="e-outline" />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="e-label">Confirm New Password</label>
                    <SfTextBox @bind-Value="_confirmPassword" ID="confirmPassword" Type="InputType.Password" Placeholder="Confirm new password" CssClass="e-outline" />
                </div>

                <SfButton IsPrimary="true" Content="Change Password" OnClick="ChangePassword" />
            </CardContent>
        </SfCard>

        <!-- Email Preferences Section -->
        <SfCard CssClass="mb-4">
            <CardHeader Title="Email Preferences" />
            <CardContent>
                <div class="mb-3">
                    <SfCheckBox @bind-Checked="_receiveNewSongEmails" TChecked="bool" />
                    <span class="ms-2">Receive email notifications when new music is added</span>
                </div>
                <SfButton IsPrimary="true" Content="Save Preferences" OnClick="SaveEmailPreferences" />
            </CardContent>
        </SfCard>

        <!-- Payout Email Section (for creators) -->
        @if (_isCreator)
        {
            <SfCard CssClass="mb-4">
                <CardHeader Title="Payout Email Address" />
                <CardContent>
                    <p class="mb-3">This email will be used to send stream payouts. It may be different from your login email.</p>
                    <div class="mb-3">
                        <label for="paypalEmail" class="e-label">Payout Email Address</label>
                        <SfTextBox @bind-Value="_paypalEmail" ID="paypalEmail" Type="InputType.Email" Placeholder="your-email@example.com" CssClass="e-outline" />
                        <small class="form-text">Enter the email address where you want to receive payments.</small>
                    </div>
                    <SfButton IsPrimary="true" Content="Save Payout Email" OnClick="SavePayPalEmail" />
                </CardContent>
            </SfCard>
        }

        <!-- Passkey Management Section -->
        <SfCard CssClass="mb-4">
            <CardHeader Title="Passkeys" />
            <CardContent>
                <p>Passkeys provide a secure and convenient way to sign in without a password.</p>
                
                @if (_passkeys.Any())
                {
                    <SfGrid DataSource="@_passkeys" AllowPaging="false" CssClass="mt-3">
                        <GridColumns>
                            <GridColumn Field="@nameof(Passkey.Name)" HeaderText="Name" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(Passkey.CreatedAt)" HeaderText="Created" Width="180">
                                <Template>
                                    @{
                                        var passkey = (context as Passkey);
                                        <span>@passkey.CreatedAt.ToLocalTime().ToString("g")</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(Passkey.LastUsedAt)" HeaderText="Last Used" Width="180">
                                <Template>
                                    @{
                                        var passkey = (context as Passkey);
                                        <span>@passkey.LastUsedAt.ToLocalTime().ToString("g")</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Actions" Width="200">
                                <Template>
                                    @{
                                        var passkey = (context as Passkey);
                                        <div>
                                            <SfButton CssClass="e-small" Content="Rename" OnClick="() => ShowRenameDialog(passkey)" />
                                            <SfButton CssClass="e-small e-danger" Content="Delete" OnClick="() => ShowDeleteConfirmDialog(passkey)" />
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
                else
                {
                    <p>You don't have any passkeys yet.</p>
                }

                <SfButton IsPrimary="true" Content="Add Passkey" OnClick="ShowAddPasskeyDialog" CssClass="mt-2" />
            </CardContent>
        </SfCard>

        <!-- Subscription Management Section -->
        <SfCard CssClass="mb-4">
            <CardHeader Title="Manage Your Subscription" />
            <CardContent>
                @if (_hasSubscription)
                {
                    <div class="subscription-details">
                        <p><strong>Status:</strong> @_subscriptionStatus</p>
                        <p><strong>Monthly Price:</strong> $@_monthlyPrice</p>
                        @if (_startDate.HasValue)
                        {
                            <p><strong>Started:</strong> @_startDate.Value.ToLocalTime().ToString("MMMM dd, yyyy")</p>
                        }
                        @if (_nextBillingDate.HasValue)
                        {
                            <p><strong>Next Billing Date:</strong> @_nextBillingDate.Value.ToLocalTime().ToString("MMMM dd, yyyy")</p>
                        }
                        @if (_endDate.HasValue)
                        {
                            <p><strong>Access Until:</strong> @_endDate.Value.ToLocalTime().ToString("MMMM dd, yyyy h:mm tt")</p>
                            <p class="subscription-note">Your subscription has been cancelled. You can continue to enjoy unlimited music streaming until @_endDate.Value.ToLocalTime().ToString("MMMM dd, yyyy h:mm tt").</p>
                        }
                        else
                        {
                            <p class="subscription-note">You have unlimited access to all music on our platform.</p>
                        }
                        
                        @if (!_endDate.HasValue && !_cancelling)
                        {
                            <SfButton OnClick="@CancelSubscription" CssClass="e-danger mt-2">Cancel Subscription</SfButton>
                        }
                        else if (_cancelling)
                        {
                            <p>Processing...</p>
                        }
                    </div>
                }
                else
                {
                    <div class="subscription-description">
                        <h3>Subscribe for just $@_subscriptionPrice per month!</h3>
                        <p>Enjoy unlimited streaming of all music on our platform.</p>
                        
                        <div class="subscription-terms mt-3">
                            <h4>Subscription Terms:</h4>
                            <ul>
                                <li>Monthly fee of <strong>$@_subscriptionPrice</strong> will continue until cancelled by the user.</li>
                                <li>The charge will occur on or about the same day each month, subject to PayPal's policy.</li>
                                <li>Once cancelled, the subscription will be in effect until the end of the paid month.</li>
                                <li>You can cancel at any time from this page.</li>
                            </ul>
                        </div>

                        <div class="terms-agreement mt-3">
                            <SfCheckBox @bind-Checked="_agreeToTerms" Label="I agree to the subscription terms and conditions" TChecked="bool" />
                        </div>
                        
                        @if (!_subscribing)
                        {
                            <SfButton OnClick="@Subscribe" Disabled="@(!_agreeToTerms)" CssClass="e-primary mt-2">Sign Up for Monthly Subscription</SfButton>
                        }
                        else
                        {
                            <p>Processing your subscription...</p>
                        }
                    </div>
                }
            </CardContent>
        </SfCard>

        <!-- Become a Creator Section (only shown if user is not already an active creator) -->
        @if (!_isActiveCreator)
        {
            <SfCard CssClass="mb-4">
                <CardHeader Title="Become a Creator" />
                <CardContent>
                    @if (_creatorOnboardingStatus == "Ineligible")
                    {
                        <div class="creator-ineligible">
                            <p>At this time, Streamtunes does not support paid creator participation for non-U.S. persons who will perform any creator activities while physically present in the United States. You are not eligible to register as a creator at this time.</p>
                        </div>
                    }
                    else if (_creatorOnboardingStatus == "NotStarted" || _creatorOnboardingStatus == null || _creatorOnboardingStatus == "Suspended" || _creatorOnboardingStatus == "ConsentRevoked")
                    {
                        <div class="creator-description">
                            <h4>Share Your Music on StreamTunes!</h4>
                            <p>Join our community of artists and start earning compensation from your music streams.</p>
                            
                            <div class="creator-benefits mt-3">
                                <h5>Benefits of becoming a creator:</h5>
                                <ul>
                                    <li>Upload your original music to our streaming platform</li>
                                    <li>Reach a global audience of music lovers</li>
                                    <li>Earn compensation for every stream of your music</li>
                                    <li>Get paid directly to your PayPal account</li>
                                </ul>
                            </div>

                            <div class="creator-requirements mt-3">
                                <h5>Requirements:</h5>
                                <ul>
                                    <li>A valid PayPal account in good standing to receive stream payments</li>
                                    <li>Complete tax form (W-9/W-8) for tax reporting</li>
                                    <li>Original music that you have the rights to distribute</li>
                                    <li>Agreement to our <a href="/creator-agreement" target="_blank" rel="noopener noreferrer">Creator Agreement</a></li>
                                </ul>
                            </div>

                            <div class="mt-3">
                                <p><strong>How You Earn:</strong> You earn based on the number of qualifying streams (30+ seconds of continuous playback). Your pay rate is set during onboarding and locked in for the lifetime of your creator account. Payments are processed weekly via PayPal. See our <a href="/creator-agreement" target="_blank" rel="noopener noreferrer">Creator Agreement</a> and <a href="/terms-of-use" target="_blank" rel="noopener noreferrer">Terms of Use</a> for complete details.</p>
                            </div>

                            <div class="creator-signup-form mt-4">                               

                                <div class="mb-3">
                                    <label for="creatorDisplayName" class="e-label">Display Name (optional)</label>
                                    <SfTextBox @bind-Value="_creatorDisplayName" ID="creatorDisplayName" Placeholder="Your artist/band name" CssClass="e-outline" />
                                    <small class="form-text">This name will be shown to listeners on your music listings.</small>
                                </div>

                                <div class="mb-3">
                                    <label for="creatorBio" class="e-label">Bio (optional)</label>
                                    <SfTextBox @bind-Value="_creatorBio" ID="creatorBio" Multiline="true" Placeholder="Tell listeners about yourself and your music" CssClass="e-outline" />
                                </div>

                                <div class="mb-3">
                                    <label for="paypalEmailOnboarding" class="e-label">PayPal Email Address <span class="text-danger">*</span></label>
                                    <SfTextBox @bind-Value="_creatorPayPalEmail" ID="paypalEmailOnboarding" Type="InputType.Email" Placeholder="your-paypal-email@example.com" CssClass="e-outline" />
                                    <small class="form-text">This is the email address associated with your PayPal account where you will receive payments.</small>
                                </div>

                                <div class="mb-3">
                                    <SfCheckBox @bind-Checked="_paypalAccountAffirmed" TChecked="bool" />
                                    <span class="ms-2">I affirm that I have a valid PayPal account in good standing that can receive payments. I understand that if my PayPal account is not valid or cannot receive payments, I will not receive payouts. StreamTunes is not responsible for ensuring my PayPal account can receive payments.</span>
                                </div>

                                <div class="alert alert-warning mt-3">
                                    <strong>Important:</strong> You only need a personal PayPal account to receive payments. You do not need a PayPal business account. However, you are responsible for ensuring your PayPal account is in good standing and can receive payments. If there are issues with your PayPal account, your payments may fail and StreamTunes is not responsible for recovering failed payments.
                                </div>

                                <div class="creator-eligibility mt-4">
                                    <h5>Creator Eligibility Requirement</h5>
                                    <p>At this time, Streamtunes supports paid creator participation only if:</p>
                                    <ul>
                                        <li>You are a U.S. person, or</li>
                                        <li>You perform all creator activities for Streamtunes entirely outside the United States.</li>
                                    </ul>
                                    <p>If you perform any creator activities while physically present in the United States and are not a U.S. person, you are not currently eligible to receive payouts through the platform.</p>
                                </div>

                                <div class="creator-location-certification mt-4">
                                    <h5>Creator Location and Tax Certification</h5>
                                    <p>Please select the statement below that reflects your status (required):</p>
                                    <p class="text-muted"><small>For U.S. tax purposes, a &ldquo;U.S. person&rdquo; has the meaning defined by the Internal Revenue Service. Creator activities means uploading, managing, or otherwise monetized participation related to your music on the platform.</small></p>

                                    <div class="mb-2">
                                        <SfRadioButton Label="I am a U.S. person." Name="locationCertification" Value="USPerson" @bind-Checked="_locationCertification" TChecked="string" />
                                    </div>
                                    <div class="mb-2">
                                        <SfRadioButton Label="I am not a U.S. person and will perform all creator activities for Streamtunes entirely outside the United States." Name="locationCertification" Value="NonUSPersonOutsideUS" @bind-Checked="_locationCertification" TChecked="string" />
                                    </div>
                                    <div class="mb-2">
                                        <SfRadioButton Label="I am not a U.S. person and will perform some creator activities for Streamtunes while physically present in the United States." Name="locationCertification" Value="NonUSPersonInsideUS" @bind-Checked="_locationCertification" TChecked="string" />
                                    </div>
                                </div>

                                <div class="creator-acknowledgment mt-4">
                                    <h5>Acknowledgment (required)</h5>
                                    <div class="mb-3">
                                        <SfCheckBox @bind-Checked="_acknowledgmentAccepted" TChecked="bool" />
                                        <span class="ms-2">I certify that the information above is accurate and understand that Streamtunes relies on this certification to determine my eligibility for payouts and applicable tax withholding and reporting. I agree to promptly update this information if my circumstances change.</span>
                                    </div>
                                </div>

                                @if (!_startingOnboarding)
                                {
                                    <SfButton IsPrimary="true" Content="Start Creator Signup" OnClick="StartCreatorOnboarding" Disabled="@(!CanStartOnboarding)" />
                                    @if (!CanStartOnboarding)
                                    {
                                        <p class="text-danger mt-2">Please complete all required fields including your PayPal email, PayPal account confirmation, location certification, and acknowledgment.</p>
                                    }
                                }
                                else
                                {
                                    <p>Processing your signup...</p>
                                }
                            </div>
                        </div>
                    }
                    else if (_creatorOnboardingStatus == "Pending" || _creatorOnboardingStatus == "InProgress" || _creatorOnboardingStatus == "Completed")
                    {
                        <div class="creator-pending">
                            <h4>Complete Your Creator Onboarding</h4>
                            
                            <!-- PayPal Email Status -->
                            <div class="onboarding-section mb-4">
                                <h5>1. PayPal Account</h5>
                                <p class="text-success"><strong>Status: Confirmed ✓</strong></p>
                                <p>You have confirmed that you have a valid PayPal account to receive payments.</p>
                            </div>
                            
                            <!-- Tax Form Status -->
                            <div class="onboarding-section mb-4">
                                <h5>2. Tax Form (W-9/W-8)</h5>
                                @if (_creatorTaxFormStatus == "Completed")
                                {
                                    <p class="text-success"><strong>Status: Completed ✓</strong></p>
                                    <p>Both steps are complete. Your creator account will be activated shortly.</p>
                                    @if (!_completingOnboarding)
                                    {
                                        <SfButton IsPrimary="true" Content="Activate My Creator Account" OnClick="CompleteCreatorOnboarding" />
                                    }
                                    else
                                    {
                                        <p>Activating your account...</p>
                                    }
                                }
                                else if (_creatorTaxFormStatus == "Pending")
                                {
                                    <p class="text-warning"><strong>Status: Pending</strong></p>
                                    <p>Please complete your tax form to activate your creator account.</p>
                                    <p>Check your email for a link from <strong>support.streamtunes@apptaxbandits.com</strong>.</p>
                                    <p>If you didn't receive the email or need a new one:</p>
                                    @if (!_resendingTaxForm)
                                    {
                                        <SfButton Content="Resend Tax Form Email" OnClick="ResendTaxForm" />
                                    }
                                    else
                                    {
                                        <p>Sending new email...</p>
                                    }
                                }
                                else if (_creatorTaxFormStatus == "TinMatchInProgress")
                                {
                                    <p class="text-info"><strong>Status: TIN Match in Progress</strong></p>
                                    <p>Your tax form has been completed successfully!</p>
                                    <p>TIN verification with the IRS is currently in progress. This process may take up to 1 hour.</p>
                                    <p>This status will update automatically when the verification is complete. You will receive an email notification.</p>
                                }
                                else if (_creatorTaxFormStatus == "Failed")
                                {
                                    <p class="text-danger"><strong>Status: Failed</strong></p>
                                    <p>There was an issue with your tax form submission. Please request a new form:</p>
                                    @if (!_resendingTaxForm)
                                    {
                                        <SfButton Content="Request New Tax Form" OnClick="ResendTaxForm" />
                                    }
                                    else
                                    {
                                        <p>Sending new email...</p>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted"><strong>Status: Not Started</strong></p>
                                    <p>Your tax form request will be sent automatically as part of the onboarding process.</p>
                                }
                            </div>
                        </div>
                    }
                    else if (_creatorOnboardingStatus == "Failed")
                    {
                        <div class="creator-failed">
                            <h4>Onboarding Failed</h4>
                            <p class="text-danger">Unfortunately, your creator onboarding could not be completed.</p>
                            <p>Please contact support for assistance or try again:</p>
                            
                            @if (!_startingOnboarding)
                            {
                                <SfButton IsPrimary="true" Content="Try Again" OnClick="StartCreatorOnboarding" />
                            }
                            else
                            {
                                <p>Preparing your signup...</p>
                            }
                        </div>
                    }
                </CardContent>
            </SfCard>
        }
        else
        {
            <!-- Creator Profile Section (shown for active creators) -->
            <SfCard CssClass="mb-4">
                <CardHeader Title="Creator Profile" />
                <CardContent>
                    <div class="creator-active-info">
                        <p class="text-success"><strong>✓ You are an active creator!</strong></p>
                        <p>You can upload music to StreamTunes and earn compensation from streams.</p>
                        
                        <div class="mt-3">
                            <div class="mb-3">
                                <label for="editCreatorDisplayName" class="e-label">Display Name (max 20 characters)</label>
                                <SfTextBox @bind-Value="_editCreatorDisplayName" ID="editCreatorDisplayName" Placeholder="Your artist/band name" CssClass="e-outline" MaxLength="20" />
                                <small class="text-muted">This name will be shown on your song cards.</small>
                            </div>
                            <div class="mb-3">
                                <label for="editCreatorBio" class="e-label">Bio (optional)</label>
                                <SfTextBox @bind-Value="_editCreatorBio" ID="editCreatorBio" Placeholder="Tell your listeners about yourself..." CssClass="e-outline" Multiline="true" MaxLength="1000" />
                            </div>
                            <SfButton IsPrimary="true" Content="Save Profile" OnClick="SaveCreatorProfile" Disabled="@_savingCreatorProfile" />
                            @if (!string.IsNullOrEmpty(_creatorProfileMessage))
                            {
                                <span class="@(_creatorProfileSuccess ? "text-success" : "text-danger") ms-2">@_creatorProfileMessage</span>
                            }
                        </div>

                        <div class="mt-3">
                            <SfButton IsPrimary="true" Content="Upload Music" OnClick="NavigateToUpload" />
                            <SfButton Content="Manage My Songs" OnClick="NavigateToManageSongs" CssClass="ms-2" />
                        </div>

                        <hr class="my-4" />

                        <div class="stop-selling-section">
                            <h5 class="text-danger">Stop Being a Creator</h5>
                            <p>
                                If you no longer want to share your music on StreamTunes, you can stop being a creator. 
                                <strong>Warning:</strong> This action will:
                            </p>
                            <ul>
                                <li>Remove all your uploaded music from the platform</li>
                                <li>Delete all your song files from storage</li>
                                <li>Your music will no longer be available for streaming</li>
                                <li>You will need to go through the creator onboarding process again if you want to share music in the future</li>
                            </ul>
                            <p>
                            See our <a href="/terms-of-use" target="_blank">Terms of Use</a> for more details.
                            </p>
                            
                            @if (!_stoppingCreatorStatus)
                            {
                                <SfButton CssClass="e-danger" Content="Stop Being a Creator" OnClick="ShowStopSellingConfirmation" />
                            }
                            else
                            {
                                <p>Processing...</p>
                            }
                        </div>
                    </div>
                </CardContent>
            </SfCard>
        }

        <!-- Account Closure Section -->
        <SfCard CssClass="mb-4">
            <CardHeader Title="Close Account" />
            <CardContent>
                <p class="text-danger">Warning: Closing your account will prevent you from logging in.</p>
                <SfButton CssClass="e-danger" Content="Close My Account" OnClick="ShowAccountClosureDialog" />
            </CardContent>
        </SfCard>
    }
</div>

<!-- Add Passkey Dialog -->
<SfDialog @ref="_addPasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Add Passkey</Header>
        <Content>
            <div class="mb-3">
                <label for="passkeyName" class="e-label">Passkey Name</label>
                <SfTextBox @bind-Value="_newPasskeyName" ID="passkeyName" Placeholder="e.g., My Laptop, iPhone" CssClass="e-outline" />
                <small class="form-text">Choose a name to help you identify this passkey.</small>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Create" OnClick="AddPasskey" />
            <SfButton Content="Cancel" OnClick="CloseAddPasskeyDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Rename Passkey Dialog -->
<SfDialog @ref="_renamePasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Rename Passkey</Header>
        <Content>
            <div class="mb-3">
                <label for="renamePasskeyName" class="e-label">New Name</label>
                <SfTextBox @bind-Value="_renamePasskeyName" ID="renamePasskeyName" Placeholder="Enter new name" CssClass="e-outline" />
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Save" OnClick="RenamePasskey" />
            <SfButton Content="Cancel" OnClick="CloseRenameDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Delete Passkey Confirm Dialog -->
<SfDialog @ref="_deletePasskeyDialog" Width="400px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Delete Passkey</Header>
        <Content>
            <p>Are you sure you want to delete the passkey "@_selectedPasskey?.Name"?</p>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Delete" OnClick="DeletePasskey" />
            <SfButton Content="Cancel" OnClick="CloseDeletePasskeyDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Account Closure Options Dialog -->
<SfDialog @ref="_accountClosureDialog" Width="600px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Close Account</Header>
        <Content>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <SfMessage Severity="MessageSeverity.Error" CssClass="mb-3">@_errorMessage</SfMessage>
            }
            @if (_hasPurchasedMusic)
            {
                <div class="mb-3">
                    <p><strong>You have purchased music on this website.</strong></p>
                    <p>Please choose how you would like to close your account:</p>
                    
                    <div class="alert alert-warning mt-3">
                        <h6>Suspend Account</h6>
                        <p>You will not be able to log in, and you will not receive any communications from us. If you decide to re-enable your account in the future, you will still have access to your owned songs.</p>
                    </div>
                    
                    <div class="alert alert-danger mt-3">
                        <h6>Delete Account Permanently</h6>
                        <p>All your data including purchases, playlists, and subscriptions will be permanently deleted. You will no longer have access to your music if you create a new account in the future. <strong>This action cannot be undone!</strong></p>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
                    <p>All your data including playlists and subscriptions will be permanently deleted.</p>
                </div>
            }
        </Content>
        <FooterTemplate>
            @if (_hasPurchasedMusic)
            {
                <SfButton IsPrimary="true" Content="Suspend Account" OnClick="ShowSuspendConfirmDialog" />
                <SfButton CssClass="e-danger" Content="Delete Permanently" OnClick="ShowDeleteConfirmDialog" />
                <SfButton Content="Cancel" OnClick="CloseAccountClosureDialog" />
            }
            else
            {
                <SfButton CssClass="e-danger" Content="Delete Account" OnClick="ShowDeleteConfirmDialog" />
                <SfButton Content="Cancel" OnClick="CloseAccountClosureDialog" />
            }
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Suspend Account Confirm Dialog -->
<SfDialog @ref="_suspendAccountDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Suspend Account</Header>
        <Content>
            <p>Type your email address to confirm account suspension:</p>
            <SfTextBox @bind-Value="_accountActionConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
            <div class="mt-3">
                <small>You can re-enable your account by contacting support.</small>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton IsPrimary="true" Content="Suspend My Account" OnClick="SuspendAccount" />
            <SfButton Content="Cancel" OnClick="CloseSuspendAccountDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Delete Account Confirm Dialog -->
<SfDialog @ref="_deleteAccountDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false">
    <DialogTemplates>
        <Header>Delete Account</Header>
        <Content>
            <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
            <p>All your data including purchases, playlists, and subscriptions will be permanently deleted.</p>
            <p>Type your email address to confirm:</p>
            <SfTextBox @bind-Value="_accountActionConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Delete My Account" OnClick="DeleteAccount" />
            <SfButton Content="Cancel" OnClick="CloseDeleteAccountDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Stop Selling Confirmation Dialog -->
<SfDialog @ref="_stopSellingDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false" Header="Stop Being a Creator">
    <DialogTemplates>
        <Content>
            <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
            <p>By stopping your creator account:</p>
            <ul>
                <li>All your uploaded music will be permanently removed from the platform</li>
                <li>All your song files will be deleted from storage</li>
                <li>Your music will no longer be available for purchase or streaming</li>
                <li><strong>Users who previously purchased your music will no longer be able to access it</strong></li>
            </ul>
            <p>To confirm, please type your email address below:</p>
            <SfTextBox @bind-Value="_stopSellingConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Stop Being a Creator" OnClick="ConfirmStopSelling" Disabled="@(_stopSellingConfirmEmail != _userEmail)" />
            <SfButton Content="Cancel" OnClick="CloseStopSellingDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
