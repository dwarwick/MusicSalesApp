@page "/admin/logs"
@rendermode InteractiveServer
@inherits AdminLogsModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@attribute [Authorize(Policy = Permissions.ManageUsers)]

<PageTitle>Application Logs</PageTitle>

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="bi bi-file-text me-2"></i>Application Logs</h3>
            <p class="text-muted mb-0">View application log files</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <SfMessage Severity="MessageSeverity.Error">@_errorMessage</SfMessage>
    }

    @if (!_isLoading && _logFiles.Count == 0)
    {
        <SfMessage Severity="MessageSeverity.Info">No log files found.</SfMessage>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Log File</label>
                <SfDropDownList TValue="string" TItem="string"
                                Value="@_selectedLogFile"
                                DataSource="@_logFiles"
                                Placeholder="-- Select a log file --"
                                ValueChanged="@OnFileSelectionChanged">
                </SfDropDownList>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading log file...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(_selectedLogFile))
        {
            <div class="log-viewer">
                <pre class="log-content">@_logContent</pre>
            </div>
        }
    }
</div>
