@inherits HomeSubscriptionOfferModel

<section class="hero-section">
    <div class="hero-content">
        <p class="section-eyebrow">Independent music, streamed</p>
        @* Two elements, one sentence. The <h2> keeps the heading structure and the string both
           HomeTests and search engines expect, but it carried NO css rule anywhere, so it fell to
           the browser default (~24px) beside a 4rem <h1>. .hero-title-line-2 sizes it to match. *@
        <h1 class="hero-title">
            <span class="hero-highlight">Discover your</span>
        </h1>
        <h2 class="hero-title hero-title-line-2">next favorite artist!</h2>
        <p class="hero-subtitle">
            @if (_audienceLoaded && ShouldShowSubscriptionOffer && HasFreeTrialOffer)
            {
                <text>
                    Support independent music and stream the full catalog free for @TrialDurationDisplay,
                    then @OfferRegularTermsDisplay through PayPal. Cancel anytime.
                </text>
            }
            else if (_audienceLoaded && ShouldShowSubscriptionOffer && _offerQuote != null)
            {
                <text>
                    Support independent music and stream the full catalog for @OfferRegularTermsDisplay
                    through PayPal. Cancel anytime.
                </text>
            }
            else
            {
                <text>Stream all songs, discover independent artists, and create the perfect playlist for every moment.</text>
            }
        </p>
        <div class="hero-cta">
            @* Browse Music is the primary LISTENER action on this page, so it must not wear
               cta-secondary/hero-secondary-cta - AGENTS.md reserves that violet for creator and
               account actions. It is the outline beside the accent-filled register/subscribe CTA. *@
            <a href="@AppPageRoutes.MusicLibrary" class="e-control e-btn cta-outline hero-browse-music-button">
                Browse Music
            </a>
            @if (_audienceLoaded && ShouldShowSubscriptionOffer && !_isAuthenticated)
            {
                @* Quiet tertiary. Nominally an account action, but three button colours in one
                   row is noise and the hero is a listener surface - see AGENTS.md. *@
                <a href="@SubscriberLoginUrl"
                   class="e-control e-btn cta-quiet hero-login-button"
                   data-analytics-event="@FunnelAnalyticsEvents.SubscriberLoginClicked"
                   data-analytics-category="subscriber"
                   data-analytics-label="home_hero_login">
                    Log In
                </a>
                <a href="@SubscriberRegisterUrl"
                   class="e-control e-btn cta-primary"
                   data-analytics-event="@FunnelAnalyticsEvents.SubscriberRegisterClicked"
                   data-analytics-category="subscriber"
                   data-analytics-label="home_hero_register">
                    @SubscriberRegisterLabel
                </a>
            }
            else if (_audienceLoaded && ShouldShowSubscriptionOffer && _isEmailVerified)
            {
                <a href="@AppPageRoutes.ManageAccount"
                   class="e-control e-btn cta-primary"
                   data-analytics-event="@FunnelAnalyticsEvents.SubscriberSubscribeClicked"
                   data-analytics-category="subscriber"
                   data-analytics-label="home_hero_subscribe">
                    @HeroSubscribeLabel
                </a>
            }
            else if (_audienceLoaded && ShouldShowSubscriptionOffer)
            {
                <a href="@AppPageRoutes.ValidateEmail" class="e-control e-btn cta-primary">
                    Validate Your Email for Full Functionality
                </a>
            }
        </div>
    </div>
    <div class="hero-visual">
        <dotlottie-wc src="https://lottie.host/07d61f77-2c9f-49a7-9884-4030d670f9ed/hSfkTa6ydt.lottie" class="hero-animation" autoplay loop></dotlottie-wc>
    </div>
</section>

@if (ShouldShowSubscriptionOffer)
{
    @* .cta-split-* was a flex ROW built for two cards; only the subscriber one has existed since
       the creator card was removed. Both class names stay - HomeTests asserts exactly one
       .cta-card inside a .cta-split-section - but the container now centres a single panel. *@
    <section class="cta-split-section">
        <div class="cta-split-container cta-split-single">
            <div class="cta-card subscriber-cta"
                 data-analytics-page-event="@FunnelAnalyticsEvents.SubscriberCtaViewed"
                 data-analytics-category="subscriber"
                 data-analytics-label="home_subscriber_cta">
                <div class="cta-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
                <h2 class="cta-title">
                    @(HasFreeTrialOffer ? $"Try Unlimited Music Free for {TrialDurationDisplay}" : "Unlimited Music Streaming")
                </h2>
                <p class="cta-description">
                    Support independent music while streaming every full song in our catalog with no limits.
                </p>
                <ul class="cta-benefits">
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Full-length streaming of all songs
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Create unlimited playlists
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Personalized recommendations
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        No ads, no interruptions
                    </li>
                </ul>
                <p class="cta-price-highlight">
                    @if (HasFreeTrialOffer)
                    {
                        <span class="price">@TrialDurationDisplay free</span><br />
                        <text>Then @OfferRegularTermsDisplay through PayPal. Cancel anytime.</text>
                    }
                    else if (_offerQuote != null)
                    {
                        <text>Just <span class="price">@OfferPriceDisplay</span> @OfferCadenceDisplay through PayPal.<br />Cancel anytime.</text>
                    }
                </p>
                @if (!_isAuthenticated)
                {
                    <p class="cta-auth-text">
                        @(HasFreeTrialOffer ? "Log In or Register to Start Your Free Trial" : "Log In or Register to Get Started")
                    </p>
                    <div class="cta-button-group">
                        <a href="@SubscriberLoginUrl"
                           class="e-control e-btn cta-button cta-button-login"
                           data-analytics-event="@FunnelAnalyticsEvents.SubscriberLoginClicked"
                           data-analytics-category="subscriber"
                           data-analytics-label="home_subscriber_login">
                            Log In
                        </a>
                        <a href="@SubscriberRegisterUrl"
                           class="e-control e-btn cta-button cta-button-register"
                           data-analytics-event="@FunnelAnalyticsEvents.SubscriberRegisterClicked"
                           data-analytics-category="subscriber"
                           data-analytics-label="home_subscriber_register">
                            @SubscriberRegisterLabel
                        </a>
                    </div>
                }
                else if (_isEmailVerified)
                {
                    <a href="@AppPageRoutes.ManageAccount"
                       class="e-control e-btn cta-button"
                       data-analytics-event="@FunnelAnalyticsEvents.SubscriberSubscribeClicked"
                       data-analytics-category="subscriber"
                       data-analytics-label="home_subscriber_manage_account">
                        @SubscriberSubscribeLabel
                    </a>
                }
                else
                {
                    <a href="@AppPageRoutes.ValidateEmail" class="e-control e-btn cta-button">
                        Validate Your Email for Full Functionality
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="features-section">
        <div class="section-head section-head-centred">
            <div>
                <p class="section-eyebrow">What you get</p>
                <h2 class="section-title">Why Stream Tunes?</h2>
            </div>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
                <h3>Unlimited Streaming</h3>
                <p>Access our entire catalog of songs with no limits. Play any track, any time, as many times as you want.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </div>
                <h3>Personal Playlists</h3>
                <p>Create custom playlists, like your favorite songs, and get personalized recommendations based on your taste.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                        <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                    </svg>
                </div>
                <h3>Cancel Anytime</h3>
                <p>No contracts, no commitments. Subscribe month-to-month and cancel whenever you want.</p>
            </div>
        </div>
    </section>
}
