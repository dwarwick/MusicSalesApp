@page "/"
@using MusicSalesApp.Components.Pages
@inherits HomeModel

<PageTitle>Stream Tunes - Unlimited Music Streaming</PageTitle>

<div class="home-container">
    @* Featured Music Section *@
    @* PublicFeaturedMusicTests reads this file as TEXT and asserts the literal
       <section class="featured-music-section"> appears before <HomeSubscriptionOffer.
       Keep that element on one line, with no extra classes or attributes. *@
    <section class="featured-music-section">
        <div class="featured-music-header section-head">
            <div>
                <div class="section-eyebrow">Free to stream</div>
                <h2 class="section-title">Free Featured Music</h2>
            </div>
            <a href="@AppPageRoutes.MusicLibrary" class="music-library-link section-link">
                @* HomeTests pins the literal "View All" - keep the capitalisation. The old
                   trailing "&gt;" is now the chevron beside it. *@
                View All Music
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z" /></svg>
            </a>
        </div>
        <p class="section-subtitle">Listen to today's featured songs in full. Explore the full library and discover independent artists.</p>
        <MusicLibrary ShowHomePageFeatured="true" EmbeddedPageTitle="Stream Tunes - Unlimited Music Streaming" />
    </section>

    <HomeSubscriptionOffer @rendermode="InteractiveServer" />

    @* An island of its own: this section loads in OnAfterRenderAsync, which the statically
       rendered Home never calls. See HomeUserPlaylists.razor for the full note. *@
    <HomeUserPlaylists />
</div>
