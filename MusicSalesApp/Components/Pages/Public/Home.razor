@page "/"
@using MusicSalesApp.Components.Pages
@inherits HomeModel

<PageTitle>Stream Tunes - Unlimited Music Streaming</PageTitle>

<div class="home-container">
    @* Hero Section *@
    <section class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                Your Music.<br />
                <span class="hero-highlight">Unlimited.</span>
            </h1>
            <p class="hero-subtitle">
                Stream all songs, discover new artists, and create the perfect playlist for every moment. 
                All for less than $5 per month.
            </p>
            @if (!_isAuthenticated)
            {
                <div class="hero-cta">                    
                    <a href="/login" class="e-control e-btn cta-secondary">
                        Log In
                    </a>
                    <a href="/register" class="e-control e-btn cta-primary">
                        Register
                    </a>
                </div>
            }
            else if (!_hasActiveSubscription)
            {
                <div class="hero-cta">
                    @if (_isEmailVerified)
                    {
                        <a href="/manage-account" class="e-control e-btn cta-primary">
                            Subscribe Now - $@_subscriptionPrice/mo
                        </a>
                    }
                    else
                    {
                        <a href="/validate-email" class="e-control e-btn cta-primary">
                            Validate Your Email for Full Functionality
                        </a>
                    }
                </div>
            }
        </div>
        <div class="hero-visual">
            <dotlottie-wc src="https://lottie.host/07d61f77-2c9f-49a7-9884-4030d670f9ed/hSfkTa6ydt.lottie" class="hero-animation" autoplay loop></dotlottie-wc>
        </div>
    </section>

    @* CTA Split Section - Creators and Subscribers (under hero, before features) *@
    @if (!_hasActiveSubscription || !_isActiveCreator)
    {
        <section class="cta-split-section">
            <div class="cta-split-container">
                @* Creator CTA - Left side (or top on mobile) - Only show if not an active creator *@
                @if (!_isActiveCreator)
                {
                    <div class="cta-card creator-cta">
                        <div class="cta-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                                <path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z"/>
                            </svg>
                        </div>
                        <h2 class="cta-title">Monetize Your Music — Human or AI</h2>
                        <p class="cta-description">Upload original tracks — human-made or AI-generated — and earn per stream.</p>
                        <h4 class="cta-subheading"><strong>Why creators choose Streamtunes:</strong></h4>
                        <ul class="cta-benefits">
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Get your songs heard worldwide
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Earn per stream — straight to you
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Keep 100% control of your music rights
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Quick upload process — start earning fast
                            </li>
                        </ul>
                        <p class="cta-free-notice">
                            No cost to join — full platform access included.
                        </p>
                        <div class="cta-learn-row">
                            <span class="cta-learn-link">Learn how it works →</span>
                            <a href="/LearnMore" class="e-control e-btn cta-button cta-button-learn">
                                Learn More
                            </a>
                        </div>
                        @if (!_isAuthenticated)
                        {
                            <div class="cta-button-group">
                                <a href="/login?returnUrl=/manage-account" class="e-control e-btn cta-button cta-button-login">
                                    Log In
                                </a>
                                <a href="/register" class="e-control e-btn cta-button cta-button-register">
                                    Register
                                </a>
                            </div>
                        }
                        else if (_isEmailVerified)
                        {
                            <a href="/manage-account" class="e-control e-btn cta-button">
                                Click Here to Get Started
                            </a>
                        }
                        else
                        {
                            <a href="/validate-email" class="e-control e-btn cta-button">
                                Validate Your Email for Full Functionality
                            </a>
                        }
                    </div>
                }

                @* Subscriber CTA - Right side (or bottom on mobile) - Only show if not a subscriber *@
                @if (!_hasActiveSubscription)
                {
                    <div class="cta-card subscriber-cta">
                        <div class="cta-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                            </svg>
                        </div>
                        <h2 class="cta-title">Unlimited Music Streaming</h2>
                        <p class="cta-description">
                            Stream all songs with no limits. Access our entire catalog for less than $5 per month.
                        </p>
                        <ul class="cta-benefits">
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Full-length streaming of all songs
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Create unlimited playlists
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                Personalized recommendations
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </svg>
                                No ads, no interruptions
                            </li>
                        </ul>
                        <p class="cta-price-highlight">
                            Just <span class="price">$@_subscriptionPrice</span> per month
                        </p>
                        @if (!_isAuthenticated)
                        {
                            <p class="cta-auth-text">Log In or Register to Get Started</p>
                            <div class="cta-button-group">
                                <a href="/login?returnUrl=/manage-account" class="e-control e-btn cta-button cta-button-login">
                                    Log In
                                </a>
                                <a href="/register" class="e-control e-btn cta-button cta-button-register">
                                    Register
                                </a>
                            </div>
                        }
                        else if (_isEmailVerified)
                        {
                            <a href="/manage-account" class="e-control e-btn cta-button">
                                Click Here to Get Started
                            </a>
                        }
                        else
                        {
                            <a href="/validate-email" class="e-control e-btn cta-button">
                                Validate Your Email for Full Functionality
                            </a>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @* Value Proposition Section - Only show to non-subscribers *@
    @if (!_hasActiveSubscription)
    {
        <section class="features-section">
            <h2 class="section-title">Why Stream Tunes?</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                        </svg>
                    </div>
                    <h3>Unlimited Streaming</h3>
                    <p>Access our entire catalog of songs with no limits. Play any track, any time, as many times as you want.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </div>
                    <h3>Personal Playlists</h3>
                    <p>Create custom playlists, like your favorite songs, and get personalized recommendations based on your taste.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                            <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                        </svg>
                    </div>
                    <h3>Cancel Anytime</h3>
                    <p>No contracts, no commitments. Subscribe month-to-month and cancel whenever you want.</p>
                </div>
            </div>
        </section>
    }

    @* User's Playlists Section - Only show when authenticated *@
    @if (HasUserPlaylists)
    {
        <section class="user-playlists-section">
            <h2 class="section-title">Your Playlists</h2>
            <div class="playlists-page-grid">
                @if (_recommendedPlaylist.Any())
                {
                    <a href="/recommended-playlist/@_currentUserId" class="e-card playlists-page-card music-card recommended-playlist-card playlist-card-link">
                        <div class="e-card-header">
                            <div class="e-card-header-title">Recommended For You</div>
                        </div>
                        <div class="e-card-content">
                            <p>@_recommendedPlaylist.Count song(s)</p>
                            <p class="playlist-description">Songs you might enjoy based on your preferences</p>
                        </div>
                    </a>
                }
                @if (HasLikedSongsToShow)
                {
                    <a href="/playlist/@_likedSongsPlaylist.Id" class="e-card playlists-page-card music-card liked-songs-playlist-card playlist-card-link">
                        <div class="e-card-header">
                            <div class="e-card-header-title">Liked Songs</div>
                        </div>
                        <div class="e-card-content">
                            <p>@_likedSongsCount song(s)</p>
                            <p class="playlist-description">Songs you've liked</p>
                        </div>
                    </a>
                }
            </div>
        </section>
    }
    else if (_isAuthenticated && _loadingRecommendations)
    {
        <section class="user-playlists-section">
            <h2 class="section-title">Your Playlists</h2>
            <p class="loading-text">Loading your personalized content...</p>
        </section>
    }

    @* Featured Music Section *@
    <section class="featured-music-section">
        <div class="featured-music-header">
            <h2 class="section-title">Featured Music</h2>
            <a href="/music-library" class="music-library-link">
                View All
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                    <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                </svg>
            </a>
        </div>
        <p class="section-subtitle">Listen to samples from our collection. Subscribe for unlimited access!</p>
        <MusicLibrary ShowHomePageFeatured="true" />
    </section>
</div>
