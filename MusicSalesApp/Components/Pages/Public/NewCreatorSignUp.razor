@page "/new-creator-signup"
@inherits NewCreatorSignUpModel

<PageTitle>New Creator Signup - Streamtunes</PageTitle>

<div class="container my-5"
     data-analytics-page-event="@FunnelAnalyticsEvents.CreatorLandingViewed"
     data-analytics-category="@FunnelAnalyticsLabels.CreatorCategory"
     data-analytics-label="@FunnelAnalyticsLabels.NewCreatorSignup">
    @* Featured Music Section *@
    <section class="featured-music-section">
        <div class="featured-music-header">
            <h2 class="section-title">Free Featured Music</h2>
            <a href="@AppPageRoutes.MusicLibrary" class="music-library-link">View All Music&gt;</a>
        </div>
        <p class="section-subtitle">Listen to today's featured songs in full. Subscribe for unlimited access to the full library!</p>
        <MusicLibrary ShowHomePageFeatured="true" EmbeddedPageTitle="New Creator Signup - Streamtunes" />
    </section>

    <h1 class="mb-4">Turn Your Creativity Into Streaming Revenue</h1>

    <div class="terms-content learn-more-content">
        <p>Streamtunes is built for modern independent creators. Original music is welcome, including AI-assisted or AI-generated music when you control the rights. If you create original music and control the rights to it, you can publish it here and earn from it.</p>

        @if (!_isAuthenticated)
        {
            <div class="cta-button-group" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
                <a href="@CreatorRegisterUrl"
                   class="e-control e-btn cta-button cta-secondary hero-secondary-cta cta-button-register"
                   data-analytics-event="@FunnelAnalyticsEvents.CreatorRegisterClicked"
                   data-analytics-category="@FunnelAnalyticsLabels.CreatorCategory"
                   data-analytics-label="@FunnelAnalyticsLabels.NewCreatorSignupTopRegister">
                    Start Creator Signup
                </a>
                <p style="margin-top: 1rem;">Already registered?</p>
                <a href="@CreatorLoginUrl"
                   class="e-control e-btn cta-button cta-secondary hero-secondary-cta cta-button-login"
                   data-analytics-event="@FunnelAnalyticsEvents.CreatorRegisterClicked"
                   data-analytics-category="@FunnelAnalyticsLabels.CreatorCategory"
                   data-analytics-label="@FunnelAnalyticsLabels.NewCreatorSignupTopLogin">
                    Log In
                </a>
            </div>
        }
        else if (!_isActiveCreator)
        {
            <div class="cta-button-group" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
                @if (_isEmailVerified)
                {
                    <a href="@AppPageRoutes.CreatorSettings"
                       class="e-control e-btn cta-button cta-secondary hero-secondary-cta cta-button-register"
                       data-analytics-event="@FunnelAnalyticsEvents.CreatorRegisterClicked"
                       data-analytics-category="@FunnelAnalyticsLabels.CreatorCategory"
                       data-analytics-label="@FunnelAnalyticsLabels.NewCreatorSignupTopCreatorSettings">
                        Get Started
                    </a>
                }
                else
                {
                    <a href="@AppPageRoutes.ValidateEmail" class="e-control e-btn cta-button cta-secondary hero-secondary-cta cta-button-register">
                        Validate Your Email for Full Functionality
                    </a>
                }
            </div>
        }

        <p class="contact-line">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                <path d="m3 6.5 8.4 6.2a1 1 0 0 0 1.2 0L21 6.5" />
            </svg>
            Questions? Email us at <a href="mailto:customerservice@streamtunes.net">customerservice@streamtunes.net</a>.
        </p>
    </div>
</div>
