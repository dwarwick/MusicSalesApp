@page "/music-library"
@rendermode InteractiveServer
@inherits MusicLibraryModel
@using MusicSalesApp.Services
@using MusicSalesApp.Components.Shared

@if (!ShowHomePageFeatured)
{
    <PageTitle>Music Library</PageTitle>
    <div class="music-library-sticky-header">
        <h3>Music Library</h3>
        <div class="filter-pill-container">
            <button class="filter-pill @(HasActiveAiFilter() ? "active" : string.Empty)" @onclick="ToggleAiFilterDropdown" aria-label="AI music filter">
                @if (HasActiveAiFilter())
                {
                    <span class="filter-pill-clear" @onclick="HandleAiFilterClear" @onclick:stopPropagation="true" title="Clear AI music filter">✕</span>
                }
                <span>@GetAiFilterPillLabel()</span>
                <span class="filter-pill-arrow">@(_aiFilterDropdownOpen ? "▲" : "▼")</span>
            </button>
            @if (_aiFilterDropdownOpen)
            {
                <div class="filter-pill-dropdown filter-pill-dropdown-compact">
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterAll)" @onclick="() => SelectAiFilterOption(AiFilterAll)">
                        <span>All Music</span>
                        @if (_selectedAiFilter == AiFilterAll)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterAny)" @onclick="() => SelectAiFilterOption(AiFilterAny)">
                        <span>Any AI</span>
                        @if (_selectedAiFilter == AiFilterAny)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterAiMusic)" @onclick="() => SelectAiFilterOption(AiFilterAiMusic)">
                        <span class="filter-pill-option-label">
                            <img src="/images/music_icon_24.png" alt="" class="filter-pill-option-icon" />
                            <span>AI Music</span>
                        </span>
                        @if (_selectedAiFilter == AiFilterAiMusic)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterAiVocals)" @onclick="() => SelectAiFilterOption(AiFilterAiVocals)">
                        <span class="filter-pill-option-label">
                            <img src="/images/vocals_icon_24.png" alt="" class="filter-pill-option-icon" />
                            <span>AI Vocals</span>
                        </span>
                        @if (_selectedAiFilter == AiFilterAiVocals)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterAiLyrics)" @onclick="() => SelectAiFilterOption(AiFilterAiLyrics)">
                        <span class="filter-pill-option-label">
                            <img src="/images/lyrics_icon_24.png" alt="" class="filter-pill-option-icon" />
                            <span>AI Lyrics</span>
                        </span>
                        @if (_selectedAiFilter == AiFilterAiLyrics)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                    <button type="button" class="filter-pill-dropdown-option @GetAiFilterOptionClass(AiFilterNonAi)" @onclick="() => SelectAiFilterOption(AiFilterNonAi)">
                        <span>Non-AI Music</span>
                        @if (_selectedAiFilter == AiFilterNonAi)
                        {
                            <span class="filter-pill-option-indicator">✓</span>
                        }
                    </button>
                </div>
            }
        </div>
        <FilterPill Label="Genres"
                    SearchPlaceholder="Find a genre"
                    Items="GetGenreItems()"
                    SelectedItems="_selectedGenres"
                    OnItemToggled="HandleGenreToggled"
                    OnCleared="HandleGenreCleared" />
        <FilterPill Label="Artists"
                    SearchPlaceholder="Find an artist"
                    Items="GetArtistItems()"
                    SelectedItems="_selectedArtists"
                    OnItemToggled="HandleArtistToggled"
                    OnCleared="HandleArtistCleared" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(EmbeddedPageTitle))
{
    <PageTitle>@EmbeddedPageTitle</PageTitle>
}

@if (_loading || IsProcessingTipReturn)
{
    <div class="loading-state">
        <p>Loading...</p>
    </div>
}
else if (_error != null)
{
    <div class="error-state">
        <div class="alert alert-danger">@_error</div>
    </div>
}
else
{
    <div class="@(ShowHomePageFeatured ? "featured-music-carousel" : "music-cards-grid")">
        @* Individual Song Cards *@
        @foreach (var f in GetFilteredFiles())
        {
            var cardId = GetCardId(f.Name);
            var isPlaying = IsCardPlaying(cardId);
            var albumArtSource = GetAlbumArtSource(f.Name);

            <SfCard CssClass="music-card">
                @{
                    // Only the playing card has an <audio> element, and the highlighting is driven
                    // off that element's own clock - so the toggle belongs to the card being played
                    // rather than to every card with lyrics.
                    var cardLyrics = isPlaying && HasPublishedLyrics(f.Name);
                }

                <!-- Album Art -->
                <div class="card-album-art">
                    @if (cardLyrics)
                    {
                        @* Mounted whether or not it is showing, and hidden with a class - the same
                           choice the player page makes. Unmounting would tear down the animation
                           loop and the element cache and rebuild both mid-song, and visibility
                           rather than display keeps offsetTop working, or the first line after a
                           toggle would centre against a zero-height box. *@
                        <div class="lyrics-scroller-overlay @(_showLyricsOnCard ? string.Empty : "is-hidden")">
                            <LyricsScroller AudioElement="_activeAudioElement"
                                            Mode="LyricsScrollerMode.Card"
                                            Document="_playingCardTimings"
                                            EmptyMessage="Lyrics are loading&hellip;" />
                        </div>
                    }

                    <div class="@(cardLyrics && _showLyricsOnCard ? "is-hidden" : string.Empty)">
                        @if (albumArtSource.HasImage)
                        {
                            @* The card art is fluid - width:100% inside a grid track - so the sizes
                               preset is what lets the browser pick a rendition before layout runs. *@
                            <CoverArt Source="albumArtSource" Sizes="@CoverArtSizes.Card" Alt="Album Art" />
                        }
                        else
                        {
                            <div class="card-album-art-animation">
                                <dotlottie-wc src="https://lottie.host/07d61f77-2c9f-49a7-9884-4030d670f9ed/hSfkTa6ydt.lottie" class="card-lottie-animation" autoplay loop></dotlottie-wc>
                            </div>
                        }
                    </div>

                    @if (cardLyrics)
                    {
                        @* stopPropagation because the card itself is clickable - without it,
                           reaching for the lyrics would open the song page instead. *@
                        <button type="button"
                                class="lyrics-toggle-button"
                                @onclick="ToggleCardLyrics"
                                @onclick:stopPropagation="true"
                                title="@(_showLyricsOnCard ? "Show cover art" : "Show lyrics")"
                                aria-pressed="@_showLyricsOnCard.ToString().ToLowerInvariant()">
                            @if (_showLyricsOnCard)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="lyrics-toggle-icon">
                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="lyrics-toggle-icon">
                                    <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z" />
                                </svg>
                            }
                        </button>
                    }
                </div>

                <!-- AI disclosure badges (left) and like/dislike buttons (right) -->
                <div class="card-ai-actions-row">
                    <AiContentBadges IsAiMusic="IsAiGeneratedSong(f.Name)"
                                      IsAiVocals="IsAiVocalsSong(f.Name)"
                                      IsAiLyrics="IsAiLyricsSong(f.Name)"
                                      CssClass="card-ai-content-badges" />
                    <LikeDislikeButtons SongMetadataId="GetSongMetadataId(f.Name)" VerticalLayout="false" />
                </div>

                <!-- Song Title -->
                <div class="card-song-title" title="@GetDisplayTitle(f.Name)">@GetDisplayTitle(f.Name)</div>
                <!-- Artist Name (clickable link) -->
                @{
                    var artistInfo = GetArtistInfo(f.Name);
                }
                @if (!string.IsNullOrEmpty(artistInfo.DisplayName))
                {
                    <div class="card-artist-name">
                        @if (!string.IsNullOrEmpty(artistInfo.PersonaImageUrl))
                        {
                            <img src="@artistInfo.PersonaImageUrl" alt="@artistInfo.DisplayName" class="card-persona-image" />
                        }
                        <a href="@artistInfo.LinkUrl" @onclick:stopPropagation="true" title="View all songs by @artistInfo.DisplayName">@artistInfo.DisplayName</a>
                    </div>
                }
                <!-- Genre (clickable link) -->
                @{
                    var songGenre = GetSongGenre(f.Name);
                }
                <div class="card-genre">
                    <a href="@GetGenreUrl(songGenre)" @onclick:stopPropagation="true" title="View all @songGenre songs">@songGenre</a>
                </div>
                <!-- Stream Count and Tip -->
                <div class="card-stream-count">
                    <div class="card-stream-info">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="stream-icon">
                            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                        </svg>
                        <span>@GetSongStreamCount(f.Name).ToString("N0") streams</span>
                    </div>
                    <div class="card-stream-actions">
                        @if (CanShowTipButton(f.Name))
                        {
                            <button class="tip-heart-button tip-heart-card" @onclick="() => ShowTipForSong(f.Name)" @onclick:stopPropagation="true" title="Tip Creator">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="tip-heart-icon">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                </svg>
                            </button>
                        }
                        <div class="card-stream-report">
                            <ReportButton SongMetadataId="GetSongMetadataId(f.Name)" />
                        </div>
                    </div>
                </div>

                @if (isPlaying)
                {
                    <!-- Mini Player Controls -->
                    <div class="card-mini-player">
                        <!-- Hidden Audio Element -->
                        <audio @ref="_activeAudioElement"
                               preload="auto"
                               class="card-audio-hidden"></audio>

                        <!-- Controls Row: Play/Pause, Stop, Volume -->
                        <div class="card-mini-controls-row">
                            <div class="card-mini-controls">
                                <!-- Play/Pause Button -->

                                <SfButton OnClick=@(() => ToggleCardPlay(cardId)) title="@(IsCardCurrentlyPlaying(cardId) ? "Pause" : "Play")">
                                    @if (IsCardCurrentlyPlaying(cardId))
                                    {
                                        @((MarkupString)SvgIcons.Pause)
                                    }
                                    else
                                    {
                                        @((MarkupString)SvgIcons.Play)
                                    }
                                </SfButton>

                                <!-- Stop Button -->
                                <SfButton OnClick=@(() => StopCard(cardId)) title="Stop">
                                    @((MarkupString)SvgIcons.Stop)
                                </SfButton>
                            </div>

                            <!-- Volume Controls -->
                            <div class="card-volume-controls">
                                <button class="card-volume-button" @onclick="() => ToggleCardMute(cardId)" title="@(IsCardMuted(cardId) ? "Unmute" : "Mute")">
                                    @if (IsCardMuted(cardId) || GetCardVolume(cardId) == 0)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="card-volume-icon">
                                            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89 .86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67 .52-1.42 .93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                                        </svg>
                                    }
                                    else if (GetCardVolume(cardId) < 0.5)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="card-volume-icon">
                                            <path d="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="card-volume-icon">
                                            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89 .86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                                        </svg>
                                    }
                                </button>
                                <div @ref="_activeVolumeBarElement" class="card-volume-bar-container" @onclick="(e) => OnCardVolumeBarClick(e, cardId)">
                                    <div class="card-volume-bar" style="width: @(GetCardVolume(cardId) * 100)%;">
                                        <div class="card-volume-thumb"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Bar Row -->
                        <div class="card-progress-container">
                            <span class="card-time-display">@FormatTime(GetCardCurrentTime(cardId))</span>
                            <div @ref="_activeProgressBarElement" class="card-progress-bar-container @(IsCurrentPlayingTrackRestricted() ? "restricted" : "")" @onclick="(e) => OnCardProgressBarClick(e, cardId)">
                                <div class="card-progress-bar" style="width: @(GetCardProgressPercentage(cardId))%;">
                                    <div class="card-progress-thumb"></div>
                                </div>
                                @if (IsCurrentPlayingTrackRestricted())
                                {
                                    <div class="card-progress-limit-marker" style="left: @(GetCardPreviewLimitPercentage(cardId))%;"></div>
                                }
                            </div>
                            <span class="card-time-display">@FormatTime(GetCardDisplayDuration(cardId))</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Card Actions: Play button and View button (like/dislike live in the AI badges row above) -->
                    <div class="card-actions-with-likes">
                        <div class="action-column">
                            <SfButton CssClass="action-button" onclick=@(() => PlayCard(f.Name)) title="play">@((MarkupString)SvgIcons.Play)</SfButton>
                        </div>
                        <div class="action-column">
                            <SfButton CssClass="action-button" onclick=@(() => GetSongPlayerUrl(f.Name)) title="view">@((MarkupString)SvgIcons.Eye)</SfButton>
                        </div>
                    </div>
                }

                <!-- Bottom row: Share button -->
                <div class="card-bottom-row">
                    <!-- Facebook Share Button -->
                    <FacebookShareButton ShareUrl="@GetSongShareUrl(f.Name)" 
                                       Layout="button_count" 
                                       Size="small" 
                                       CssClass="share-button-card" />
                </div>
            </SfCard>
        }
    </div>
}

<SfToast @ref="_toastRef" ShowCloseButton="true" NewestOnTop="true" ShowProgressBar="true" Timeout="5000">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<SubscribeCtaDialog @ref="_subscribeCtaDialog" IsAuthenticated="_isAuthenticated" HasActiveSubscription="_hasActiveSubscription" />
<TipDialog @ref="_tipDialog" CreatorId="_tipCreatorId" SongMetadataId="_tipSongMetadataId" IsAuthenticated="_isAuthenticated" />

<style>
    .e-card.music-card {
        border-radius: 12px;
        overflow: hidden;
        padding: 8px;
    }
</style>
