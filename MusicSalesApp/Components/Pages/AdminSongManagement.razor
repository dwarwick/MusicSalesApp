@page "/admin/songs"
@inherits AdminSongManagementModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@using MusicSalesApp.Services
@attribute [Authorize(Policy = Permissions.ManageUsers)]

<PageTitle>Song Management</PageTitle>

<h3>Song Management</h3>

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading songs...</p>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @_errorMessage
    </div>
}
else
{
    <div id="grid-container">
        <!-- Syncfusion Data Grid -->
        <SfGrid @ref="_grid" 
                TValue="SongAdminViewModel"
                DataSource="@_allSongs"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                Height='100%' Width='100%'
                EnableAdaptiveUI="false"
                RowRenderingMode="Syncfusion.Blazor.Grids.RowDirection.Horizontal">
            <GridPageSettings PageSize="10"></GridPageSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridEvents TValue="SongAdminViewModel" OnActionBegin="OnActionBegin"></GridEvents>
            <GridColumns>
                <GridColumn HeaderText="Action" Width="100" AllowFiltering="false" AllowSorting="false">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            <SfButton OnClick="() => EditSong(song)" IsPrimary="true" CssClass="e-btn e-small e-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </SfButton>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Song Image" Width="120" Field="@nameof(SongAdminViewModel.SongImageUrl)" AllowFiltering="false">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.SongImageUrl))
                            {
                                <img src="@song.SongImageUrl" alt="Song cover" class="img-thumbnail" style="max-width: 80px; max-height: 80px;" />
                            }
                            else
                            {
                                <span class="text-muted">No image</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.SongTitle)" HeaderText="Song Title" Width="150"></GridColumn>
                <GridColumn HeaderText="MP3 Blob Path" Width="200" Field="@nameof(SongAdminViewModel.Mp3FileName)">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.Mp3FileName))
                            {
                                <small class="text-break">@song.Mp3FileName</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Image Blob Path" Width="200" Field="@nameof(SongAdminViewModel.JpegFileName)">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.JpegFileName))
                            {
                                <small class="text-break">@song.JpegFileName</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.Genre)" HeaderText="Genre" Width="100">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            <span>@(string.IsNullOrEmpty(song.Genre) ? "-" : song.Genre)</span>
                        }
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(SongAdminViewModel.TrackLength)" HeaderText="Track Length" Width="120">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.TrackLength.HasValue)
                            {
                                var ts = TimeSpan.FromSeconds(song.TrackLength.Value);
                                <span>@(ts.Hours > 0 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss"))</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.DisplayOnHomePage)" HeaderText="Home Page" Width="100">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.DisplayOnHomePage)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        <div class="mt-3">
            <p class="text-muted">Total: @_totalCount songs</p>
        </div>
    </div>
}

<!-- Edit Dialog -->
<SfDialog @bind-Visible="_showEditModal" Width="800px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Edit Song Details</Header>
        <Content>
            @if (_editingSong != null)
            {
                <div class="dialog-content">
                    @if (_validationErrors.Any())
                    {
                        <SfMessage Severity="MessageSeverity.Error">
                            <strong>Validation Errors:</strong>
                            <ul>
                                @foreach (var error in _validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </SfMessage>
                    }

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="e-label">MP3 Filename</label>
                            <SfTextBox Value="@_editingSong.Mp3FileName" Enabled="false" CssClass="e-outline" />
                        </div>
                        <div class="col-md-6">
                            <label class="e-label">JPEG Filename</label>
                            <SfTextBox Value="@_editingSong.JpegFileName" Enabled="false" CssClass="e-outline" />
                        </div>
                    </div>



                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="e-label">Song Title</label>
                            <SfTextBox Value="@_editingSong.SongTitle" Enabled="false" CssClass="e-outline" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="e-label">Genre <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="string" TItem="string" @bind-Value="_editGenre" 
                                          DataSource="@(new List<string> { "Rock", "Country", "Pop" })" 
                                          Placeholder="-- Select Genre --"
                                          CssClass="e-outline">
                            </SfDropDownList>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="e-label">Track Length (Read-only)</label>
                            @if (_editingSong.TrackLength.HasValue)
                            {
                                var ts = TimeSpan.FromSeconds(_editingSong.TrackLength.Value);
                                <SfTextBox Value="@(ts.Hours > 0 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss"))" Enabled="false" CssClass="e-outline" />
                            }
                            else
                            {
                                <SfTextBox Value="Not available" Enabled="false" CssClass="e-outline" />
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Song Cover Image</label>
                            @if (!string.IsNullOrEmpty(_editingSong.SongImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@_editingSong.SongImageUrl" alt="Current song cover" class="img-thumbnail" style="max-width: 200px;" />
                                </div>
                            }
                            <InputFile OnChange="HandleSongImageUpload" accept=".jpeg,.jpg,.png" class="form-control" />
                            <small class="text-muted">Upload a new song cover image (JPEG or PNG)</small>
                            @if (_songImageFile != null)
                            {
                                <div class="mt-2 text-success">
                                    <i class="bi bi-check-circle"></i> New file selected: @_songImageFile.Name
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <SfCheckBox @bind-Checked="_editDisplayOnHomePage" Label="Display on Home Page" CssClass="e-outline"></SfCheckBox>
                        </div>
                    </div>
                </div>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="CancelEdit" Content="Cancel" CssClass="e-btn" />
            <SfButton OnClick="SaveEdit" IsPrimary="true" Disabled="@_isSaving" CssClass="e-btn e-primary">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Save Changes
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
