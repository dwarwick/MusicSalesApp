@page "/playlist/{PlaylistId:int}"
@page "/recommended-playlist/{RecommendedUserId:int}"
@page "/artist/{ArtistName}"
@page "/creator/{CreatorId:int}"
@page "/genre/{GenreName}"
@inherits PlaylistPlayerModel

<PageTitle>@_displayTitle - StreamTunes</PageTitle>

@* SEO-visible metadata rendered during static SSR *@
<div class="playlist-seo-content" style="position: absolute; left: -9999px; overflow: hidden;">
    <h1>@_displayTitle</h1>
    @if (!string.IsNullOrEmpty(_seoDescription))
    {
        <p>@_seoDescription</p>
    }
    @foreach (var track in _seoTracks)
    {
        <p>
            @track.Title
            @if (!string.IsNullOrEmpty(track.ArtistName))
            {
                <span> by <a href="/artist/@Uri.EscapeDataString(track.ArtistName)">@track.ArtistName</a></span>
            }
            @if (!string.IsNullOrEmpty(track.Genre))
            {
                <span> &middot; <a href="/genre/@Uri.EscapeDataString(track.Genre)">@track.Genre</a></span>
            }
        </p>
    }
</div>

<PlaylistPlayerInteractive PlaylistId="@PlaylistId"
                           RecommendedUserId="@RecommendedUserId"
                           ArtistName="@ArtistName"
                           CreatorId="@CreatorId"
                           GenreName="@GenreName" />