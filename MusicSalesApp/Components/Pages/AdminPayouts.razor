@page "/admin/payouts"
@inherits AdminPayoutsModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@attribute [Authorize(Policy = Permissions.ManageUsers)]

<PageTitle>Payouts</PageTitle>

<div class="container-fluid my-4">
    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading payouts...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @_errorMessage
        </div>
    }
    else
    {
        @* Tip Payouts Section *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3><i class="bi bi-heart-fill me-2" style="color: #e25555;"></i>Tip Payouts</h3>
                <p class="text-muted mb-0">All tip transactions between listeners and creators</p>
            </div>
            <div class="d-flex gap-2">
                <SfButton CssClass="e-info" OnClick="ExportTipsToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
                </SfButton>
                <SfButton CssClass="e-primary" OnClick="ExportTipsToPdf">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Export to PDF
                </SfButton>
            </div>
        </div>

        <div id="tip-grid-container" class="mb-5">
            <SfGrid @ref="_tipGrid"
                    TValue="TipPayoutViewModel"
                    DataSource="@_tipPayouts"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowExcelExport="true"
                    AllowPdfExport="true"
                    Height="400px">
                <GridPageSettings PageSize="15"></GridPageSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(TipPayoutViewModel.TipperEmail)" HeaderText="Tipper" Width="200"></GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.ArtistName)" HeaderText="Artist" Width="160"></GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.SongTitle)" HeaderText="Song" Width="200">
                        <Template>
                            @{
                                var item = (context as TipPayoutViewModel);
                                if (!string.IsNullOrEmpty(item?.SongTitle))
                                {
                                    <span>@item.SongTitle</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.Amount)" HeaderText="Amount" Width="100" Format="C2" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.Status)" HeaderText="Status" Width="110">
                        <Template>
                            @{
                                var item = (context as TipPayoutViewModel);
                                var badgeClass = item?.Status switch
                                {
                                    "Pending" => "badge bg-warning text-dark",
                                    "Cleared" => "badge bg-info text-dark",
                                    "Paid" => "badge bg-success",
                                    "Refunded" => "badge bg-secondary",
                                    "Chargeback" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };
                                <span class="@badgeClass">@item?.Status</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.PayPalTransactionId)" HeaderText="PayPal Transaction" Width="220">
                        <Template>
                            @{
                                var item = (context as TipPayoutViewModel);
                                if (!string.IsNullOrEmpty(item?.PayPalTransactionId))
                                {
                                    <small class="text-break">@item.PayPalTransactionId</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.CreatedAt)" HeaderText="Date (UTC)" Width="180">
                        <Template>
                            @{
                                var item = (context as TipPayoutViewModel);
                                <span>@item?.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(TipPayoutViewModel.PaidAt)" HeaderText="Paid At (UTC)" Width="180">
                        <Template>
                            @{
                                var item = (context as TipPayoutViewModel);
                                if (item?.PaidAt.HasValue == true)
                                {
                                    <span>@item.PaidAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            <div class="mt-2">
                <p class="text-muted">Total: @_tipPayouts.Count records</p>
            </div>
        </div>

        @* Stream Payouts Section *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3><i class="bi bi-music-note-beamed me-2"></i>Stream Payouts</h3>
                <p class="text-muted mb-0">All stream payout transactions to creators</p>
            </div>
            <div class="d-flex gap-2">
                <SfButton CssClass="e-info" OnClick="ExportStreamsToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
                </SfButton>
                <SfButton CssClass="e-primary" OnClick="ExportStreamsToPdf">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Export to PDF
                </SfButton>
            </div>
        </div>

        <div id="stream-grid-container">
            <SfGrid @ref="_streamGrid"
                    TValue="StreamPayoutViewModel"
                    DataSource="@_streamPayouts"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowExcelExport="true"
                    AllowPdfExport="true"
                    Height="400px">
                <GridPageSettings PageSize="15"></GridPageSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.ArtistName)" HeaderText="Artist" Width="160"></GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.SongTitle)" HeaderText="Song" Width="220"></GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.StreamCount)" HeaderText="Streams" Width="100" Format="N0" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.PayoutAmount)" HeaderText="Payout Amount" Width="130" Format="C2" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.WithheldAmount)" HeaderText="Withheld" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>
                            @{
                                var item = (context as StreamPayoutViewModel);
                                if (item?.WithheldAmount > 0)
                                {
                                    <span style="color: #dc3545;">$@item.WithheldAmount.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">$0.00</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.PayPalTransactionId)" HeaderText="PayPal Transaction" Width="220">
                        <Template>
                            @{
                                var item = (context as StreamPayoutViewModel);
                                if (!string.IsNullOrEmpty(item?.PayPalTransactionId))
                                {
                                    <small class="text-break">@item.PayPalTransactionId</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(StreamPayoutViewModel.PaymentDate)" HeaderText="Date (UTC)" Width="180">
                        <Template>
                            @{
                                var item = (context as StreamPayoutViewModel);
                                <span>@item?.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            <div class="mt-2">
                <p class="text-muted">Total: @_streamPayouts.Count records</p>
            </div>
        </div>
    }
</div>
