@page "/creator/personas"
@rendermode InteractiveServer
@inherits ManagePersonasModel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@attribute [Authorize(Policy = Permissions.ManageOwnSongs)]

<PageTitle>Your personas</PageTitle>

@*
    A persona is one identity: name, image, bio, website, and the songs it speaks for. The
    SfGrid this replaces split exactly that across six sortable, filterable, resizable
    columns of the same person - a table shape applied to something that is never a table.

    Same settings-* kit as /CreatorSettings, because this is the other half of the same job.
*@
<div class="settings-page">
    @if (_loading)
    {
        <div class="settings-loading" role="status">
            <span class="settings-spinner" aria-hidden="true"></span>
            <span>Loading your personas&hellip;</span>
        </div>
    }
    else
    {
        <div class="settings-main settings-main-wide">
            <div class="settings-head">
                <p class="settings-head-eyebrow">Creator</p>
                <h1 class="settings-head-title">Your personas</h1>
                <p class="settings-head-note">A persona is the artist name a listener sees on a song. Link a song to one and it overrides your display name, and brings its own image, bio and website with it.</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="settings-alert settings-alert-warn" role="alert">
                    <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="settings-alert settings-alert-info" role="status">
                    <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                    <span>@_successMessage</span>
                </div>
            }

            @* When the load failed the list is unknown, not empty - so the empty state is
               wrong here, and its Create button could not work anyway. A dead end still gets
               a way out: the only fix for "you are not a creator" is on the settings page. *@
            @if (_loadFailed)
            {
                <section class="settings-card">
                    <div class="settings-empty">
                        <span class="settings-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                        </span>
                        <p class="settings-empty-title">We could not load your personas</p>
                        <p class="settings-empty-body">Nothing has been changed. Creator settings is where a creator account is set up, and where to come back from.</p>
                        <div class="settings-actions">
                            <a href="@AppPageRoutes.CreatorSettings" class="e-control e-btn settings-btn settings-btn-violet">Go to Creator Settings</a>
                        </div>
                    </div>
                </section>
            }
            else if (_personas.Count == 0)
            {
                <section class="settings-card">
                    <div class="settings-empty">
                        <span class="settings-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                        </span>
                        <p class="settings-empty-title">No personas yet</p>
                        <p class="settings-empty-body">Your songs show the display name from your creator settings. Create a persona if you release under a band or project name.</p>
                        <div class="settings-actions">
                            <SfButton CssClass="e-btn settings-btn settings-btn-violet" Content="Create a Persona" OnClick="ShowAddDialog" />
                        </div>
                    </div>
                </section>
            }
            else
            {
                <div class="persona-toolbar">
                    <span class="persona-summary">@PersonaSummary</span>
                    <SfButton CssClass="e-btn settings-btn settings-btn-violet" Content="Create a Persona" OnClick="ShowAddDialog" />
                </div>

                <div class="persona-cards">
                    @foreach (var persona in _personas)
                    {
                        <article class="persona-card">
                            <div class="persona-card-head">
                                <span class="persona-avatar persona-avatar-lg">
                                    @if (!string.IsNullOrEmpty(persona.PersonaImageUrl))
                                    {
                                        <img src="@persona.PersonaImageUrl" alt="" />
                                    }
                                    else
                                    {
                                        @PersonaInitial(persona.Name)
                                    }
                                </span>
                                <div class="persona-card-title">
                                    <span class="persona-name">@persona.Name</span>
                                    <span class="persona-meta">@SongCountLabel(persona.SongCount)</span>
                                </div>
                                <span class="status-pill @(persona.IsEnabled ? "" : "status-pill-warn")"><span class="status-pill-dot"></span>@(persona.IsEnabled ? "Live" : "Disabled")</span>
                            </div>

                            <p class="persona-card-bio">@(string.IsNullOrWhiteSpace(persona.Bio) ? "No bio yet." : persona.Bio)</p>

                            @if (!string.IsNullOrWhiteSpace(persona.WebsiteUrl))
                            {
                                <a class="persona-card-site" href="@persona.WebsiteUrl" target="_blank" rel="noopener noreferrer">@persona.WebsiteUrl</a>
                            }
                            else
                            {
                                <p class="persona-card-site persona-card-site-none">No website</p>
                            }

                            @* Says what will actually happen to the image rather than flagging it
                               with a warning badge and leaving the reader to guess. *@
                            @if (persona.IsImageSquare == false)
                            {
                                <div class="info-strip info-strip-warn">
                                    <svg class="info-strip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                                    <span>This image is not square, so it gets cropped when a listener sees it. Open it to choose what is kept.</span>
                                </div>
                            }

                            <div class="settings-actions">
                                <SfButton CssClass="e-btn settings-btn settings-btn-small" Content="Edit" OnClick="() => EditPersona(persona)" />
                                <SfButton CssClass="e-btn settings-btn settings-btn-small settings-btn-danger-outline" Content="Delete" OnClick="() => ShowDeleteConfirmation(persona)" />
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }
</div>

@* ------------------------------------------------------------------ delete *@
<SfDialog @bind-Visible="_showDeleteDialog" Width="470px" IsModal="true" ShowCloseIcon="true" CssClass="settings-dialog">
    <DialogTemplates>
        <Header>Delete this persona?</Header>
        <Content>
            @if (_personaToDelete != null)
            {
                @* The songs are what the reader is actually worried about, so that goes first
                   and says plainly that they stay. *@
                @if (_personaToDelete.SongCount > 0)
                {
                    <p class="settings-prose">The <strong>@SongCountLabel(_personaToDelete.SongCount)</strong> linked to <strong>@_personaToDelete.Name</strong> stay on StreamTunes. They lose the persona name and fall back to your display name.</p>
                }
                else
                {
                    <p class="settings-prose">No songs are linked to <strong>@_personaToDelete.Name</strong>, so nothing in your catalogue changes.</p>
                }

                <div class="info-strip info-strip-warn">
                    <svg class="info-strip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                    <span>The persona image, bio and website are deleted. This cannot be undone.</span>
                </div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-btn settings-btn" Content="Keep It" OnClick="CancelDelete" />
            <SfButton CssClass="e-btn settings-btn settings-btn-danger" Content="@(_isDeleting ? "Deleting..." : "Delete Persona")" OnClick="ConfirmDelete" Disabled="@_isDeleting" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@* -------------------------------------------------------------- create/edit *@
<SfDialog @bind-Visible="_showEditDialog" Width="560px" IsModal="true" ShowCloseIcon="true" CssClass="settings-dialog">
    <DialogTemplates>
        <Header>@(_isNewPersona ? "Create a persona" : "Edit persona")</Header>
        <Content>
            @if (_editingPersona != null)
            {
                @if (_validationErrors.Any())
                {
                    <div class="settings-alert settings-alert-warn" role="alert">
                        <svg class="settings-alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                        <span>@string.Join(" ", _validationErrors)</span>
                    </div>
                }

                <div class="settings-field">
                    <label for="personaName" class="settings-label">Persona name</label>
                    <SfTextBox @bind-Value="_editName" ID="personaName" CssClass="e-outline" Placeholder="Artist or band name" />
                    <p class="settings-hint">The artist name shown on every song linked to this persona.</p>
                </div>

                <div class="settings-field">
                    <div class="settings-label-row">
                        <label for="personaBio" class="settings-label">Bio <span class="settings-optional">(optional)</span></label>
                        <span class="settings-count">@BioLength / 1000</span>
                    </div>
                    <SfTextBox @bind-Value="_editBio" ID="personaBio" CssClass="e-outline" Multiline="true" MaxLength="1000" Placeholder="A line or two about this persona" />
                </div>

                <div class="settings-field">
                    <label for="personaWebsite" class="settings-label">Website <span class="settings-optional">(optional)</span></label>
                    <SfTextBox @bind-Value="_editWebsiteUrl" ID="personaWebsite" CssClass="e-outline" Placeholder="https://example.com" />
                </div>

                <p class="settings-label">Profile image</p>
                <div class="persona-image-picker">
                    <span class="persona-avatar persona-avatar-lg">
                        @if (_cropApplied)
                        {
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                        }
                        else if (!string.IsNullOrEmpty(_newPersonaImagePreviewUrl))
                        {
                            <img src="@_newPersonaImagePreviewUrl" alt="" />
                        }
                        else if (!string.IsNullOrEmpty(_editingPersona.PersonaImageUrl))
                        {
                            <img src="@_editingPersona.PersonaImageUrl" alt="" />
                        }
                        else
                        {
                            @PersonaInitial(_editName)
                        }
                    </span>
                    <div class="persona-image-copy">
                        <p class="persona-image-title">Square, at least 320&times;320. JPEG or PNG.</p>
                        <p class="settings-hint">A non-square image is cropped to a square when a listener sees it, so crop it here and choose what stays.</p>
                        <InputFile OnChange="HandlePersonaImageUpload" accept=".jpeg,.jpg,.png" class="persona-image-input" />
                    </div>
                </div>

                @if (_cropApplied)
                {
                    <div class="info-strip">
                        <svg class="info-strip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" /></svg>
                        <span>Cropped to a square. It is saved when you save the persona.</span>
                    </div>
                }
                else if (NeedsCrop)
                {
                    <div class="info-strip info-strip-warn">
                        <svg class="info-strip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2 1 21h22L12 2zm1 15h-2v-2h2v2zm0-4h-2V9h2v4z" /></svg>
                        <span>This image is not square, so it gets cropped when a listener sees it. Crop it here to choose what is kept.</span>
                    </div>
                }

                @if (CanOpenCropTool)
                {
                    <div class="settings-actions">
                        <SfButton CssClass="e-btn settings-btn settings-btn-small" Content="Crop to a Square" OnClick="OpenCropTool" />
                    </div>
                }

                @if (_showCropTool)
                {
                    <div class="crop-tool">
                        <p class="settings-hint">Drag to move, and use the slider to zoom. Everything outside the square is discarded.</p>
                        <canvas id="persona-crop-canvas" width="300" height="300" class="crop-canvas"></canvas>
                        <div class="crop-zoom">
                            <label for="personaCropZoom" class="settings-label">Zoom</label>
                            <input type="range" id="personaCropZoom" min="0" max="100" value="@_cropZoom"
                                   @oninput="@(async (e) => await OnCropZoomChanged(int.Parse(e.Value?.ToString() ?? "50")))" />
                        </div>
                        <div class="settings-actions">
                            <SfButton CssClass="e-btn settings-btn settings-btn-small settings-btn-violet" Content="Apply Crop" OnClick="ApplyCrop" />
                            <SfButton CssClass="e-btn settings-btn settings-btn-small" Content="Cancel" OnClick="CancelCrop" />
                        </div>
                    </div>
                }
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-btn settings-btn" Content="Cancel" OnClick="CancelEdit" />
            <SfButton CssClass="e-btn settings-btn settings-btn-violet" Content="@SaveButtonLabel" OnClick="SaveEdit" Disabled="@_isSaving" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
