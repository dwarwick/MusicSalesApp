@page "/upload-files"
@rendermode InteractiveServer
@inherits UploadFilesModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Services
@attribute [Authorize(Policy = Permissions.UploadFiles)]

<PageTitle>Upload Music Files</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="@(_isUploading || _isProcessingFiles)" />

<div class="d-flex flex-row align-items-center mb-2">
    <h3 class="me-2 mb-0">Upload Music Files</h3>
    
    <SfButton CssClass="cta-primary" IconCss="fas fa-circle-info" OnClick=@(() => NavigationManager.NavigateTo("/uploadhelp"))>How does this work?</SfButton>
</div>

<SfMessage Severity="MessageSeverity.Info" CssClass="mb-3">
    Audio files uploaded in formats other than MP3 will be converted to MP3 before storage. This conversion can add processing time, so larger files may take longer to finish uploading.
</SfMessage>

<div class="container-fluid">
    
    <label class="upload-box @((_isUploading || _isProcessingFiles) ? "upload-box-disabled" : "") mb-2"
           style="display: @((_isUploading || _isProcessingFiles) ? "none" : "flex")">
        <InputFile @ref="FileInput"
                   OnChange="HandleFileSelected"
                   class="hidden-input"
                   multiple />

        <div class="upload-content" style="display: @(_isUploading ? "none" : "block")">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <div class="mt-2 fw-semibold">Drag & drop files here</div>
            <div class="text-muted small">or click to browse</div>
            <div class="text-muted small mt-2">Audio formats: MP3, WAV, FLAC, OGG, M4A, AAC, WMA</div>
            <div class="text-muted small">Max audio file size: @_maxAudioUploadSizeMBDisplay MB</div>
            <div class="text-muted small mt-2">Cover art formats: JPEG, PNG (optional)</div>
            <div class="text-muted small">Max image file size: @_maxImageUploadSizeMBDisplay MB</div>
        </div>

        <div class="upload-spinner" style="display: @(_isUploading ? "flex" : "none")">
            <dotlottie-wc src="https://lottie.host/07d61f77-2c9f-49a7-9884-4030d670f9ed/hSfkTa6ydt.lottie"
                          class="upload-processing-animation"
                          autoplay loop></dotlottie-wc>
        </div>
    </label>

    @if (!string.IsNullOrEmpty(_validationErrorMessage))
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Validation Error:</strong> @_validationErrorMessage
                    <button type="button" class="btn-close" @onclick="ClearValidationError" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (_initialUploadItems.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <h5>Upload Progress</h5>
                <div class="mb-2">
                    <span class="text-muted small">@_initialUploadStatusMessage</span>
                </div>
                <div class="progress mb-3">
                    <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @(_initialUploadBatchProgress)%"
                         aria-valuenow="@_initialUploadBatchProgress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @_initialUploadBatchProgress%
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Type</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _initialUploadItems)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.FileType</td>
                                    <td>@item.FormattedSize</td>
                                    <td>
                                        <span class="badge @(item.Progress >= 100 ? "bg-success" : "bg-info")">@item.StatusMessage</span>
                                    </td>
                                    <td style="width: 30%;">
                                        <div class="progress">
                                            <div class="progress-bar @(item.Progress >= 100 ? "bg-success" : "bg-primary progress-bar-striped progress-bar-animated")"
                                                 role="progressbar"
                                                 style="width: @(item.Progress)%"
                                                 aria-valuenow="@item.Progress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                @item.Progress%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    @if (_uploadItems.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <h5>Upload Progress</h5>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Song Name</th>
                                <th>Audio File</th>
                                <th>Cover Art</th>
                                <th>Status</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _uploadItems)
                            {
                                <tr>
                                    <td>@item.BaseName</td>
                                    <td>
                                        @item.UploadedAudioFileName
                                        @if (!string.Equals(item.AudioFileName, item.UploadedAudioFileName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <br />

                                            <small class="text-muted">Converted from @item.AudioFileName (@FormatFileSize(item.AudioFileSize))</small>
                                        }
                                        else
                                        {
                                            <br />

                                            <small class="text-muted">@FormatFileSize(item.AudioFileSize)</small>
                                        }
                                    </td>
                                    <td>
                                        @if (item.HasCoverArt)
                                        {
                                            @item.CoverArtFileName
                                            <br />

                                            <small class="text-muted">@FormatFileSize(item.CoverArtFileSize)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>No cover art (will use default animation)</em></span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == UploadStatus.Uploading || item.Status == UploadStatus.Converting)
                                        {
                                            <span class="badge bg-info">@item.StatusMessage</span>
                                        }
                                        else if (item.Status == UploadStatus.Completed)
                                        {
                                            <span class="badge bg-success">@item.StatusMessage</span>
                                        }
                                        else if (item.Status == UploadStatus.Failed)
                                        {
                                            <span class="badge bg-danger">@item.StatusMessage</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.StatusMessage</span>
                                        }
                                    </td>
                                    <td style="width: 30%;">
                                        <div class="progress">
                                            <div class="progress-bar @GetProgressBarClass(item.Status)"
                                                 role="progressbar"
                                                 style="width: @(item.Progress)%"
                                                 aria-valuenow="@item.Progress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                @item.Progress%
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.ErrorMessage))
                                        {
                                            <small class="text-danger">@item.ErrorMessage</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_unmatchedCoverArtFiles.Any())
        {
            <div class="row mt-3">
                <div class="col-12">
                    <p class="text-muted"><strong>The following cover art files could not be matched to an audio file and were not uploaded:</strong></p>
                    <ul class="text-muted">
                        @foreach (var file in _unmatchedCoverArtFiles)
                        {
                            <li>@file</li>
                        }
                    </ul>
                </div>
            </div>
        }
    }

    @if (_duplicateSongFiles.Any())
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-warning" role="alert">
                    <strong>Duplicate songs detected:</strong> The following files were not uploaded because a song with the same title already exists. Please rename these files if you intended to upload different songs.
                    <ul class="mb-0 mt-2">
                        @foreach (var file in _duplicateSongFiles)
                        {
                            <li>@file</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .upload-box {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 260px;
    border: 2px dashed #6c757d;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
}

.upload-box:hover {
    background-color: rgba(255,255,255,0.05);
}

.upload-box-disabled {
    pointer-events: none;
    cursor: not-allowed;
}

.hidden-input {
    display: none;
}

.upload-content {
    text-align: center;
    pointer-events: none;
}

.upload-content i {
    font-size: 3rem;
}

.upload-spinner {
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

@@keyframes upload-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

.upload-processing-animation {
    width: 200px;
    height: 200px;
    animation: upload-spin 2s linear infinite;
}

    .dropzone {
        display: block;
        width: 100%;
        height: 220px;
        border: 2px dashed #bbb;
        border-radius: 8px;
        text-align: center;
        padding: 40px;
    }

        .dropzone:hover {
            border-color: #888;
        }
</style>

<script suppress-error="BL9992">
    (function () {
        // Handle dragover: allow drops inside the upload box, prevent everywhere else
        document.addEventListener('dragover', function (e) {
            var uploadBox = e.target.closest('.upload-box');
            if (uploadBox) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
            } else {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'none';
            }
        });

        function getFileSignature(fileList) {
            var parts = [];
            for (var i = 0; i < fileList.length; i++) {
                var file = fileList[i];
                parts.push(file.name + ':' + file.size + ':' + file.lastModified);
            }
            return parts.join('|');
        }

        function ensureDropChangeGuard(input) {
            if (input._streamTunesDropChangeGuard) {
                return input._streamTunesDropChangeGuard;
            }

            var guard = {
                signature: null,
                delivered: false,
                suppressUntil: 0
            };

            input._streamTunesDropChangeGuard = guard;
            input.addEventListener('change', function (e) {
                if (!guard.signature) {
                    return;
                }

                if (Date.now() > guard.suppressUntil) {
                    guard.signature = null;
                    guard.delivered = false;
                    return;
                }

                if (getFileSignature(input.files) !== guard.signature) {
                    return;
                }

                if (guard.delivered) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return;
                }

                guard.delivered = true;
            }, true);

            return guard;
        }

        // Handle drop: forward files to the hidden InputFile inside the upload box.
        // Some browsers can fire a native change event after we dispatch the synthetic
        // one. Blazor treats the second event as a new file list and invalidates the
        // first event's IBrowserFile references, so the guard below lets only one
        // change event for this exact dropped file set reach Blazor.
        document.addEventListener('drop', function (e) {
            var uploadBox = e.target.closest('.upload-box');
            if (uploadBox && !uploadBox.classList.contains('upload-box-disabled')) {
                e.preventDefault();
                var input = uploadBox.querySelector('input[type="file"]');
                if (input && e.dataTransfer.files.length > 0) {
                    // Copy files into a fresh DataTransfer so references stay valid
                    // after the drop event's DataTransfer is cleaned up.
                    var dt = new DataTransfer();
                    for (var i = 0; i < e.dataTransfer.files.length; i++) {
                        dt.items.add(e.dataTransfer.files[i]);
                    }

                    var signature = getFileSignature(dt.files);
                    var guard = ensureDropChangeGuard(input);
                    guard.signature = signature;
                    guard.delivered = false;
                    guard.suppressUntil = Date.now() + 1000;

                    input.files = dt.files;

                    window.setTimeout(function () {
                        if (guard.signature === signature && !guard.delivered) {
                            input.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    }, 25);
                }
            } else {
                e.preventDefault();
            }
        });
    })();

    window.triggerClick = function (element) {
        element.click();
    };

    // Warn user before closing tab/browser during uploads
    window.uploadFilesHelper = {
        enableBeforeUnload: function () {
            if (window._uploadBeforeUnloadHandler) {
                return;
            }

            window._uploadBeforeUnloadHandler = function (e) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            };
            window.addEventListener('beforeunload', window._uploadBeforeUnloadHandler);
        },
        disableBeforeUnload: function () {
            if (window._uploadBeforeUnloadHandler) {
                window.removeEventListener('beforeunload', window._uploadBeforeUnloadHandler);
                window._uploadBeforeUnloadHandler = null;
            }
        }
    };
</script>
