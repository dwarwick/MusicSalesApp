@page "/upload-files"
@rendermode InteractiveServer
@inherits UploadFilesModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Services
@attribute [Authorize(Policy = Permissions.UploadFiles)]

<PageTitle>Upload Music Files</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="@(_isUploading || _isProcessingFiles || _awaitingTitleConfirmation)" />

<div class="d-flex flex-row align-items-center mb-2">
    <h3 class="me-2 mb-0">Upload Music Files</h3>
    
    <SfButton CssClass="cta-primary" OnClick=@(() => NavigationManager.NavigateTo("/uploadhelp"))>How does this work?</SfButton>
</div>

<SfMessage Severity="MessageSeverity.Info" CssClass="mb-3">
    Supported audio: MP3, WAV, FLAC, OGG, M4A, AAC, WMA. Cover art: JPG, JPEG, PNG.
    Name your files however you like. Each song title is filled in from its filename and you can edit it before uploading.
    Files are decoded before upload, and the validated originals you uploaded are retained alongside the playback MP3.
</SfMessage>

<div class="container-fluid">

    @* Stays visible through the review step, unlike the drop box. The setting is still live there -
       unticking it takes the re-pairing interface away - and the review step is exactly where a
       creator discovers they did not want it. Hiding it at that moment also made its state
       unknowable, which turned "it paused anyway" into an unanswerable bug report. *@
    @if (ShowMatchCoverArtChoice)
    {
        <div class="mb-3">
            <SfCheckBox TChecked="bool"
                        Label="Let me re-pair cover art before uploading"
                        Checked="@_matchCoverArtBeforeUpload"
                        ValueChange="@OnMatchCoverArtChanged" />
            @* This used to decide whether the batch paused at all, and said so. It does not
               any more - every batch stops so titles can be confirmed and genres chosen,
               because a song cannot publish without a genre. All this now decides is whether
               the artwork controls appear at that stop. *@
            <small class="text-muted d-block ms-4 ps-1">
                Every batch pauses so you can confirm each title and choose a genre. Tick this to
                add the artwork controls to that step, so you can drag an image onto a different
                song. Cover art is matched automatically either way.
                @if (_awaitingTitleConfirmation)
                {
                    @* It does NOT wait for the next batch. Unticking it here removes the pairing
                       controls from the batch on screen, and saying otherwise would strand any
                       image the creator had not placed yet. *@
                    <strong class="d-block mt-1">
                        Unticking this now also removes the cover art controls from the batch below.
                    </strong>
                }
            </small>
        </div>
    }

    <label class="upload-box @(HideUploadBox ? "upload-box-disabled" : "") mb-2"
           style="display: @(HideUploadBox ? "none" : "flex")">
        @* direct-upload-input is how direct-upload.js finds the live FileList. Blazor's IBrowserFile
           handles cannot be handed to JavaScript, and re-reading the DOM's own files is both simpler
           and immune to the handle-invalidation traps documented in the code-behind. *@
        <InputFile @ref="FileInput"
                   OnChange="HandleFileSelected"
                   class="hidden-input direct-upload-input"
                   multiple />

        <div class="upload-content" style="display: @(_isUploading ? "none" : "block")">
            @* Inline SVG with fill="currentColor". A glyph font cannot follow the theme. *@
            <svg class="upload-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13a5 5 0 0 0 .35-9.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
            <div class="mt-2 fw-semibold">Drag & drop files here</div>
            <div class="text-muted small">or click to browse</div>
            <div class="text-muted small mt-2">Audio formats: MP3, WAV, FLAC, OGG, M4A, AAC, WMA</div>
            <div class="text-muted small">Max audio file size: @_maxAudioUploadSizeMBDisplay MB</div>
            <div class="text-muted small mt-2">Cover art formats: JPEG, PNG (optional)</div>
            <div class="text-muted small">Max image file size: @_maxImageUploadSizeMBDisplay MB</div>
        </div>

        @* Mounted only while uploading rather than merely display:none'd. A mounted
           <dotlottie-wc> builds a player and pulls the WASM renderer on every view of
           this form, whether or not it is visible. .upload-spinner has no display of
           its own, so the inline flex stays. This is the one place the animation's
           "Loading" semantics are actually correct. *@
        @if (_isUploading)
        {
            <div class="upload-spinner" style="display: flex">
                <LottieAnimation CssClass="upload-processing-animation" />
            </div>
        }
    </label>

    @if (!string.IsNullOrEmpty(_validationErrorMessage))
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Validation Error:</strong> <span style="white-space: pre-line">@_validationErrorMessage</span>
                    <button type="button" class="btn-close" @onclick="ClearValidationError" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @* One bar for the whole batch, above both phases and present from the first file selected
       until the last song finishes. The per-song bars below answer "where is this song"; this
       answers "how far through is the batch", which is the useful question when several are in
       flight at once. Receiving is weighted at 25% - see AudioProcessingProgressCalculator. *@
    @if (ShowOverallProgress)
    {
        <div class="row mt-4">
            <div class="col-12">
                <h5>Overall Progress</h5>
                @if (!string.IsNullOrEmpty(OverallProgressMessage))
                {
                    <div class="mb-2">
                        <span class="text-muted small">@OverallProgressMessage</span>
                    </div>
                }
                @* Still and grey while the batch is waiting on the creator. A striped, animated bar
                   is the universal "working, please wait" signal, and showing it during the review
                   step told them to sit still at the exact moment they needed to act - which is
                   what made the upload button easy to miss. *@
                <div class="progress mb-4" style="height: 1.5rem;">
                    <div class="progress-bar @(OverallProgressPercent >= 100
                             ? "bg-success"
                             : _awaitingTitleConfirmation
                                 ? "bg-secondary"
                                 : "bg-primary progress-bar-striped progress-bar-animated")"
                         role="progressbar"
                         style="width: @(OverallProgressPercent)%"
                         aria-valuenow="@OverallProgressPercent"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-label="@($"Overall progress: {OverallProgressMessage}")">
                        @OverallProgressPercent%
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_initialUploadItems.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <h5>Receiving Files</h5>
                <div class="mb-2">
                    <span class="text-muted small">@_initialUploadStatusMessage</span>
                </div>
                <div class="progress mb-3">
                    <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @(_initialUploadBatchProgress)%"
                         aria-valuenow="@_initialUploadBatchProgress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @_initialUploadBatchProgress%
                    </div>
                </div>
                <div class="table-responsive">
                    @* review-table is what the breakpoint sheets key the card treatment off.
                       Six columns do not fit a phone, so below 992px each row becomes a card and
                       every cell grows a label from its data-label. Only while reviewing: the
                       progress view has four columns and reads fine as a table. *@
                    <table class="table table-striped @(_awaitingTitleConfirmation ? "review-table" : "")">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Type</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _initialUploadItems)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.FileType</td>
                                    <td>@item.FormattedSize</td>
                                    <td>
                                        <span class="badge @(item.Progress >= 100 ? "bg-success" : "bg-info")">@item.StatusMessage</span>
                                    </td>
                                    <td style="width: 30%;">
                                        <div class="progress">
                                            <div class="progress-bar @(item.Progress >= 100 ? "bg-success" : "bg-primary progress-bar-striped progress-bar-animated")"
                                                 role="progressbar"
                                                 style="width: @(item.Progress)%"
                                                 aria-valuenow="@item.Progress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                @item.Progress%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    @if (_uploadItems.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                @* The action sits above the table as well as below it. A batch can be fifty rows, so
                   a button that only exists past the end of one is a button a creator scrolls away
                   from and never comes back to - which is exactly what happened on the first run. *@
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="mb-0">@(_awaitingTitleConfirmation ? "Review Before Uploading" : "Processing Progress")</h5>
                    @if (_awaitingTitleConfirmation)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <SfButton CssClass="cta-primary e-large" OnClick="StartUploadAsync">
                                @UploadButtonLabel
                            </SfButton>
                            <SfButton CssClass="e-outline" OnClick="CancelPendingBatchAsync">Cancel</SfButton>
                            @if (!ReviewIsComplete)
                            {
                                <span class="review-outstanding">@ReviewOutstandingMessage</span>
                            }
                        </div>
                    }
                </div>
                @if (_awaitingTitleConfirmation)
                {
                    <p class="text-muted mt-2">
                        Titles come from your filenames and cover art is matched automatically.
                        Check both below — your songs have not been published yet.
                        @if (SongsWithoutCoverArtCount > 0)
                        {
                            <span class="d-block mt-1">
                                <svg class="inline-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M11 7h2v2h-2V7zm0 4h2v6h-2v-6zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
                                @(SongsWithoutCoverArtCount == 1
                                    ? "1 song has no cover art"
                                    : $"{SongsWithoutCoverArtCount} songs have no cover art")
                                and will use the default animation unless you add artwork.
                            </span>
                        }
                    </p>

                    @* Most batches are one release, so one genre and one persona across the whole
                       thing is the common case rather than the exception - which is the entire
                       reason this row exists.

                       It overwrites rows already filled in, deliberately. Only filling blanks
                       sounds safer and is worse: the control would do different things depending
                       on state the creator cannot see, and anyone who genuinely wants one genre
                       across fifty songs would have to clear rows first. *@
                    @if (_uploadItems.Count > 1)
                    {
                        <div class="apply-all">
                            <span class="apply-all-label">Apply to all @_uploadItems.Count</span>

                            <div class="apply-all-field">
                                <label class="form-label" for="applyAllTitles">Titles</label>
                                <SfButton ID="applyAllTitles" CssClass="e-small e-outline" Content="All titles look right" OnClick="ConfirmAllTitles" />
                            </div>

                            <div class="apply-all-field">
                                <label class="form-label" for="applyAllGenre">Genre</label>
                                <select id="applyAllGenre" class="form-select review-select"
                                        @onchange="@(e => { _applyAllGenre = e.Value?.ToString() ?? string.Empty; ApplyGenreToAll(); })">
                                    <option value="" selected="@string.IsNullOrEmpty(_applyAllGenre)">Choose a genre</option>
                                    @foreach (var genre in _genres)
                                    {
                                        <option value="@genre.Name" selected="@(string.Equals(genre.Name, _applyAllGenre, StringComparison.OrdinalIgnoreCase))">@genre.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="apply-all-field apply-all-field-wide">
                                <label class="form-label">AI disclosure</label>
                                @* The same two-group choice a row has, not a shortcut for one side of
                                   it. A batch is usually one release, so "this whole EP has AI vocals"
                                   is as normal an answer as "all of it is original". *@
                                <div class="ai-declare">
                                    <SfCheckBox TChecked="bool" Label="All original"
                                                Checked="@_applyAllOriginal"
                                                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => ApplyAllOriginal(a.Checked))" />

                                    <span class="ai-declare-or">or say which parts are AI</span>

                                    <div class="ai-flags">
                                        <SfCheckBox TChecked="bool" Label="AI music"
                                                    Checked="@_applyAllAiMusic"
                                                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => ApplyAllAiMusic(a.Checked))" />
                                        <SfCheckBox TChecked="bool" Label="AI vocals"
                                                    Checked="@_applyAllAiVocals"
                                                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => ApplyAllAiVocals(a.Checked))" />
                                        <SfCheckBox TChecked="bool" Label="AI lyrics"
                                                    Checked="@_applyAllAiLyrics"
                                                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => ApplyAllAiLyrics(a.Checked))" />
                                    </div>
                                </div>
                            </div>

                            <div class="apply-all-field">
                                <label class="form-label" for="applyAllPersona">Artist persona</label>
                                <select id="applyAllPersona" class="form-select review-select"
                                        @onchange="@(e => { _applyAllPersonaId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()); ApplyPersonaToAll(); })">
                                    <option value="" selected="@(_applyAllPersonaId == null)">No persona</option>
                                    @foreach (var persona in _personas)
                                    {
                                        <option value="@persona.Id" selected="@(_applyAllPersonaId == persona.Id)">@persona.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    @* Shown only when it holds something, or while the creator is mid-gesture and
                       needs somewhere to let go. An empty dashed box above a table where every
                       pairing is already right announces a problem that does not exist. Also a drop
                       target, so artwork can come off a song without needing somewhere else to go. *@
                    @if (ShowCoverArtPool)
                    {
                        <div class="cover-art-pool @(HeldCoverArt != null ? "cover-art-pool-active" : "")"
                             @ondragover:preventDefault="true"
                             @ondrop="ReturnHeldCoverArtToPool">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>
                                    @if (!_unmatchedCoverArtFiles.Any())
                                    {
                                        <text>Drop here to remove this artwork from its song</text>
                                    }
                                    else if (HeldCoverArt != null)
                                    {
                                        <text>Drop @HeldCoverArt on a song below, or here to leave it unused</text>
                                    }
                                    else
                                    {
                                        <text>Cover art not matched to a song</text>
                                    }
                                </strong>
                                @if (HeldCoverArt != null)
                                {
                                    <SfButton CssClass="e-small e-outline" OnClick="ReleaseCoverArt">Cancel</SfButton>
                                }
                            </div>

                            @if (_unmatchedCoverArtFiles.Any())
                            {
                                <div class="cover-art-chips">
                                    @foreach (var file in _unmatchedCoverArtFiles)
                                    {
                                        var isHeld = string.Equals(file, HeldCoverArt, StringComparison.OrdinalIgnoreCase);
                                        @* Keyed by filename. The src on these is set from JS, which
                                           Blazor knows nothing about - so without a key it would
                                           reuse one image's element for another as the list changes
                                           and carry the previous thumbnail across with it. *@
                                        <div @key="file"
                                             class="cover-art-chip @(isHeld ? "cover-art-chip-held" : "")"
                                             draggable="true"
                                             role="button"
                                             tabindex="0"
                                             aria-pressed="@isHeld"
                                             aria-label="@($"Cover art {file}. Select it, then choose a song.")"
                                             @ondragstart="@(() => HoldCoverArt(file))"
                                             @ondragend="ReleaseCoverArt"
                                             @onclick="@(() => HoldCoverArt(file))">
                                            <img id="@PreviewElementId(file)" alt="" class="cover-art-thumb" />
                                            <div class="cover-art-chip-name" title="@file">@file</div>
                                            <small class="text-muted">@FormatFileSize(CoverArtSizeOf(file))</small>
                                        </div>
                                    }
                                </div>
                                @* Wording from a creator who could not work out where to drop.
                                   Names the column, names the gesture for both mouse and touch, and
                                   tells them what to look for - the box only appears as a target,
                                   so "look for the dashed box" is the reliable landmark.
                                   Named by shape rather than colour: the green had no token behind
                                   it, and a creator who cannot separate green from grey was left
                                   without the one instruction that mattered. *@
                                <small class="text-muted d-block mt-2">
                                    Drag one image onto a song row in the <strong>Cover Art</strong> column,
                                    or tap the image and then tap the song row's Cover Art column.
                                    Look for the <span class="cover-art-hint-swatch">dashed box</span>
                                    on the song row — that is where you tap or drop.
                                </small>
                            }
                        </div>
                    }
                }
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Song Title</th>
                                @if (_awaitingTitleConfirmation)
                                {
                                    <th>Genre</th>
                                    <th>Artist persona</th>
                                    <th>AI disclosure</th>
                                }
                                else
                                {
                                    <th>Audio File</th>
                                }
                                <th>Cover Art</th>
                                <th>Status</th>
                                @if (!_awaitingTitleConfirmation)
                                {
                                    <th>Progress</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _uploadItems)
                            {
                                <tr class="@(item.TitleError != null ? "table-warning" : "")">
                                    <td style="min-width: 18rem;" data-label="Song title">
                                        @if (_awaitingTitleConfirmation)
                                        {
                                            @* Every title arrives pre-filled from its filename, so a
                                               required field would catch nothing - "track 03 final FINAL"
                                               passes every rule there is. What catches it is having to
                                               confirm, and typing here counts as confirming. *@
                                            <SfTextBox Value="@item.SongTitle"
                                                       ValueChanged="@((string v) => OnTitleChanged(item, v))"
                                                       ValueExpression="@(() => item.SongTitle)"
                                                       MaxLength="200"
                                                       Placeholder="Song title"
                                                       aria-label="@($"Song title for {item.AudioFileName}")" />
                                            @if (item.TitleError != null)
                                            {
                                                <small class="text-danger d-block mt-1">@item.TitleError</small>
                                            }
                                            <div class="title-check">
                                                <SfCheckBox TChecked="bool" Label="Looks right"
                                                            Checked="@item.TitleConfirmed"
                                                            ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => ConfirmTitle(item, a.Checked))" />
                                                <small class="@(!item.TitleConfirmed && TitleLooksLikeAFileName(item.SongTitle) ? "title-source-warn" : "text-muted")">
                                                    @if (!item.TitleConfirmed && TitleLooksLikeAFileName(item.SongTitle))
                                                    {
                                                        <text>Taken from <strong>@item.TitleSourceFileName</strong>. Listeners see this exactly as written.</text>
                                                    }
                                                    else
                                                    {
                                                        <text>From @item.TitleSourceFileName</text>
                                                    }
                                                </small>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.SongTitle
                                        }
                                    </td>
                                    @if (_awaitingTitleConfirmation)
                                    {
                                        <td style="min-width: 12rem;" data-label="Genre">
                                            @* Genre is REQUIRED for a song to publish, and until now it
                                               could only be set on /creator/songs, after publishing. *@
                                            <select class="form-select review-select @(item.GenreError != null ? "is-invalid" : "")"
                                                    @onchange="@(e => SetRowGenre(item, e.Value?.ToString()))"
                                                    aria-label="@($"Genre for {item.SongTitle}")">
                                                <option value="" selected="@string.IsNullOrEmpty(item.Genre)">Choose a genre</option>
                                                @foreach (var genre in _genres)
                                                {
                                                    <option value="@genre.Name" selected="@(string.Equals(genre.Name, item.Genre, StringComparison.OrdinalIgnoreCase))">@genre.Name</option>
                                                }
                                            </select>
                                            @if (item.GenreError != null)
                                            {
                                                <small class="text-danger d-block mt-1">@item.GenreError</small>
                                            }
                                            @* A textbox, not a page: leaving /upload-files drops the live
                                               FileList and with it the whole batch. *@
                                            @if (_showAddGenre && _addGenreForRow == item)
                                            {
                                                <div class="inline-create">
                                                    <SfTextBox @bind-Value="_newGenreName" MaxLength="50" Placeholder="New genre name" />
                                                    <div class="inline-create-actions">
                                                        <SfButton CssClass="e-small cta-secondary hero-secondary-cta" Content="@(_addingGenre ? "Adding..." : "Add")" Disabled="@_addingGenre" OnClick="ConfirmAddGenreAsync" />
                                                        <SfButton CssClass="e-small e-outline" Content="Cancel" OnClick="CancelAddGenre" />
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(_addGenreError))
                                                    {
                                                        <small class="text-danger d-block mt-1">@_addGenreError</small>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="inline-create-link" @onclick="@(() => BeginAddGenre(item))">+ New genre</button>
                                            }
                                        </td>
                                        <td style="min-width: 13rem;" data-label="Artist persona">
                                            @* Never required. Most creators have none, so no persona is a
                                               first-class choice and the row says which name gets used. *@
                                            <select class="form-select review-select"
                                                    @onchange="@(e => item.PersonaId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()))"
                                                    aria-label="@($"Artist persona for {item.SongTitle}")">
                                                <option value="" selected="@(item.PersonaId == null)">No persona</option>
                                                @foreach (var persona in _personas)
                                                {
                                                    <option value="@persona.Id" selected="@(item.PersonaId == persona.Id)">@persona.Name</option>
                                                }
                                            </select>
                                            <small class="text-muted d-block mt-1">Will show as <strong>@ArtistNameFor(item)</strong></small>
                                            @if (_showAddPersona && _addPersonaForRow == item)
                                            {
                                                <div class="inline-create">
                                                    <SfTextBox @bind-Value="_newPersonaName" MaxLength="100" Placeholder="Artist or band name" />
                                                    <div class="inline-create-actions">
                                                        <SfButton CssClass="e-small cta-secondary hero-secondary-cta" Content="@(_addingPersona ? "Adding..." : "Add")" Disabled="@_addingPersona" OnClick="ConfirmAddPersonaAsync" />
                                                        <SfButton CssClass="e-small e-outline" Content="Cancel" OnClick="CancelAddPersona" />
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(_addPersonaError))
                                                    {
                                                        <small class="text-danger d-block mt-1">@_addPersonaError</small>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="inline-create-link" @onclick="@(() => BeginAddPersona(item))">+ New persona</button>
                                            }
                                        </td>
                                        <td style="min-width: 12rem;" data-label="AI disclosure">
                                            @* Two groups that exclude each other, and one of them has to
                                               be answered. As three optional boxes, all-unticked meant
                                               both "none of this is AI" and "nobody answered" - and only
                                               one of those is a disclosure. *@
                                            <div class="ai-declare @(item.AiError != null ? "ai-declare-invalid" : "")">
                                                <SfCheckBox TChecked="bool" Label="All original"
                                                            Checked="@item.AllOriginal"
                                                            ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => SetAllOriginal(item, a.Checked))" />

                                                <span class="ai-declare-or">or say which parts are AI</span>

                                                <div class="ai-flags">
                                                    <SfCheckBox TChecked="bool" Label="AI music"
                                                                Checked="@item.IsAiGenerated"
                                                                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => SetAiMusic(item, a.Checked))" />
                                                    <SfCheckBox TChecked="bool" Label="AI vocals"
                                                                Checked="@item.IsAiVocals"
                                                                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => SetAiVocals(item, a.Checked))" />
                                                    <SfCheckBox TChecked="bool" Label="AI lyrics"
                                                                Checked="@item.IsAiLyrics"
                                                                ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> a) => SetAiLyrics(item, a.Checked))" />
                                                </div>
                                            </div>
                                            @if (item.AiError != null)
                                            {
                                                <small class="text-danger d-block mt-1">@item.AiError</small>
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            @item.AudioFileName
                                            <br />

                                            <small class="text-muted">@FormatFileSize(item.AudioFileSize)</small>
                                        </td>
                                    }
                                    @* During review this cell is both a drop target and a drag source,
                                       so a wrong pairing can be corrected in one gesture rather than
                                       cleared and re-made. Once uploading starts it goes back to
                                       being a plain read-only label. *@
                                    <td style="min-width: 14rem;" data-label="Cover art"
                                        class="@(_awaitingTitleConfirmation && HeldCoverArt != null ? "cover-art-target" : "")"
                                        @ondragover:preventDefault="@_awaitingTitleConfirmation"
                                        @ondrop="@(() => AssignHeldCoverArt(item))"
                                        @onclick="@(() => AssignHeldCoverArt(item))">
                                        @if (item.HasCoverArt)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                @if (_awaitingTitleConfirmation)
                                                {
                                                    @* Tap picks it up as well as drag, so artwork can
                                                       be moved between songs on a touch screen where
                                                       there is no drag event at all. stopPropagation
                                                       keeps the tap off the cell's own drop handler,
                                                       which would put it straight back. *@
                                                    <img @key="item.CoverArtFileName"
                                                         id="@PreviewElementId(item.CoverArtFileName)"
                                                         alt="@($"Cover art {item.CoverArtFileName}")"
                                                         title="Drag or tap to move this artwork"
                                                         class="cover-art-thumb cover-art-thumb-row @(string.Equals(item.CoverArtFileName, HeldCoverArt, StringComparison.OrdinalIgnoreCase) ? "cover-art-chip-held" : "")"
                                                         draggable="true"
                                                         @ondragstart="@(() => HoldCoverArt(item.CoverArtFileName))"
                                                         @ondragend="ReleaseCoverArt"
                                                         @onclick="@(() => HoldCoverArt(item.CoverArtFileName))"
                                                         @onclick:stopPropagation="true" />
                                                }
                                                <div class="flex-grow-1 text-break">
                                                    @item.CoverArtFileName
                                                    <br />
                                                    <small class="text-muted">@FormatFileSize(item.CoverArtFileSize)</small>
                                                </div>
                                                @if (_awaitingTitleConfirmation)
                                                {
                                                    @* Labelled, not a bare glyph. An icon-only
                                                       SfButton rendered as nothing visible - there is
                                                       no icon-only precedent anywhere in this app -
                                                       and a creator who could not find the drop target
                                                       was never going to find an unlabelled x either.

                                                       It says what it removes. When it just said
                                                       "Remove", a creator trying to drop one song from
                                                       the batch pressed it and lost the artwork. *@
                                                    <span @onclick:stopPropagation="true">
                                                        <SfButton CssClass="e-small e-outline cover-art-remove"
                                                                  Content="Remove art"
                                                                  aria-label="@($"Remove cover art from {item.SongTitle}")"
                                                                  OnClick="@(() => ClearCoverArt(item))" />
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else if (_awaitingTitleConfirmation)
                                        {
                                            @* An actual box with a label in it, not a line of grey
                                               text. A creator looking for "where do I drop this"
                                               needs a target they can see from across the table. *@
                                            <div class="cover-art-dropzone">
                                                <svg class="inline-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3 3.5-4.5 4.5 6H5l3.5-4.5z"/></svg>
                                                <span>
                                                    @if (HeldCoverArt != null)
                                                    {
                                                        <text>Tap or Drop @HeldCoverArt Here</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Tap or Drop Cover Art Here</text>
                                                    }
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>No cover art (will use default animation)</em></span>
                                        }
                                    </td>
                                    <td>
                                        @* "Pending" reads as queued - as though the batch were
                                           already moving and this row's turn had not come. Nothing
                                           is moving; it is waiting to be sent. *@
                                        @if (_awaitingTitleConfirmation)
                                        {
                                            <span class="badge bg-secondary">Not uploaded</span>

                                            @* The way out for one song rather than the whole batch.
                                               A duplicate title is the case that needs it: without
                                               this, finding one song already in your catalogue means
                                               renaming a song you did not want to rename, or
                                               cancelling the two that were fine. *@
                                            <div class="row-remove">
                                                <SfButton CssClass="e-small e-outline"
                                                          Content="Don't upload this"
                                                          aria-label="@($"Remove {item.SongTitle} from this batch")"
                                                          OnClick="@(() => RemoveFromBatchAsync(item))" />
                                            </div>
                                        }
                                        else if (item.Status == UploadStatus.Uploading || item.Status == UploadStatus.Processing)
                                        {
                                            <span class="badge bg-info">@item.StatusMessage</span>
                                        }
                                        else if (item.Status == UploadStatus.Completed)
                                        {
                                            <span class="badge bg-success">@item.StatusMessage</span>
                                        }
                                        else if (item.Status == UploadStatus.Failed)
                                        {
                                            <span class="badge bg-danger">@item.StatusMessage</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.StatusMessage</span>
                                        }
                                    </td>
                                    @if (!_awaitingTitleConfirmation)
                                    {
                                    @* One bar for the whole lifecycle: the browser-to-Azure upload,
                                       then transcoding in the Azure Function, then assembly here.
                                       It is never hidden and never runs backwards, so a creator can
                                       see exactly where each song is. *@
                                    <td style="width: 30%;">
                                        <div class="progress">
                                            <div class="progress-bar @GetProgressBarClass(item.Status)"
                                                 role="progressbar"
                                                 style="width: @(item.Progress)%"
                                                 aria-valuenow="@item.Progress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"
                                                 aria-label="@($"{item.SongTitle}: {item.StatusMessage}")">
                                                @item.Progress%
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.ErrorMessage))
                                        {
                                            <small class="text-danger">@item.ErrorMessage</small>
                                        }
                                    </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_awaitingTitleConfirmation)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <SfButton CssClass="cta-primary e-large" OnClick="StartUploadAsync">
                            @UploadButtonLabel
                        </SfButton>
                        <SfButton CssClass="e-outline" OnClick="CancelPendingBatchAsync">Cancel</SfButton>
                        @if (!ReviewIsComplete)
                        {
                            <span class="review-outstanding">@ReviewOutstandingMessage</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Only after the review step. While reviewing, these same files are the live pool above,
           where the creator can still place them - listing them again as leftovers would contradict
           the thing they are being asked to act on. *@
        @if (!_awaitingTitleConfirmation && _unmatchedCoverArtFiles.Any())
        {
            <div class="row mt-3">
                <div class="col-12">
                    @* "were not uploaded" was true when every file reached the server first. On the
                       direct path the browser has already sent these to storage by the time pairing
                       runs, and they are discarded afterwards - so the old wording described the
                       wrong step and contradicted the progress bar the creator just watched. *@
                    <p class="text-muted"><strong>These cover art files were left unused, so no song is using them:</strong></p>
                    <ul class="text-muted">
                        @foreach (var file in _unmatchedCoverArtFiles)
                        {
                            <li>@file</li>
                        }
                    </ul>
                </div>
            </div>
        }
    }

    @if (_skippedFiles.Any())
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-warning" role="alert">
                    <strong>Skipped files:</strong> These files were not one of the supported audio or cover art formats, so they were left out of this batch.
                    <ul class="mb-0 mt-2">
                        @foreach (var file in _skippedFiles)
                        {
                            <li>@file</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    @if (_duplicateSongFiles.Any())
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-warning" role="alert">
                    <strong>Duplicate songs detected:</strong> The following files were not uploaded because a song with the same title already exists. Please give them different titles if you intended to upload different songs.
                    <ul class="mb-0 mt-2">
                        @foreach (var file in _duplicateSongFiles)
                        {
                            <li>@file</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>
<script suppress-error="BL9992">
    (function () {
        // These two listeners exist to stop the browser navigating away when a creator drops a file
        // outside the upload box. They are on `document` in the bubble phase, so they run LAST and
        // whatever they set wins.
        //
        // Which made them silently veto the cover-art re-pairing drags: dropEffect was forced to
        // 'none' for anything outside .upload-box, so dragging a thumbnail onto a song showed the
        // not-allowed cursor and refused the drop - and dropping it on the upload box instead was
        // read as a brand-new file selection, discarding the whole reviewed batch.
        //
        // Both now ignore drags that started inside the page. Only a drag carrying files from the
        // operating system is the browser-navigation hazard these were written for.
        function isExternalFileDrag(e) {
            if (window._streamTunesInternalDrag) {
                return false;
            }

            var types = e.dataTransfer && e.dataTransfer.types;
            return !!types && Array.prototype.indexOf.call(types, 'Files') !== -1;
        }

        // Belt and braces alongside the types check. Dragging an <img> gives text/html and
        // text/uri-list rather than Files, so the check above is already correct - but this is the
        // signal we control, and a browser quirk in the one we do not would break re-pairing again.
        document.addEventListener('dragstart', function (e) {
            var handle = e.target && e.target.closest
                ? e.target.closest('.cover-art-chip, .cover-art-thumb-row')
                : null;
            window._streamTunesInternalDrag = !!handle;
        }, true);

        function endInternalDrag() {
            window._streamTunesInternalDrag = false;
        }

        document.addEventListener('dragend', endInternalDrag, true);

        // Deferred, not immediate. Both this and the real drop handler below are document-level
        // bubble listeners, and this one was registered first - clearing the flag inline would clear
        // it before the handler that needs to read it. The drop cleanup is only a backstop for the
        // case where dragend never fires; letting the flag stick would block real file drops.
        document.addEventListener('drop', function () {
            window.setTimeout(endInternalDrag, 0);
        });

        // Handle dragover: allow drops inside the upload box, prevent everywhere else
        document.addEventListener('dragover', function (e) {
            if (!isExternalFileDrag(e)) {
                // Someone else's drag. Leaving it entirely alone is what lets Blazor's own
                // dragover handlers on the re-pairing targets decide whether a drop is allowed.
                return;
            }

            var uploadBox = e.target.closest('.upload-box');
            if (uploadBox) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
            } else {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'none';
            }
        });

        function getFileSignature(fileList) {
            var parts = [];
            for (var i = 0; i < fileList.length; i++) {
                var file = fileList[i];
                parts.push(file.name + ':' + file.size + ':' + file.lastModified);
            }
            return parts.join('|');
        }

        function ensureDropChangeGuard(input) {
            if (input._streamTunesDropChangeGuard) {
                return input._streamTunesDropChangeGuard;
            }

            var guard = {
                signature: null,
                delivered: false,
                suppressUntil: 0
            };

            input._streamTunesDropChangeGuard = guard;
            input.addEventListener('change', function (e) {
                if (!guard.signature) {
                    return;
                }

                if (Date.now() > guard.suppressUntil) {
                    guard.signature = null;
                    guard.delivered = false;
                    return;
                }

                if (getFileSignature(input.files) !== guard.signature) {
                    return;
                }

                if (guard.delivered) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return;
                }

                guard.delivered = true;
            }, true);

            return guard;
        }

        // Handle drop: forward files to the hidden InputFile inside the upload box.
        // Some browsers can fire a native change event after we dispatch the synthetic
        // one. Blazor treats the second event as a new file list and invalidates the
        // first event's IBrowserFile references, so the guard below lets only one
        // change event for this exact dropped file set reach Blazor.
        document.addEventListener('drop', function (e) {
            if (!isExternalFileDrag(e)) {
                // A re-pairing drag. Forwarding it to the file input would read the creator's own
                // artwork back as a new selection and discard the batch they were reviewing.
                return;
            }

            var uploadBox = e.target.closest('.upload-box');
            if (uploadBox && !uploadBox.classList.contains('upload-box-disabled')) {
                e.preventDefault();
                var input = uploadBox.querySelector('input[type="file"]');
                if (input && e.dataTransfer.files.length > 0) {
                    // Copy files into a fresh DataTransfer so references stay valid
                    // after the drop event's DataTransfer is cleaned up.
                    var dt = new DataTransfer();
                    for (var i = 0; i < e.dataTransfer.files.length; i++) {
                        dt.items.add(e.dataTransfer.files[i]);
                    }

                    var signature = getFileSignature(dt.files);
                    var guard = ensureDropChangeGuard(input);
                    guard.signature = signature;
                    guard.delivered = false;
                    guard.suppressUntil = Date.now() + 1000;

                    input.files = dt.files;

                    window.setTimeout(function () {
                        if (guard.signature === signature && !guard.delivered) {
                            input.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    }, 25);
                }
            } else {
                e.preventDefault();
            }
        });
    })();

    window.triggerClick = function (element) {
        element.click();
    };

    // Warn user before closing tab/browser during uploads
    window.uploadFilesHelper = {
        enableBeforeUnload: function () {
            if (window._uploadBeforeUnloadHandler) {
                return;
            }

            window._uploadBeforeUnloadHandler = function (e) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            };
            window.addEventListener('beforeunload', window._uploadBeforeUnloadHandler);
        },
        disableBeforeUnload: function () {
            if (window._uploadBeforeUnloadHandler) {
                window.removeEventListener('beforeunload', window._uploadBeforeUnloadHandler);
                window._uploadBeforeUnloadHandler = null;
            }
        },

        // Thumbnails for the review step, drawn from the copy the browser already has.
        //
        // Not fetched from storage, which would need a read SAS - and the upload tokens are
        // deliberately Create|Write only, so a leaked one cannot even read back what it wrote. This
        // needs no token, no request and no server round trip: the file is sitting in the input's
        // FileList, which is where the upload reads it from too.
        //
        // Object URLs pin their blob in memory until revoked, so every one handed out is tracked and
        // released before the next batch.
        // Idempotent and self-healing, and it has to be both.
        //
        // .NET cannot tell whether a given <img> currently holds the right src - re-pairing destroys
        // one element and creates another, and a re-render can replace one that was already correct.
        // Deciding up there whether a refresh is "needed" got this wrong twice: thumbnails vanished
        // on re-pairing, then vanished on first render. So the decision lives here, where the DOM can
        // actually be looked at, and .NET simply calls on every render.
        //
        // Cheap because the check is a string compare per image. A URL is only created when an
        // element does not already carry the right one, so nothing churns while a creator types.
        showCoverArtPreviews: function (pairs) {
            var input = document.querySelector('input[type=file].direct-upload-input');
            var files = input ? input.files : null;
            if (!files) {
                return;
            }

            var held = window._coverArtPreviewUrls || {};
            var next = {};

            (pairs || []).forEach(function (pair) {
                var element = document.getElementById(pair.elementId);
                var file = files[pair.browserIndex];
                if (!element || !file) {
                    return;
                }

                // Reuse the URL already minted for this image, wherever it has moved to. Creating a
                // second one for the same blob would pin it in memory twice.
                var url = held[pair.elementId] || URL.createObjectURL(file);
                next[pair.elementId] = url;

                if (element.src !== url) {
                    element.src = url;
                }
            });

            // Anything no longer on screen - an image whose row went away - is released here rather
            // than accumulating until the batch ends.
            Object.keys(held).forEach(function (key) {
                if (!next[key]) {
                    try { URL.revokeObjectURL(held[key]); } catch { /* already gone */ }
                }
            });

            window._coverArtPreviewUrls = next;
        },

        // Upload preferences live in the browser rather than the database - they are habits, not
        // account settings, and this way they cost no schema change and no round trip. Wrapped in
        // try/catch because localStorage throws outright in private-browsing modes and when a site
        // is blocked from storing data, and a preference is never worth failing a page over.
        readPreference: function (key) {
            try {
                return window.localStorage.getItem(key);
            } catch {
                return null;
            }
        },

        writePreference: function (key, value) {
            try {
                window.localStorage.setItem(key, value);
            } catch { /* storage unavailable; the default applies next visit */ }
        },

        revokeCoverArtPreviews: function () {
            var held = window._coverArtPreviewUrls || {};
            Object.keys(held).forEach(function (key) {
                try { URL.revokeObjectURL(held[key]); } catch { /* already gone */ }
            });
            window._coverArtPreviewUrls = {};
        }
    };
</script>
