@page "/creator/songs/{SongId:int}/lyrics"
@rendermode InteractiveServer
@inherits LyricsTimingEditorModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Contracts
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Components.Shared
@attribute [Authorize(Policy = Permissions.ManageOwnSongs)]

<PageTitle>Preview results</PageTitle>

@if (_loading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
        <p class="mt-2">Loading your lyrics…</p>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
    <a class="btn btn-secondary" href="@AppPageRoutes.CreatorSongs">Back to my songs</a>
}
else
{
    <div class="lyrics-editor">

        <div class="lyrics-editor-header">
            <div>
                <h3 class="mb-1">@_songTitle</h3>
                <span class="text-muted">Preview results</span>
            </div>
            <a class="btn btn-outline-secondary btn-sm" href="@AppPageRoutes.CreatorSongs">Back to my songs</a>
        </div>

        @* The advisory banner. Score-independent: it used to grade its own copy by the aligner's
           confidence against an admin threshold, which told creators with perfectly good timings to
           "expect to do some tapping" because the score reads low even when the alignment is spot
           on. What is left says the one thing that is always true and always actionable. *@
        <div class="alert @_bannerClass" role="status">
            @_bannerMessage
        </div>

        @* The overview only. The two ways of actually fixing something now carry their own
           instructions, inside the panel that offers them - a creator reading about tapping wants
           the Tap button in front of them, not four screens away at the top of the page. *@
        <p class="lyrics-editor-intro">
            We've made a first guess at when every word is sung. It's usually close, but almost never
            perfect. <strong>Nothing here is visible to listeners until you press Publish.</strong>
            Play it through first &mdash; if the words light up at the right moments, you're done.
            If not, there are two ways to fix it, and each one explains itself on the right.
        </p>

        @* THE TRANSPORT IS FULL WIDTH, and that is a functional decision rather than a cosmetic one.
           It used to sit in the 320px side column, which gave a four-minute song about three quarters
           of a second per pixel - so "click just before that line" could not land within a second of
           anywhere, and the one control this page is built around was the least precise thing on it.
           Sticky, because tapping means scrolling the words while keeping play and seek reachable. *@
        <div class="lyrics-editor-transport">

            @* Deliberately the card player's controls rather than the big player bar: this is one
               song, and previous/next would mean nothing here. No preview restriction either -
               it is the creator's own song. *@
            <audio @ref="_audioElement" src="@_streamUrl" preload="auto" class="card-audio-hidden"></audio>

            <div class="card-mini-player">
                <div class="card-mini-controls-row">
                    <div class="card-mini-controls">
                        <button type="button" class="e-btn" @onclick="TogglePlay" title="@(_isPlaying ? "Pause" : "Play")">
                            @if (_isPlaying)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="control-icon"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="control-icon"><path d="M8 5v14l11-7z" /></svg>
                            }
                        </button>
                        <button type="button" class="e-btn" @onclick="StopPlayback" title="Stop">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="control-icon"><path d="M6 6h12v12H6z" /></svg>
                        </button>
                    </div>

                    <div class="card-volume-controls">
                        <button type="button" class="card-volume-button" @onclick="ToggleMute" title="@(_isMuted ? "Unmute" : "Mute")">
                            @if (_isMuted || _volume == 0)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="card-volume-icon"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="card-volume-icon"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" /></svg>
                            }
                        </button>
                        <div @ref="_volumeBarContainer" class="card-volume-bar-container" @onclick="OnVolumeBarClick">
                            <div class="card-volume-bar" style="width: @(GetDisplayVolume() * 100)%;">
                                <div class="card-volume-thumb"></div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Seekable, and that is the most important control on this page. Tapping a chorus
                   means replaying the same eight bars over and over; without a seek the creator
                   waits through the whole song for each attempt.

                   The elapsed time reads in hundredths and the duration does not: one is a position
                   being aimed at, the other is a fact about the file. *@
                <div class="card-progress-container">
                    <span class="card-time-display">@FormatTimePrecise(_currentTime)</span>
                    <div @ref="_progressBarContainer" class="card-progress-bar-container" @onclick="OnProgressBarClick">
                        <div class="card-progress-bar" style="width: @(GetProgressPercent())%;">
                            <div class="card-progress-thumb"></div>
                        </div>
                    </div>
                    <span class="card-time-display">@FormatTime(_duration)</span>
                </div>

                @* Deliberately the same steps, in the same outward-reading order, as the per-word
                   Starts/Ends controls in the panel below: coarse, fine, finer, value, finer, fine,
                   coarse. Somebody who has learned one has learned the other, and a hundredth here is
                   what makes "play from exactly the moment that word should land" reachable at all -
                   no seek bar, at any width, resolves 10 ms. *@
                <div class="lyrics-editor-seek">
                    <span class="text-muted me-2">Seek</span>
                    @foreach (var step in SeekStepsMs)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="@FormatStep(step) seconds earlier"
                                @onclick="() => SeekByAsync(-step)">
                            −@FormatStep(step)
                        </button>
                    }
                    @for (var i = SeekStepsMs.Length - 1; i >= 0; i--)
                    {
                        var step = SeekStepsMs[i];
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="@FormatStep(step) seconds later"
                                @onclick="() => SeekByAsync(step)">
                            +@FormatStep(step)
                        </button>
                    }
                </div>

                @* Slowing down makes tapping dramatically easier, and the timings stay correct at
                   normal speed because they are recorded against the audio clock. A quarter speed is
                   worth having for a fast, densely-worded line, where half is still too quick to
                   hear where one word ends and the next begins. *@
                <div class="lyrics-editor-rates">
                    <span class="text-muted me-2">Speed</span>
                    @foreach (var rate in PlaybackRates)
                    {
                        <button type="button"
                                class="btn btn-sm @(_playbackRate == rate ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SetPlaybackRate(rate)">
                            @rate.ToString("0.##")×
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="lyrics-editor-body">

            <div class="lyrics-editor-scroller">
                <LyricsScroller @ref="_scroller"
                                AudioElement="_audioElement"
                                Mode="LyricsScrollerMode.Editor"
                                Document="_document"
                                OnWordSelected="OnWordSelected"
                                OnSelectionCleared="ClearSelectionAsync"
                                EmptyMessage="There are no timings for this song yet." />
            </div>

            <div class="lyrics-editor-side">

                @* OPTION 1 OF TWO, and named as such. The two ways of fixing a timing fix different
                   things - this one re-places whole lines by ear, the other adjusts one word or row
                   by the hundredth - and a creator who does not know there are two will use whichever
                   they found first on a problem it cannot solve. *@
                <div class="lyrics-editor-record @(_isRecording ? "is-recording" : "")">
                    <h5 class="lyrics-editor-panel-title">Tap to Fix</h5>

                    @* Collapsed by default. These are three paragraphs a creator needs once and then
                       never again, and left open they push the controls of BOTH options off the
                       screen on the laptop this is most often used on. *@
                    <details class="lyrics-editor-help">
                        <summary>Tap to Fix Instructions</summary>
                        <div class="lyrics-editor-help-body">
                            <p>
                                Best for a section that has drifted as a whole &mdash; a chorus that
                                comes in late, or everything after a long instrumental.
                            </p>
                            <ol>
                                <li>
                                    Move the song to just before the part that's wrong, then press
                                    <strong>Start tapping</strong>. The song plays from where you are.
                                </li>
                                <li>
                                    Each time you hear a new line begin, press the
                                    <strong>space bar</strong> &mdash; or the <em>Tap</em> button,
                                    which is the same control. That line moves to the moment you
                                    pressed, and the words inside it spread out to match.
                                </li>
                                <li>
                                    The box shows which line your next press belongs to, and it
                                    <strong>waits for you</strong> rather than following the song. You
                                    don't have to do the whole song &mdash; just the part that's wrong.
                                </li>
                            </ol>
                            <p class="mb-0">
                                <strong>Rows can't overlap.</strong> Each tap ends the previous line
                                where the new one begins, so tapping can never leave two rows lighting
                                up at once.
                            </p>
                            <p class="mb-0 mt-2">
                                <em>Tip: slow the song to 0.5&times; or 0.25&times; while you tap.
                                It's much easier to hit the right moment, and the timings stay correct
                                at normal speed.</em>
                            </p>
                        </div>
                    </details>

                    @if (!_isRecording)
                    {
                        <button type="button" class="btn btn-danger btn-sm" @onclick="StartRecording">
                            ● Start tapping
                        </button>
                        <p class="text-muted mt-2 mb-0">
                            Plays from where you are now. Each time you hear a new line begin, press
                            the <strong>space bar</strong> &mdash; or the <em>Tap</em> button, which
                            is the same control. You only need to do the part that's wrong.
                        </p>
                    }
                    else
                    {
                        @* "Press space when you hear" rather than "Next line": the passive label
                           named the thing without ever saying what to do with it, which is most of
                           why this control did not explain itself. *@
                        <div class="lyrics-editor-next-line">
                            <span class="text-muted">Press space when you hear</span>
                            <strong>@NextLineToTap</strong>
                        </div>

                        @* REPEATED HERE, because the copy above it is only rendered while NOT
                           recording - so the one instruction a creator needs disappeared at the
                           exact moment they started needing it, leaving a box that names a line and
                           never changes. The last sentence is the one that was missing: this
                           follows the creator, not the song. *@
                        <p class="text-muted small mt-2 mb-0">
                            It waits for you &mdash; it does not follow the song on its own. Each
                            press moves that line to the moment you pressed, then shows you the next
                            one.
                        </p>

                        @* The same action as the space bar, for touch - and for anybody who would
                           rather press a button than trust a keyboard shortcut.

                           NO @onclick, deliberately. A Blazor click handler would capture the moment
                           on the SERVER, a round trip after the press, making this button measurably
                           worse than the space bar at the one thing it exists to do. JS picks it up
                           by the data attribute and reads the audio clock in the click handler
                           itself, exactly as it does for the key. *@
                        @* Names the space bar on the button itself. The two being the same control
                           was stated nowhere, so a creator reading "Tap" here and "space bar" in the
                           copy above had every reason to think they were two different things. *@
                        <button type="button" class="btn btn-danger btn-lg w-100 mt-2" data-tap-now>
                            Tap <span class="lyrics-editor-tap-alt">or press space</span>
                        </button>

                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="StopRecording">
                            Stop tapping (Esc)
                        </button>
                    }
                </div>

                @* OPTION 2 OF TWO. Where tapping re-places whole lines by ear, this is the precise
                   one: it reaches a single word, at a hundredth of a second, which no amount of
                   tapping can do. *@
                <div class="lyrics-editor-selection">
                    <h5 class="lyrics-editor-panel-title">Click Word / Row to Fix</h5>

                    <details class="lyrics-editor-help">
                        <summary>Click Word / Row Instructions</summary>
                        <div class="lyrics-editor-help-body">
                            <p>
                                Best when the timing is nearly right &mdash; one word arriving a beat
                                early, or a word that flashes past before you can read it.
                            </p>
                            <ol>
                                <li>
                                    <strong>Click the word</strong> in the lyrics on the left. Its
                                    name, its start and its end appear here.
                                </li>
                                <li>
                                    <strong>To move it without changing its length</strong>, use
                                    <em>&larr; Earlier</em> and <em>Later &rarr;</em>, or the left and
                                    right arrow keys. Each press moves it a twentieth of a second.
                                </li>
                                <li>
                                    <strong>To change how long it is sung for</strong>, set
                                    <em>Starts</em> and <em>Ends</em> separately, in steps of 1, 0.1
                                    or 0.01 seconds. <em>Sung for</em> underneath shows what you've
                                    given it &mdash; anything near 0.05s will be gone before you see it.
                                </li>
                                <li>
                                    <strong>To move the whole row</strong>, use <em>Shift whole line
                                    earlier</em> or <em>later</em>. Every word in it moves together,
                                    keeping the spacing you can hear.
                                </li>
                                <li>
                                    Press <strong>Esc</strong> when you've finished with that word, or
                                    click the &times; above.
                                </li>
                            </ol>
                            <p class="mb-0">
                                <strong>A word can't be turned inside out.</strong> Dragging its start
                                past its end just makes it zero-length; it never runs backwards.
                            </p>
                            <p class="mb-0 mt-2">
                                <strong>Rows can't overlap in what you publish.</strong> Two words in
                                the same row are allowed to overlap while you work &mdash; that's what
                                makes the hundredth-second steps useful &mdash; but if your edits leave
                                one row starting before the row above it has finished, Publish will
                                refuse and name the two rows, so you can't release a version where the
                                highlight jumps backwards.
                            </p>
                        </div>
                    </details>

                    @if (_selected is null)
                    {
                        <p class="text-muted mb-0">Click a word to adjust exactly when it is sung.</p>
                    }
                    else
                    {
                        <div class="lyrics-editor-selected-word">
                            <strong>@_selectedText</strong>
                            <button type="button"
                                    class="btn-close btn-close-sm float-end"
                                    aria-label="Stop editing this word"
                                    title="Stop editing this word (Esc)"
                                    @onclick="ClearSelectionAsync"></button>
                        </div>

                        @* Start and end MOVED SEPARATELY, which the arrow keys and the Earlier/Later
                           buttons cannot do - those slide the word and keep its length, so a word the
                           aligner squeezed into a few hundredths stays that width wherever it is put.
                           10 ms a press, because the case this is for is smaller than one press of
                           the ordinary 50 ms nudge. *@
                        <div class="lyrics-editor-span">
                            <div class="lyrics-editor-span-row">
                                <span class="lyrics-editor-span-label">Starts</span>
                                <span class="lyrics-editor-span-value">@FormatPrecise(_selectedStartMs)</span>
                            </div>
                            <div class="lyrics-editor-span-steps">
                                @foreach (var step in EdgeStepsMs)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            title="@FormatStep(step) seconds earlier"
                                            @onclick="() => AdjustSelectedEdge(LyricsWordEdge.Start, -step)">
                                        −@FormatStep(step)
                                    </button>
                                }
                                @* Reversed by index rather than with LINQ, so the steps stay defined
                                   in exactly one place and read outwards from the value in the
                                   middle: coarse, fine, value, fine, coarse. *@
                                @for (var i = EdgeStepsMs.Length - 1; i >= 0; i--)
                                {
                                    var step = EdgeStepsMs[i];
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            title="@FormatStep(step) seconds later"
                                            @onclick="() => AdjustSelectedEdge(LyricsWordEdge.Start, step)">
                                        +@FormatStep(step)
                                    </button>
                                }
                            </div>

                            <div class="lyrics-editor-span-row">
                                <span class="lyrics-editor-span-label">Ends</span>
                                <span class="lyrics-editor-span-value">@FormatPrecise(_selectedEndMs)</span>
                            </div>
                            <div class="lyrics-editor-span-steps">
                                @foreach (var step in EdgeStepsMs)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            title="@FormatStep(step) seconds earlier"
                                            @onclick="() => AdjustSelectedEdge(LyricsWordEdge.End, -step)">
                                        −@FormatStep(step)
                                    </button>
                                }
                                @for (var i = EdgeStepsMs.Length - 1; i >= 0; i--)
                                {
                                    var step = EdgeStepsMs[i];
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            title="@FormatStep(step) seconds later"
                                            @onclick="() => AdjustSelectedEdge(LyricsWordEdge.End, step)">
                                        +@FormatStep(step)
                                    </button>
                                }
                            </div>

                            @* The number the "Hey!" problem is invisible without. *@
                            <div class="lyrics-editor-span-length">
                                Sung for @(((_selectedEndMs - _selectedStartMs) / 1000d).ToString("0.00"))s
                                &middot; steps are seconds
                            </div>
                        </div>
                        <div class="btn-group mt-2" role="group">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => NudgeSelected(-NudgeMs)" title="Earlier">
                                ← Earlier
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="PlayFromSelected" title="Play from here">
                                Play from here
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => NudgeSelected(NudgeMs)" title="Later">
                                Later →
                            </button>
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NudgeSelectedLineEarlier">
                                Shift whole line earlier
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NudgeSelectedLineLater">
                                Shift whole line later
                            </button>
                        </div>
                    }
                </div>

                <div class="lyrics-editor-actions">
                    @if (_isDirty)
                    {
                        <span class="badge bg-warning text-dark mb-2">Unsaved changes</span>
                    }
                    else if (_hasUnpublishedChanges)
                    {
                        <span class="badge bg-info text-dark mb-2">Saved, not published</span>
                    }

                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Undo" disabled="@(!_canUndo)">
                        Undo
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetAll" disabled="@(!_canUndo && !_isDirty)">
                        Start again
                    </button>

                    @* Only once something has been SAVED, because that is the only case "Start
                       again" cannot reach: from then on the editor loads the draft, so every local
                       reset lands on the creator's own edits rather than on the aligner's. Asks
                       twice - it deletes saved work and the undo stack does not cover it. *@
                    @if (_hasUnpublishedChanges)
                    {
                        <button type="button"
                                class="btn @(_confirmingRevert ? "btn-danger" : "btn-outline-danger") btn-sm"
                                @onclick="RevertToAlignedAsync"
                                disabled="@_isSaving">
                            @(_confirmingRevert
                                ? "Delete my changes?"
                                : "Back to original timing")
                        </button>
                    }

                    @* The escape hatch for the one problem this page cannot fix. Everything else here
                       moves words in time; none of it changes what the words ARE. An aligner handed
                       the wrong lyrics times them faithfully and confidently, and hearing them
                       against the song is the only way anybody finds out - which is why the way out
                       lives here, where the discovery happens, rather than only on the songs grid. *@
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ReplaceLyrics">
                        Replace lyrics
                    </button>

                    @* Only once there is something for a listener to lose. Offering to hide lyrics
                       nobody can see would be a button that does nothing. *@
                    @if (_isPublished)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="HideFromListenersAsync" disabled="@_isSaving">
                            Hide from listeners
                        </button>
                    }

                    @* Asks twice. This is the only control here with no undo behind it: it discards
                       the alignment, the draft, the pasted words and the published timings together,
                       and the way back is another separation pass. *@
                    <button type="button"
                            class="btn @(_confirmingRemove ? "btn-danger" : "btn-outline-danger") btn-sm"
                            @onclick="RemoveLyricsAsync"
                            disabled="@_isSaving">
                        @(_confirmingRemove ? "Delete these lyrics?" : "Remove lyrics")
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SaveDraft" disabled="@(_isSaving || !_isDirty)">
                        Save
                    </button>

                    @* The only thing on this page that changes what a listener sees. Kept visually
                       distinct from Save for that reason - the two being adjacent and identical is
                       how somebody publishes a half-finished pass by muscle memory. *@
                    @* Disabled rather than hidden while a takedown stands. A missing button reads as
                       a bug; a greyed one with the banner above it reads as the decision it is. *@
                    <button type="button" class="btn btn-success"
                            @onclick="Publish" disabled="@(_isSaving || _adminDisabled)">
                        @(_isPublished ? "Publish changes" : "Publish")
                    </button>
                </div>

                <p class="text-muted small mt-2 mb-0">
                    @if (_isPublished)
                    {
                        <span>Listeners can see these lyrics. Publishing again replaces what they see.</span>
                    }
                    else
                    {
                        <span>Listeners can't see these lyrics yet.</span>
                    }
                </p>

                @if (_problems.Count > 0)
                {
                    @* Validation only ever runs at Publish, so this is the one place a creator meets
                       it. Worded as things to fix rather than as error codes. *@
                    <div class="alert alert-warning mt-2">
                        <strong>These timings aren't ready yet:</strong>
                        <ul class="mb-0">
                            @foreach (var problem in _problems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="alert alert-success mt-2 py-2">@_statusMessage</div>
                }
            </div>
        </div>
    </div>
}
