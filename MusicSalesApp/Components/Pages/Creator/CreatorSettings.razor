@page "/CreatorSettings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@using Syncfusion.Blazor.Notifications
@attribute [Authorize(Policy = Permissions.ValidatedUser)]
@inherits CreatorSettingsModel

<PageTitle>Creator / Artist Settings</PageTitle>

<SfToast @ref="_toastRef" ShowCloseButton="true" NewestOnTop="true" ShowProgressBar="true" Timeout="5000">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="creator-settings-page">
    <div class="creator-settings-shell">
        @if (_loading)
        {
            <div class="creator-settings-loading">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!_isAuthenticated)
        {
            <SfMessage Severity="MessageSeverity.Warning">You must be logged in to manage creator settings.</SfMessage>
        }
        else
        {
            <div class="creator-settings-topline">
                <div class="creator-settings-title">
                    <h2>Creator / Artist Settings</h2>
                    <p>Account Email: @_userEmail</p>
                </div>                
            </div>

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <SfMessage Severity="MessageSeverity.Success">@_successMessage</SfMessage>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <SfMessage Severity="MessageSeverity.Error">@_errorMessage</SfMessage>
            }

            @if (!_isActiveCreator)
            {
                <SfCard CssClass="creator-settings-card creator-settings-hero-card">
                    <CardContent>
                        <p class="creator-settings-kicker">Creator activation</p>
                        <h3>Become a creator</h3>
                        <p>Review and accept the Creator Agreement to enable creator tools for your account.</p>

                        <div class="creator-agreement-box">
                            <SfCheckBox @bind-Checked="_creatorAgreementAccepted" TChecked="bool" />
                            <label>
                                I have read and agree to the
                                <a href="@AppPageRoutes.CreatorAgreement" target="_blank" rel="noopener noreferrer">Creator Agreement</a>.
                            </label>
                        </div>

                        <div class="creator-settings-actions">
                            @if (!_startingOnboarding)
                            {
                                <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Become a Creator" OnClick="StartCreatorOnboarding" Disabled="@(!CanStartOnboarding)" IconCss="streamtunes-button-icon streamtunes-button-icon-creator" />
                                <span class="creator-settings-hint">
                                    @(CanStartOnboarding ? "Your acceptance will be saved to your account." : "You must accept the agreement to continue.")
                                </span>
                            }
                            else
                            {
                                <span class="creator-settings-hint">Activating your creator account...</span>
                            }
                        </div>
                    </CardContent>
                </SfCard>
            }
            else
            {
                <SfCard CssClass="creator-settings-card">
                    <CardContent>
                        @if (_showActivationSuccess)
                        {
                            <div class="creator-success-hero">
                                <div class="creator-success-icon" aria-hidden="true">✓</div>
                                <div>
                                    <p class="creator-settings-kicker">Creator account activated</p>
                                    <h3>Congratulations - you're now a creator.</h3>
                                    <p>You can upload your music immediately and start managing your creator catalog.</p>
                                    <div class="creator-settings-actions">
                                        <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Upload Music" OnClick="NavigateToUpload" IconCss="streamtunes-button-icon streamtunes-button-icon-upload-music" />
                                        <SfButton Content="Go to Creator Dashboard" OnClick="NavigateToDashboard" IconCss="streamtunes-button-icon streamtunes-button-icon-dashboard" />
                                    </div>
                                </div>
                            </div>

                            @if (!IsPayoutReady)
                            {
                                <div class="creator-info-strip">
                                    <span class="streamtunes-button-icon streamtunes-button-icon-payout" aria-hidden="true"></span>
                                    <div>
                                        <strong>Payout setup comes later</strong>
                                        <p>Once your balance reaches the minimum payout threshold, you will need to complete the required tax form and add an owned or authorized PayPal payout email before StreamTunes can send a payout.</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="creator-settings-kicker">Creator status</p>
                            <h3>Your creator account is active</h3>
                            <p>Upload music now. Payout details are required before StreamTunes can send earnings.</p>
                        }

                        <div class="creator-status-grid">
                            <div class="creator-status-card">
                                <div class="creator-status-label">Creator role</div>
                                <div class="creator-status-value good">Active</div>
                            </div>
                            <div class="creator-status-card">
                                <div class="creator-status-label">Music uploads</div>
                                <div class="creator-status-value good">Enabled</div>
                            </div>
                            <div class="creator-status-card">
                                <div class="creator-status-label">Payout setup</div>
                                <div class="creator-status-value @(IsPayoutReady ? "good" : "pending")">
                                    @(IsPayoutReady ? "Complete" : "Required before payout")
                                </div>
                            </div>
                        </div>

                        @if (!IsPayoutReady)
                        {
                            <div class="creator-checklist">
                                <div class="creator-checklist-item">
                                    <div class="creator-checklist-icon">1</div>
                                    <div><strong>Upload your music</strong><span> Add songs and cover art.</span></div>
                                </div>
                                <div class="creator-checklist-item">
                                    <div class="creator-checklist-icon">2</div>
                                    <div><strong>Reach the payout threshold</strong><span> Earnings can accrue before payout setup is complete.</span></div>
                                </div>
                                <div class="creator-checklist-item">
                                    <div class="creator-checklist-icon">3</div>
                                    <div><strong>Complete payout setup</strong><span> Submit the required tax form and provide an owned or authorized PayPal email before your first payout.</span></div>
                                </div>
                            </div>
                        }

                        <div class="creator-settings-actions">
                            <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Upload Music" OnClick="NavigateToUpload" IconCss="streamtunes-button-icon streamtunes-button-icon-upload-music" />
                            <SfButton Content="Manage My Songs" OnClick="NavigateToManageSongs" IconCss="streamtunes-button-icon streamtunes-button-icon-song-list" />
                            <SfButton Content="View Earnings" OnClick="NavigateToDashboard" IconCss="streamtunes-button-icon streamtunes-button-icon-earnings" />
                            <SfButton Content='@(IsPayoutReady ? "Manage Payout Info" : "Set Up Payouts")' OnClick="TogglePayoutSetup" CssClass="e-secondary" IconCss="streamtunes-button-icon streamtunes-button-icon-payout" />
                        </div>
                    </CardContent>
                </SfCard>

                @if (_showPayoutSetup)
                {
                    <SfCard CssClass="creator-settings-card">
                        <CardContent>
                            <p class="creator-settings-kicker">Payout setup</p>
                            <h3>@(IsPayoutReady ? "Manage payout information" : "Set up payouts")</h3>
                            <p>Provide a PayPal email you own, control, or are authorized to use and complete the required tax form before payouts can be sent.</p>

                            <div class="creator-payout-grid">
                                <section class="creator-payout-section">
                                    <div class="creator-section-heading">
                                        <span class="creator-checklist-icon">1</span>
                                        <div>
                                            <strong>PayPal payout email</strong>
                                            <span class="@(IsPayoutPayPalReady ? "creator-status-text-good" : "creator-status-text-pending")">
                                                @(IsPayoutPayPalReady ? "Confirmed" : "Needed before payout")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="creator-settings-field">
                                        <label for="paypalEmail" class="e-label">PayPal Email Address</label>
                                        <SfTextBox @bind-Value="_paypalEmail" ID="paypalEmail" Type="InputType.Email" Placeholder="your-paypal-email@example.com" CssClass="e-outline" />
                                        <small>Enter the email address for a PayPal account owned or controlled by you or your authorized creator business.</small>
                                    </div>
                                    <div class="creator-settings-checkbox">
                                        <SfCheckBox @bind-Checked="_paypalAccountAffirmed" TChecked="bool" />
                                        <span>I affirm that I own or am authorized to use this PayPal account for creator payouts, and that it is in good standing and can receive payouts.</span>
                                    </div>
                                    <div class="creator-settings-actions creator-settings-save-row">
                                        <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta"
                                                  Content="@(_savingPayPalEmail ? "Saving..." : "Save PayPal Email")"
                                                  Disabled="@_savingPayPalEmail"
                                                  OnClick="SavePayPalEmail"
                                                  IconCss="streamtunes-button-icon streamtunes-button-icon-save" />
                                        @if (!string.IsNullOrWhiteSpace(_payoutEmailMessage))
                                        {
                                            <SfMessage Severity="@(_payoutEmailSaveSuccess ? MessageSeverity.Success : MessageSeverity.Error)" CssClass="creator-settings-inline-message">@_payoutEmailMessage</SfMessage>
                                        }
                                    </div>
                                </section>

                                <section class="creator-payout-section">
                                    <div class="creator-section-heading">
                                        <span class="creator-checklist-icon">2</span>
                                        <div>
                                            <strong>Tax form</strong>
                                            <span class="@(IsPayoutTaxReady ? "creator-status-text-good" : "creator-status-text-pending")">
                                                @(IsPayoutTaxReady ? "Completed" : "Needed before payout")
                                            </span>
                                        </div>
                                    </div>

                                    @if (_showMaintenanceWarning)
                                    {
                                        <div class="creator-settings-alert creator-settings-alert-warning">
                                            Tax form updates may be unavailable during the Tax Bandits maintenance window (@_maintenanceStartLocal - @_maintenanceEndLocal @_maintenanceTimeZoneAbbreviation).
                                        </div>
                                    }

                                    @if (_creatorTaxFormStatus == TaxFormStatus.Completed.ToString())
                                    {
                                        <p>Your tax form is complete for payout purposes.</p>
                                        <SfButton Content="Update W-9/W-8 Tax Form" OnClick="InitiateTaxFormUpdate" Disabled="@_updatingTaxForm" IconCss="streamtunes-button-icon streamtunes-button-icon-tax-form" />
                                    }
                                    else if (_creatorTaxFormStatus == TaxFormStatus.Pending.ToString())
                                    {
                                        @if (!string.IsNullOrWhiteSpace(_lastTaxFormErrorMessage))
                                        {
                                            <div class="creator-settings-alert creator-settings-alert-danger" role="alert" aria-live="assertive">
                                                <strong>Your previous tax form submission had an error:</strong>
                                                <br />@_lastTaxFormErrorMessage
                                                <br /><small>Please correct the issue and resubmit your tax form.</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <p>Your tax form is pending. Continue the W-9 or W-8 form to finish payout setup.</p>
                                        }
                                        <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Complete W-9/W-8 Tax Form" OnClick="NavigateToTaxForm" IconCss="streamtunes-button-icon streamtunes-button-icon-tax-form" />
                                    }
                                    else if (_creatorTaxFormStatus == TaxFormStatus.TinMatchInProgress.ToString())
                                    {
                                        <div class="creator-settings-alert creator-settings-alert-info">
                                            Your tax form was submitted successfully. IRS TIN verification is in progress and may take up to 1 hour.
                                        </div>
                                    }
                                    else if (_creatorTaxFormStatus == TaxFormStatus.Failed.ToString())
                                    {
                                        <div class="creator-settings-alert creator-settings-alert-danger">
                                            TIN verification failed. Please double-check that your TIN and name match IRS records.
                                        </div>
                                        @if (_tinMatchCooldownRemaining.HasValue && _tinMatchCooldownRemaining.Value > TimeSpan.Zero)
                                        {
                                            <p class="creator-settings-hint">Retry available in @_tinMatchCooldownRemaining.Value.ToString(@"hh\:mm\:ss").</p>
                                        }
                                        else
                                        {
                                            <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Retry W-9/W-8 Tax Form" OnClick="InitiateTaxFormUpdate" Disabled="@_updatingTaxForm" IconCss="streamtunes-button-icon streamtunes-button-icon-retry" />
                                        }
                                    }
                                    else
                                    {
                                        <p>Complete your W-9 or W-8 tax form before your first payout.</p>
                                        <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Complete W-9/W-8 Tax Form" OnClick="InitiateTaxFormUpdate" Disabled="@_updatingTaxForm" IconCss="streamtunes-button-icon streamtunes-button-icon-tax-form" />
                                    }
                                </section>
                            </div>
                        </CardContent>
                    </SfCard>
                }

                <SfCard CssClass="creator-settings-card">
                    <CardContent>
                        <p class="creator-settings-kicker">Creator profile</p>
                        <h3>Public creator details</h3>
                        <div class="creator-settings-form-grid">
                            <div class="creator-settings-field">
                                <label for="editCreatorDisplayName" class="e-label">Display Name (max 20 characters)</label>
                                <SfTextBox @bind-Value="_editCreatorDisplayName" ID="editCreatorDisplayName" Placeholder="Your artist/band name" CssClass="e-outline" MaxLength="20" />
                                <small>This name will be shown on your song cards.</small>
                            </div>
                            <div class="creator-settings-field">
                                <label for="editCreatorBio" class="e-label">Bio (optional)</label>
                                <SfTextBox @bind-Value="_editCreatorBio" ID="editCreatorBio" Placeholder="Tell your listeners about yourself..." CssClass="e-outline" Multiline="true" MaxLength="1000" />
                            </div>
                        </div>
                        <div class="creator-settings-actions">
                            <SfButton CssClass="cta-secondary hero-secondary-cta creator-settings-cta" Content="Save Profile" OnClick="SaveCreatorProfile" Disabled="@_savingCreatorProfile" IconCss="streamtunes-button-icon streamtunes-button-icon-save" />
                            @if (!string.IsNullOrEmpty(_creatorProfileMessage))
                            {
                                <span class="@(_creatorProfileSuccess ? "creator-status-text-good" : "creator-status-text-danger")">@_creatorProfileMessage</span>
                            }
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard CssClass="creator-settings-card creator-settings-danger-zone">
                    <CardContent>
                        <p class="creator-settings-kicker">Creator account</p>
                        <h3>Stop being a creator</h3>
                        <p>If you no longer want to share your music on StreamTunes, you can stop being a creator. This removes your uploaded music from the platform and deletes your song files from storage.</p>
                        <div class="creator-settings-actions">
                            @if (!_stoppingCreatorStatus)
                            {
                                <SfButton CssClass="e-danger" Content="Stop Being a Creator" OnClick="ShowStopSellingConfirmation" IconCss="streamtunes-button-icon streamtunes-button-icon-warning" />
                            }
                            else
                            {
                                <span class="creator-settings-hint">Processing...</span>
                            }
                        </div>
                    </CardContent>
                </SfCard>
            }
        }
    </div>
</div>

<SfDialog @ref="_stopSellingDialog" Width="500px" IsModal="true" ShowCloseIcon="true" Visible="false" Header="Stop Being a Creator">
    <DialogTemplates>
        <Content>
            <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
            <p>By stopping your creator account:</p>
            <ul>
                <li>All your uploaded music will be permanently removed from the platform</li>
                <li>All your song files will be deleted from storage</li>
                <li>Your music will no longer be available for purchase or streaming</li>
                <li><strong>Users who previously purchased your music will no longer be able to access it</strong></li>
            </ul>
            <p>To confirm, please type your email address below:</p>
            <SfTextBox @bind-Value="_stopSellingConfirmEmail" Placeholder="Enter your email" CssClass="e-outline" />
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="Stop Being a Creator" OnClick="ConfirmStopSelling" Disabled="@(!CanConfirmStopSelling)" IconCss="streamtunes-button-icon streamtunes-button-icon-warning" />
            <SfButton Content="Cancel" OnClick="CloseStopSellingDialog" IconCss="streamtunes-button-icon streamtunes-button-icon-cancel" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
