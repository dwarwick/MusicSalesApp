@page "/creator/songs"
@rendermode InteractiveServer
@inherits CreatorSongManagementModel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@attribute [Authorize(Policy = Permissions.ManageOwnSongs)]

<PageTitle>My Songs - Creator Dashboard</PageTitle>

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="bi bi-music-note-list me-2"></i>My Songs</h3>
            <p class="text-muted mb-0">Manage your uploaded music</p>
        </div>
        <div>
            <SfButton CssClass="e-success" OnClick="NavigateToUpload">
                <i class="bi bi-cloud-upload me-1"></i> Upload New Music
            </SfButton>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading your songs...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @_errorMessage
        </div>
    }
    else if (!_songs.Any())
    {
        <div class="text-center my-5">
            <i class="bi bi-music-note-beamed display-1 text-muted"></i>
            <h4 class="mt-3">No songs yet</h4>
            <p class="text-muted">You haven't uploaded any music yet. Click the button below to get started!</p>
            <SfButton CssClass="e-success" OnClick="NavigateToUpload">
                <i class="bi bi-cloud-upload me-1"></i> Upload Your First Song
            </SfButton>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Total Songs</h5>
                        <h2 class="mb-0">@_songs.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h5 class="card-title">Total Value</h5>
                        <h2 class="mb-0">@_songs.Count songs</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body">
                        <h5 class="card-title">Total Streams</h5>
                        <h2 class="mb-0">@(_songs.Sum(s => s.NumberOfStreams).ToString("N0"))</h2>
                    </div>
                </div>
            </div>
        </div>

        <SfGrid @ref="_grid" 
                TValue="SongAdminViewModel"
                DataSource="@_songs"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
            AllowResizing="true"
                Height="400px">
            <GridPageSettings PageSize="10"></GridPageSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <GridColumn HeaderText="Actions" Width="200" AllowFiltering="false" AllowSorting="false">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            <div class="d-flex gap-2">
                                @if (song.IsEnabled)
                                {
                                    <SfButton OnClick="() => EditSong(song)" IsPrimary="true" CssClass="e-btn e-small e-primary">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </SfButton>
                                    @if (_lyricsAvailable)
                                    {
                                        @* The paste box is offered only while there is still lyrics
                                           work to start. Once an alignment has landed the creator's
                                           next move is to hear it, not to paste the same words again
                                           - so the slot that used to open the dialog hands them the
                                           .lrc instead, and Preview Results is where the timing gets
                                           judged. The LrcBlobPath test is not redundant: the LRC copy
                                           can fail without costing the timings. *@
                                        @if (HasTimingsToEdit(song) && !string.IsNullOrEmpty(song.LyricsLrcBlobPath))
                                        {
                                            <SfButton OnClick="() => DownloadLrcAsync(song)" CssClass="e-btn e-small e-outline">
                                                <i class="bi bi-download me-1"></i> Download LRC
                                            </SfButton>
                                        }
                                        else
                                        {
                                            <SfButton OnClick="() => OpenLyricsEditor(song)" CssClass="e-btn e-small e-outline">
                                                <i class="bi bi-music-note-list me-1"></i> Lyrics
                                            </SfButton>
                                        }

                                        @* Only once there is something to tune. Before an alignment
                                           lands the editor has nothing to show, and sending a creator
                                           to a page that can only apologise is worse than not
                                           offering it. *@
                                        @if (HasTimingsToEdit(song))
                                        {
                                            <a class="e-btn e-small e-outline"
                                               href="@AppPageRoutes.CreatorSongLyrics(int.Parse(song.Id))">
                                                <i class="bi bi-sliders me-1"></i> Preview Results
                                            </a>
                                        }
                                    }
                                    <SfButton OnClick="() => ShowDeleteConfirmation(song)" CssClass="e-btn e-small e-danger">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </SfButton>
                                }
                                else
                                {
                                    <span class="text-muted">No actions available</span>
                                }
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Cover" Width="100" AllowFiltering="false">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.SongImageUrl))
                            {
                                <div style="position: relative; display: inline-block;">
                                    <img src="@song.SongImageUrl" alt="Cover" class="img-thumbnail" style="max-width: 60px; max-height: 60px;" />
                                    @if (song.IsImageSquare == false)
                                    {
                                        <span class="badge bg-dark text-dark" style="position: absolute; top: -5px; right: -5px; font-size: 0.6rem;" title="Image is not square - needs cropping">⚠️</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <dotlottie-wc src="https://lottie.host/07d61f77-2c9f-49a7-9884-4030d670f9ed/hSfkTa6ydt.lottie" style="width: 50px; height: 50px;" autoplay loop></dotlottie-wc>
                                </div>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.SongTitle)" HeaderText="Title" Width="200"></GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.PersonaName)" HeaderText="Persona" Width="130">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.PersonaName))
                            {
                                <span class="badge bg-info text-dark">@song.PersonaName</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.ArtistName)" HeaderText="Artist Name" Width="150"></GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.Genre)" HeaderText="Genre" Width="100"></GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.IsAiGenerated)" HeaderText="AI Music" Width="120" AllowFiltering="true" AllowSorting="true" AllowResizing="true">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.IsAiGenerated)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.IsAiVocals)" HeaderText="AI Vocals" Width="120" AllowFiltering="true" AllowSorting="true" AllowResizing="true">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.IsAiVocals)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.IsAiLyrics)" HeaderText="AI Lyrics" Width="120" AllowFiltering="true" AllowSorting="true" AllowResizing="true">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.IsAiLyrics)
                            {
                                <span class="badge bg-primary">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Duration" Width="100">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.TrackLength.HasValue)
                            {
                                var ts = TimeSpan.FromSeconds(song.TrackLength.Value);
                                <span>@(ts.Hours > 0 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss"))</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.NumberOfStreams)" HeaderText="Streams" Width="100" Format="N0"></GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.LikeCount)" HeaderText="Likes" Width="80" Format="N0"></GridColumn>
                @if (_lyricsAvailable)
                {
                    @* Sorted on the status now that the confidence has gone. The score was the sort
                       key while this column existed to choose an admin threshold; it says nothing a
                       creator can act on, and it reads far worse than the timings it describes, so
                       grouping by state is what is left that is worth sorting. Songs with no lyrics
                       sort as null and fall to one end together. *@
                    <GridColumn Field="@nameof(SongAdminViewModel.LyricsStatus)" HeaderText="Lyrics" Width="130" AllowSorting="true">
                        <Template>
                            @{
                                var song = (context as SongAdminViewModel);
                                switch (song.LyricsStatus)
                                {
                                    case SongLyricsStatus.Published:
                                        <span class="badge bg-success">Published</span>
                                        break;
                                    case SongLyricsStatus.NeedsReview:
                                        <span class="badge bg-warning text-dark">Timed</span>
                                        <div><small class="text-muted">Not published</small></div>
                                        break;
                                    case SongLyricsStatus.Failed:
                                        <span class="badge bg-danger">Failed</span>
                                        break;
                                    case SongLyricsStatus.Pending:
                                        <span class="badge bg-secondary">Timing&hellip;</span>
                                        break;
                                    default:
                                        <span class="text-muted">&mdash;</span>
                                        break;
                                }

                                @* Otherwise genuinely invisible: the song plays, listeners still see
                                   the published timings, and nothing says there is newer work behind
                                   them. A creator interrupted mid-session has no other way to find
                                   out they never finished. *@
                                if (song.HasUnpublishedLyricEdits)
                                {
                                    <div><small class="text-info">Unpublished edits</small></div>
                                }
                            }
                        </Template>
                    </GridColumn>
                }
                <GridColumn Field="@nameof(SongAdminViewModel.IsEnabled)" HeaderText="Status" Width="120">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (song.IsEnabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disabled</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SongAdminViewModel.StatusReason)" HeaderText="Status Reason" Width="200">
                    <Template>
                        @{
                            var song = (context as SongAdminViewModel);
                            if (!string.IsNullOrEmpty(song.StatusReason))
                            {
                                <small class="text-break">@song.StatusReason</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
</div>

<!-- Delete Confirmation Dialog -->
<SfDialog @bind-Visible="_showDeleteDialog" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Delete Song</Header>
        <Content>
            @if (_songToDelete != null)
            {
                <div class="text-center">
                    <i class="bi bi-exclamation-triangle-fill text-warning display-4 mb-3"></i>
                    <p>Are you sure you want to delete "<strong>@_songToDelete.SongTitle</strong>"?</p>
                    <p class="text-danger"><strong>Warning:</strong> This action cannot be undone!</p>
                    <p class="text-muted small">
                        The song will be removed from the platform and will no longer be available to subscribers.
                    </p>
                </div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-secondary" Content="Cancel" OnClick="CancelDelete" />
            <SfButton CssClass="e-danger" Content="Delete" OnClick="ConfirmDelete" Disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Delete
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Edit Dialog (similar to admin but simplified) -->
<SfDialog @bind-Visible="_showEditDialog" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Edit Song Details</Header>
        <Content>
            @if (_editingSong != null)
            {
                <div class="p-3">
                    @if (_validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in _validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Song Title <span class="text-danger">*</span></label>
                        <SfTextBox @bind-Value="_editSongTitle" CssClass="e-outline" Placeholder="Enter song title" MaxLength="200" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_editingSong.OriginalAudioFileName))
                    {
                        <div class="alert alert-secondary py-2">
                            <strong>Retained original:</strong> @_editingSong.OriginalAudioFileName
                            (@_editingSong.OriginalAudioContentType, @_editingSong.OriginalAudioFileSize bytes)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Artist Persona</label>
                        <SfDropDownList TValue="int?" TItem="PersonaDropdownItem"
                                       @bind-Value="_editPersonaId"
                                       DataSource="@_personaOptions"
                                       Placeholder="— No Persona —"
                                       CssClass="e-outline">
                            <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                        </SfDropDownList>
                        <small class="text-muted">Select a persona to display as the artist name for this song. Persona name takes highest priority.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Artist Name</label>
                        <SfTextBox @bind-Value="_editArtistName" CssClass="e-outline" Placeholder="Enter artist name (max 20 characters)" MaxLength="20" />
                        <small class="text-muted">Optional. Used if no persona is selected. If set, this will override your display name on song cards.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Genre <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string" @bind-Value="_editGenre" 
                                      DataSource="@_genreOptions"
                                      Placeholder="-- Select Genre --"
                                      CssClass="e-outline">
                        </SfDropDownList>
                        @if (!_showAddGenre)
                        {
                            <div class="mt-1">
                                <SfButton CssClass="e-btn e-small e-outline" OnClick="() => _showAddGenre = true">
                                    <i class="bi bi-plus-circle me-1"></i> Add New Genre
                                </SfButton>
                            </div>
                        }
                        else
                        {
                            <div class="mt-2 d-flex gap-2 align-items-end">
                                <SfTextBox @bind-Value="_newGenreName" CssClass="e-outline" Placeholder="Enter new genre name" MaxLength="50" />
                                <SfButton CssClass="e-btn e-small e-success" OnClick="AddNewGenre">Add</SfButton>
                                <SfButton CssClass="e-btn e-small" OnClick="() => { _showAddGenre = false; _newGenreName = string.Empty; }">Cancel</SfButton>
                            </div>
                        }
                    </div>

                    <div class="mb-3 d-flex flex-wrap gap-3">
                        <SfCheckBox @bind-Checked="_editIsAiGenerated" Label="AI Music" CssClass="e-outline"></SfCheckBox>
                        <SfCheckBox @bind-Checked="_editIsAiVocals" Label="AI Vocals" CssClass="e-outline"></SfCheckBox>
                        <SfCheckBox @bind-Checked="_editIsAiLyrics" Label="AI Lyrics" CssClass="e-outline"></SfCheckBox>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Song Cover Image</label>
                        @if (_editingSong.IsImageSquare == false)
                        {
                            <div class="alert alert-warning py-1 px-2 mb-2">
                                <small><i class="bi bi-exclamation-triangle"></i> Image is not square. Please crop the image to display it correctly on the site.</small>
                            </div>
                        }
                        @if (_cropApplied)
                        {
                            <div class="mb-2">
                                <div class="mt-1">
                                    <span class="text-success"><i class="bi bi-check-circle"></i> Image cropped to square — will be saved when you click Save Changes</span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_editingSong.SongImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@_editingSong.SongImageUrl" alt="Current song cover" class="img-thumbnail" style="max-width: 200px;" />
                            </div>
                            @if (!_showCropTool && !string.IsNullOrEmpty(_editingSong.JpegFileName))
                            {
                                <SfButton OnClick="OpenCropTool" CssClass="e-btn e-small e-outline mb-2">
                                    <i class="bi bi-crop"></i> Crop to Square
                                </SfButton>
                            }
                        }
                        else
                        {
                            <div class="mb-2">
                                <span class="text-muted">No cover image - a default animation will be displayed</span>
                            </div>
                        }
                        @if (_showCropTool)
                        {
                            <div class="crop-tool-container mb-3 p-3 border rounded">
                                <h6>Crop Image to Square</h6>
                                <p class="text-muted small">Drag to position. Use the slider to zoom. The green border shows the crop area.</p>
                                <canvas id="creator-crop-canvas" width="300" height="300" style="border: 1px solid #ccc; cursor: grab; display: block; margin-bottom: 10px;"></canvas>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="small">Zoom:</span>
                                    <input type="range" min="0" max="100" value="@_cropZoom" @oninput="@(async (e) => await OnCropZoomChanged(int.Parse(e.Value?.ToString() ?? "50")))" class="form-range" style="max-width: 200px;" />
                                </div>
                                <div class="d-flex gap-2">
                                    <SfButton OnClick="ApplyCrop" IsPrimary="true" CssClass="e-btn e-small e-success">
                                        <i class="bi bi-check"></i> Apply Crop
                                    </SfButton>
                                    <SfButton OnClick="CancelCrop" CssClass="e-btn e-small">
                                        Cancel
                                    </SfButton>
                                </div>
                            </div>
                        }
                        <InputFile OnChange="HandleSongImageUpload" accept=".jpeg,.jpg,.png" class="form-control" />
                        <small class="text-muted">Upload a song cover image (JPEG or PNG) - optional</small>
                        @if (_songImageFile != null)
                        {
                            @if (_newSongImageIsSquare == false)
                            {
                                <div class="alert alert-warning py-1 px-2 mt-2 mb-1">
                                    <small><i class="bi bi-exclamation-triangle"></i> Selected image is not square. Use the crop tool after saving, or select a square image.</small>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_newSongImagePreviewUrl))
                            {
                                <div class="mt-2">
                                    <img src="@_newSongImagePreviewUrl" alt="Selected song cover preview" class="img-thumbnail" style="max-width: 200px;" />
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 text-success">
                                    <i class="bi bi-check-circle"></i> New file selected: @_songImageFile.Name
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-secondary" Content="Cancel" OnClick="CancelEdit" />
            <SfButton CssClass="e-primary" Content="Save Changes" OnClick="SaveEdit" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Save Changes
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@* Lyric timing lives in its own component: this file is already long, and the dialog owns a
   SignalR subscription and a state machine that have nothing to do with editing song metadata.

   Mounted only when the feature is configured, which matters beyond tidiness: the dialog opens a
   SignalR connection on first render, and an environment without lyric timing should not pay for
   one on every visit to this page. *@
@if (_lyricsAvailable)
{
    <LyricsEditorDialog Song="_lyricsSong"
                        CreatorId="@(_creatorId ?? 0)"
                        @bind-IsVisible="_showLyricsDialog"
                        IsReplacing="_replacingLyrics"
                        OnCompleted="LoadSongsAsync"
                        OnTimingCompleted="OnLyricsTimingCompletedAsync" />

    @* Says what happened and what is about to happen, and only then moves. A creator who has just
       watched a progress bar for several minutes should not have the screen change under them with
       no explanation - and a non-technical one, left on a grid with no idea the run had finished,
       has no reason to guess that Preview Results is the next step. No close icon: the two buttons
       are the answer, and an X here would read as "cancel", which is not on offer. *@
    <SfDialog @bind-Visible="_showTimingCompleteNotice" Width="460px" IsModal="true" ShowCloseIcon="false">
        <DialogTemplates>
            <Header>
                <div class="lyrics-dialog-header">
                    <i class="bi bi-check-circle me-2"></i>
                    Your lyrics are timed
                </div>
            </Header>
            <Content>
                <p class="mb-2">
                    We've finished timing the lyrics for
                    <strong>@_timedSongTitle</strong>.
                </p>
                <p class="mb-0">
                    We're taking you to <strong>Preview Results</strong>, where you can play the song
                    and watch the words light up. Nothing is shown to listeners until you press
                    Publish there.
                </p>
            </Content>
            <FooterTemplate>
                <SfButton OnClick="OpenPreviewResults" CssClass="e-btn cta-secondary hero-secondary-cta">
                    <i class="bi bi-sliders me-1"></i> Preview results now
                </SfButton>
                <SfButton OnClick="DismissTimingCompleteNotice" CssClass="e-btn e-small">
                    Not just now
                </SfButton>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}
