@page "/admin/image-variant-backfill"
@rendermode InteractiveServer
@inherits ImageVariantBackfillModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Models
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.ProgressBar
@attribute [Authorize(Policy = Permissions.ManageUsers)]

<PageTitle>Image Variant Backfill</PageTitle>

<div class="container-fluid my-4">

    <h3>Image Variant Backfill</h3>

    <div class="alert alert-info">
        Generates the pre-resized WebP renditions of cover art and persona images that make the site and the
        mobile apps load artwork quickly. New uploads get them automatically &mdash; this is the one-off pass
        over everything that was uploaded beforehand.
        <hr />
        <strong>This run writes only to this environment's containers:</strong>
        @if (_targetContainers.Count > 0)
        {
            <text>@string.Join(", ", _targetContainers)</text>
        }
        else
        {
            <text>(none configured)</text>
        }
        <br />
        Run it here first, confirm the result, then repeat on the next environment.
        <hr />
        <strong>Two steps.</strong> This job never writes to the <strong>backup-</strong> containers, so when it
        finishes, run a <a href="/admin/storage-backup">Storage Backup</a> to propagate the new renditions there.
        Until you do, a restore taken from an older backup would not include them.
    </div>

    <div class="alert alert-warning">
        This job is CPU-bound and runs on the web server, so it competes with serving requests. Prefer off-peak
        hours, start with a dry run to see how long it takes, and cancel if the site feels slow.
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    @if (_activeRun != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">
                    @ModeLabel(_activeRun) in progress &mdash; run @_activeRun.Id (@_activeRun.Status)
                </h5>

                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <strong>@ScopeLabel(_activeRun.Scope)</strong>
                        <span>@RunCounts(_activeRun)</span>
                    </div>
                    <SfProgressBar Type="ProgressType.Linear"
                                   Height="22"
                                   Value="@PercentComplete(_activeRun)"
                                   IsIndeterminate="@IsIndeterminate(_activeRun)"
                                   ShowProgressValue="true">
                    </SfProgressBar>
                </div>

                @if (_activeRun.CancellationRequestedAt.HasValue)
                {
                    <p class="text-muted mb-2">Cancellation requested &mdash; finishing the current image.</p>
                }

                <SfButton CssClass="e-outline" Disabled="@_busy" OnClick="CancelRunAsync">Cancel Run</SfButton>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Actions</h5>

            <div class="mb-3" style="max-width: 420px;">
                <label class="form-label">Which images</label>
                <SfDropDownList TValue="ImageVariantBackfillScope" TItem="ScopeOption"
                                @bind-Value="_scope" DataSource="@_scopeOptions">
                    <DropDownListFieldSettings Value="Scope" Text="Name"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>

            <div class="mb-3">
                <SfCheckBox @bind-Checked="_removeLegacyPngSharingImages" TChecked="bool"
                            Label="Also delete superseded PNG sharing images"></SfCheckBox>
                <div class="text-muted small mt-1">
                    Facebook share images moved from PNG to JPEG. The old PNGs are orphaned &mdash; nothing
                    overwrites them &mdash; and each one is 1&ndash;2 MB. This job already visits every song, so
                    it can clear them in the same pass.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <SfButton CssClass="e-outline" Disabled="@ActionsDisabled" OnClick="StartDryRunAsync">
                    Dry Run
                </SfButton>
                <SfButton CssClass="cta-primary" Disabled="@ActionsDisabled" OnClick="StartGenerateMissingAsync">
                    Generate Missing
                </SfButton>
                <SfButton CssClass="e-danger" Disabled="@ActionsDisabled" OnClick="OpenRegenerateDialog">
                    Regenerate All
                </SfButton>
                <SfButton CssClass="e-outline" OnClick="LoadAsync">Refresh</SfButton>
            </div>

            <div class="text-muted small mt-2">
                <strong>Dry run</strong> decodes and re-encodes everything but writes nothing, so its duration and
                byte total are a true rehearsal. <strong>Generate missing</strong> only touches images with no
                renditions recorded, which makes it safe to re-run after an interruption.
            </div>

            @if (_activeRun != null)
            {
                <p class="mt-2 mb-0 text-muted">Actions are unavailable while a run is active.</p>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Run history</h4>
    </div>

    <SfGrid DataSource="@_runs" AllowPaging="true" AllowSorting="true">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.Id)" HeaderText="Run" Width="80"></GridColumn>
            <GridColumn HeaderText="Mode" Width="140">
                <Template Context="row">
                    @{ var run = (ImageVariantBackfillRun)row; }
                    @ModeLabel(run)
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Scope" Width="120">
                <Template Context="row">
                    @{ var run = (ImageVariantBackfillRun)row; }
                    @ScopeLabel(run.Scope)
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.Status)" HeaderText="Status" Width="160"></GridColumn>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.CreatedAt)" HeaderText="Created" Format="g" Width="170"></GridColumn>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.GeneratedCount)" HeaderText="Images" Width="90"></GridColumn>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.VariantBlobCount)" HeaderText="Renditions" Width="110"></GridColumn>
            <GridColumn Field="@nameof(ImageVariantBackfillRun.FailedCount)" HeaderText="Failed" Width="90"></GridColumn>
            <GridColumn HeaderText="Bytes" Width="110">
                <Template Context="row">
                    @{ var run = (ImageVariantBackfillRun)row; }
                    @FormatBytes(run.BytesWritten)
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Failures" Width="110">
                <Template Context="row">
                    @{ var run = (ImageVariantBackfillRun)row; }
                    <SfButton CssClass="e-small e-outline" OnClick="@(() => ViewFailuresAsync(run.Id))">View</SfButton>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>

</div>

<SfDialog @bind-Visible="_showRegenerateDialog" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Regenerate every rendition</Header>
        <Content>
            <p>
                This rewrites the renditions for <strong>every</strong> image in
                @if (_targetContainers.Count > 0)
                {
                    <strong>@string.Join(" and ", _targetContainers)</strong>
                }
                else
                {
                    <strong>this environment</strong>
                }
                , including those that already have them. Use it after changing the rendition sizes or quality;
                otherwise <em>Generate Missing</em> is what you want.
            </p>
            <p class="text-muted">
                Nothing is lost if this is interrupted &mdash; the original full-size images are never modified,
                and renditions are always rebuilt from them.
            </p>

            <h6 class="mt-3">Confirm</h6>
            <p class="mb-1">Type <strong>@ImageVariantBackfillConfirmation.RegeneratePhrase</strong> to enable the button.</p>
            <SfTextBox CssClass="e-outline" @bind-Value="RegenerateConfirmation"
                       Placeholder="@ImageVariantBackfillConfirmation.RegeneratePhrase"></SfTextBox>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-outline" OnClick="@(() => _showRegenerateDialog = false)">Cancel</SfButton>
            <SfButton CssClass="e-danger" Disabled="@(!CanConfirmRegenerate)" OnClick="StartRegenerateAsync">
                Regenerate All Renditions
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showFailuresDialog" Width="820px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>Run @_failuresRunId failures</Header>
        <Content>
            @if (_failures.Count == 0)
            {
                <p class="mb-0">No failures were recorded for this run.</p>
            }
            else
            {
                <SfGrid DataSource="@_failures" AllowPaging="true">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(ImageVariantBackfillItemFailure.ItemKind)" HeaderText="Kind" Width="110"></GridColumn>
                        <GridColumn Field="@nameof(ImageVariantBackfillItemFailure.EntityId)" HeaderText="Id" Width="80"></GridColumn>
                        <GridColumn Field="@nameof(ImageVariantBackfillItemFailure.BlobPath)" HeaderText="Blob" Width="300"></GridColumn>
                        <GridColumn Field="@nameof(ImageVariantBackfillItemFailure.FailureCode)" HeaderText="Code" Width="140"></GridColumn>
                        <GridColumn Field="@nameof(ImageVariantBackfillItemFailure.Message)" HeaderText="Message" Width="260"></GridColumn>
                    </GridColumns>
                </SfGrid>
            }
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-outline" OnClick="@(() => _showFailuresDialog = false)">Close</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
