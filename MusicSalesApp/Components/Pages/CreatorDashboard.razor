@page "/creator/dashboard"
@inherits CreatorDashboardModel
@using Microsoft.AspNetCore.Authorization
@using MusicSalesApp.Common.Helpers
@using MusicSalesApp.Services
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Grids
@attribute [Authorize(Policy = Permissions.ManageOwnSongs)]

<PageTitle>Creator Dashboard</PageTitle>

<div class="container-fluid my-4">
    <div class="mb-4">
        <h3><i class="fas fa-chart-column me-2"></i>Creator Dashboard</h3>
        <p class="text-muted mb-0">View analytics for your music</p>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    else
    {
        <div class="dashboard-chart-section">
            <div class="dashboard-controls">
                <div class="dashboard-control-group">
                    <label class="form-label">Start Date/Time</label>
                    <SfDateTimePicker TValue="DateTime" @bind-Value="_startDate" 
                        Max="@_maxStartDate"
                        Placeholder="Start date"
                        CssClass="dashboard-datetime">
                        <DateTimePickerEvents TValue="DateTime" ValueChange="@OnStartDateChanged" />
                    </SfDateTimePicker>
                </div>
                <div class="dashboard-control-group">
                    <label class="form-label">End Date/Time</label>
                    <SfDateTimePicker TValue="DateTime" @bind-Value="_endDate" 
                        Max="@_maxEndDate"
                        Min="@_startDate"
                        Placeholder="End date"
                        CssClass="dashboard-datetime">
                        <DateTimePickerEvents TValue="DateTime" ValueChange="@OnEndDateChanged" />
                    </SfDateTimePicker>
                </div>
                <div class="dashboard-control-group">
                    <label class="form-label">Interval</label>
                    <SfDropDownList TValue="string" TItem="IntervalOption" 
                        Value="@_selectedIntervalStr" 
                        DataSource="@_intervalOptions"
                        ValueChanged="@OnIntervalChanged">
                        <DropDownListFieldSettings Text="Label" Value="Label" />
                    </SfDropDownList>
                </div>
                <div class="dashboard-filters">
                    <FilterPill Label="Genre" SearchPlaceholder="Find a genre"
                        Items="_genreItems" SelectedItems="_selectedGenres"
                        OnItemToggled="OnGenreToggled" OnCleared="OnGenreCleared" />
                    <FilterPill Label="Artist" SearchPlaceholder="Find an artist"
                        Items="_artistItems" SelectedItems="_selectedArtists"
                        OnItemToggled="OnArtistToggled" OnCleared="OnArtistCleared" />
                    <FilterPill Label="Song Title" SearchPlaceholder="Find a song"
                        Items="_songTitleItems" SelectedItems="_selectedSongTitles"
                        OnItemToggled="OnSongTitleToggled" OnCleared="OnSongTitleCleared" />
                </div>
            </div>
            <p class="text-muted dashboard-timezone-note"><small>All times shown in @(_userTimeZoneDisplayName) time zone</small></p>

            @if (_chartData != null && _chartData.Count > 0)
            {
                <SfChart Title="Overall Streams" Theme="@_chartTheme">
                    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" 
                        LabelFormat="@_chartDateFormat"
                        IntervalType="@_chartIntervalType"
                        Interval="1"
                        EdgeLabelPlacement="EdgeLabelPlacement.Shift">
                    </ChartPrimaryXAxis>
                    <ChartPrimaryYAxis Title="Number of Streams" Minimum="0" Interval="@_yAxisInterval" LabelFormat="n0">
                    </ChartPrimaryYAxis>
                    <ChartSeriesCollection>
                        <ChartSeries DataSource="@_chartData" 
                            XName="PeriodStart" 
                            YName="StreamCount" 
                            Type="ChartSeriesType.Column"
                            Name="Streams">
                        </ChartSeries>
                    </ChartSeriesCollection>
                    <ChartTooltipSettings Enable="true" />
                </SfChart>
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                    <p class="text-muted">No stream data available for the selected period.</p>
                </div>
            }
        </div>

        <div class="dashboard-payout-section mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-money-bill-wave me-2"></i>Payout History</h4>
                <div class="d-flex gap-2">
                    <SfButton CssClass="e-info" OnClick="ExportPayoutsToExcel">
                        <i class="bi bi-file-earmark-excel me-1"></i> Excel
                    </SfButton>
                    <SfButton CssClass="e-info" OnClick="ExportPayoutsToCsv">
                        <i class="bi bi-filetype-csv me-1"></i> CSV
                    </SfButton>
                    <SfButton CssClass="e-primary" OnClick="PrintPayouts">
                        <i class="bi bi-printer me-1"></i> Print
                    </SfButton>
                </div>
            </div>

            @if (_payoutHistory.Count > 0)
            {
                <SfGrid @ref="_payoutGrid"
                        TValue="PayoutHistoryViewModel"
                        DataSource="@_payoutHistory"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowExcelExport="true"
                        Height="400px" AllowResizing="true">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                    <GridColumns >
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.PaymentDate)" HeaderText="Date" Width="180" Format="g" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.SongTitle)" HeaderText="Song" Width="200" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.NumberOfStreams)" HeaderText="Streams" Width="120" Format="N0" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.GrossAmount)" HeaderText="Gross (USD)" Width="130" Format="C2" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.WithheldAmount)" HeaderText="Withheld (USD)" Width="140" Format="C2" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.NetAmount)" HeaderText="Net (USD)" Width="130" Format="C2" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(PayoutHistoryViewModel.PayPalTransactionId)" HeaderText="PayPal Transaction ID" Width="220" AllowResizing="true"></GridColumn>
                    </GridColumns>
                </SfGrid>
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center" style="min-height: 100px;">
                    <p class="text-muted">No payout history available.</p>
                </div>
            }
            <p class="text-muted mt-2"><small>All dates shown in @(_userTimeZoneDisplayName) time zone. Amounts are in USD as processed by PayPal.</small></p>
        </div>

        <!-- Tips Section -->
        <div class="tip-dashboard-section mt-4">
            <h4><i class="fas fa-heart me-2"></i>Tips</h4>

            <div class="tip-buckets">
                <div class="tip-bucket">
                    <h5>On Hold</h5>
                    <div class="tip-bucket-amount">$@(_tipsOnHoldAmount.ToString("F2"))</div>
                    <div class="tip-bucket-count">@_tipsOnHoldCount tip(s)</div>
                </div>
                <div class="tip-bucket">
                    <h5>Pending Payout</h5>
                    <div class="tip-bucket-amount">$@(_tipsPendingPayoutAmount.ToString("F2"))</div>
                    <div class="tip-bucket-count">@_tipsPendingPayoutCount tip(s)</div>
                </div>
                <div class="tip-bucket">
                    <h5>Paid</h5>
                    <div class="tip-bucket-amount">$@(_tipsPaidAmount.ToString("F2"))</div>
                    <div class="tip-bucket-count">@_tipsPaidCount tip(s)</div>
                </div>
            </div>

            @if (_tipHistory.Count > 0)
            {
                <SfGrid @ref="_tipGrid"
                        TValue="TipHistoryViewModel"
                        DataSource="@_tipHistory"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        Height="300px" AllowResizing="true">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(TipHistoryViewModel.Date)" HeaderText="Date" Width="180" Format="g" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(TipHistoryViewModel.Amount)" HeaderText="Amount (USD)" Width="130" Format="C2" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(TipHistoryViewModel.SongTitle)" HeaderText="Song" Width="200" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(TipHistoryViewModel.Status)" HeaderText="Status" Width="140" AllowResizing="true"></GridColumn>
                        <GridColumn Field="@nameof(TipHistoryViewModel.PaidDate)" HeaderText="Paid Date" Width="180" Format="g" AllowResizing="true"></GridColumn>
                    </GridColumns>
                </SfGrid>
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center" style="min-height: 100px;">
                    <p class="text-muted">No tips received yet.</p>
                </div>
            }
        </div>
    }
</div>
