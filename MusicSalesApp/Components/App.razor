@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="en">

<head>
    @((MarkupString)googleConsentDefaultHtml)
    @((MarkupString)googleTagManagerHeadHtml)
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="manifest" href="@Assets["manifest.webmanifest"]" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    @((MarkupString)metaHtml)
    @((MarkupString)googleAdsHeadHtml)
    
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Design tokens. Must load before app.css so every later sheet can read them. -->
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <!-- Theme CSS is injected dynamically by ThemeProvider component -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MusicSalesApp.styles.css"]" />
    <!-- Global breakpoint styles -->
    <link rel="stylesheet" href="@Assets["xl_app.css"]" />
    <link rel="stylesheet" href="@Assets["lg_app.css"]" />
    <link rel="stylesheet" href="@Assets["md_app.css"]" />
    <link rel="stylesheet" href="@Assets["sm_app.css"]" />
    <link rel="stylesheet" href="@Assets["xs_app.css"]" />

    <environment include="Production">
        <link rel="stylesheet" href="seo-hide-framework-ui.css" />
    </environment>

    <ImportMap />    
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @((MarkupString)googleTagManagerBodyHtml)
    <!-- Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script async defer crossorigin="anonymous" 
            src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v18.0&appId=@Configuration["Facebook:AppId"]" 
            nonce="random-nonce"></script>
    
    <Routes />
    <ReconnectModal />   
    <!-- autostart="false" so the circuit can be started with an explicit SignalR log level.
         If this script tag ever loses its companion Blazor.start() call below, the app does not
         boot at all - there is no partial failure mode here. -->
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // SignalR's browser client logs its negotiation and socket lifecycle at Information -
        // "Normalizing '_blazor' to ...", "WebSocket connected to wss://...". Useful while
        // developing, and on a listener's machine it is noise that arrives on every page load.
        //
        // Warning in Production only. Anything that actually goes wrong with the circuit is logged
        // above that level and still appears, so this quietens the narration without hiding faults.
        Blazor.start({
            circuit: {
                configureSignalR: builder => builder.configureLogging(
                    "@(HostEnvironment.IsProduction() ? "warning" : "information")")
            }
        });
    </script>
    <script src="_content/Syncfusion.Blazor/scripts/syncfusion-blazor.min.js" type="text/javascript"></script>
    <script src="https://kit.fontawesome.com/40e6b04585.js" crossorigin="anonymous"></script>
    <!-- hls.js, self-hosted from wwwroot/lib/hls. Loaded on every page because the players are
         reached from several of them and the file is cached after the first hit.

         Required rather than an enhancement: audio is served only as encrypted HLS now, and
         Safari is the only browser that plays an .m3u8 natively. Without this, Chrome, Firefox
         and Edge play nothing at all. See wwwroot/js/hls-player.js for the attach logic. -->
    <script>
        // Whether the player modules narrate themselves to the console.
        //
        // On by default, off in Production: the playback logging is written for whoever is debugging
        // a stall, and on a listener's machine it is just noise that pushes a real error off the top
        // of the console. Errors are NOT gated by this - an unrecoverable failure has to be visible
        // wherever it happens, because that is the one report a listener can actually send back.
        //
        // Note this hides nothing of consequence: DevTools shows every segment request and its SAS in
        // the Network tab no matter what the console does. Segments are ciphertext and the key sits
        // behind a token that lives about a minute, which is what the design actually relies on.
        window.__stVerbosePlayback = @((!HostEnvironment.IsProduction()).ToString().ToLowerInvariant());
    </script>
    <script src="@Assets["lib/hls/hls.min.js"]"></script>
    <script src="@Assets["js/passkey-helper.js"]"></script>    
    <script src="@Assets["js/dashboard-helper.js"]"></script>
    <script src="@Assets["js/google-ads-tracking.js"]"></script>
    <!-- DotLottie web component (registers <dotlottie-wc>), self-hosted from
         wwwroot/lib/dotlottie. The init module points the player's WASM renderer at
         our copy before registering the element - see wwwroot/js/dotlottie-init.js. -->
    <script>
        // The 1.5 MB WASM renderer is fetched by URL, not by module resolution, so it is
        // the one dotlottie asset we can point at its fingerprinted (immutable) route.
        // Without this it lands on the plain route, which MapStaticAssets marks no-cache
        // and the browser therefore revalidates on every page load.
        window.__stDotLottieWasmUrl = "@Assets["lib/dotlottie/dotlottie-player.wasm"]";
    </script>
    <script type="module" src="@Assets["js/dotlottie-init.js"]"></script>
</body>

</html>
