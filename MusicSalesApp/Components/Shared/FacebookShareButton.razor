@* Facebook Share Button Component - Styled Button *@

<a href="https://www.facebook.com/sharer/sharer.php?u=@System.Web.HttpUtility.UrlEncode(ShareUrl)" 
   target="_blank" 
   rel="noopener noreferrer"
   class="fb-share-btn @CssClass"
   onclick="window.open(this.href, 'facebook-share', 'width=550,height=450'); return false;">
    <span class="fb-logo-box">f</span>
    <span class="share-text">Share</span>
</a>

@code {
    /// <summary>
    /// The URL to share
    /// </summary>
    [Parameter]
    public string ShareUrl { get; set; } = string.Empty;

    /// <summary>
    /// Layout style: button, button_count, box_count, or icon_link
    /// </summary>
    [Parameter]
    public string Layout { get; set; } = "button_count";

    /// <summary>
    /// Button size: small, medium, or large
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "small";

    /// <summary>
    /// Custom button text (optional)
    /// </summary>
    [Parameter]
    public string ButtonText { get; set; } = string.Empty;

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;
}
