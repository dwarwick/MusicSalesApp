@inherits FollowArtistButtonModel

@*
    Renders nothing at all when there is no persona to follow. That is not a defensive check - a
    song whose artist name came from free text or a creator display name has no artist entity, so
    there is genuinely nothing to follow, and an inert or misleading button would be worse than
    its absence.
*@
@if (CreatorPersonaId > 0)
{
    <div class="follow-artist">
        <AuthorizeView>
            <Authorized>
                <SfButton CssClass="@GetButtonClass()"
                          OnClick="HandleToggleAsync"
                          Disabled="_isProcessing"
                          title="@GetButtonTitle()">
                    @(_isFollowing ? "Following ✓" : "Follow")
                </SfButton>
            </Authorized>
            <NotAuthorized>
                <SfButton CssClass="e-btn cta-outline follow-artist-button"
                          OnClick="ShowLoginDialogAsync"
                          title="@($"Follow {PersonaName}")">
                    Follow
                </SfButton>
            </NotAuthorized>
        </AuthorizeView>

        @if (ShowFollowerCount)
        {
            <span class="follow-artist-count" role="status">
                @FollowerCountText
            </span>
        }
    </div>

    <SfDialog @ref="_loginDialog" Width="400px" IsModal="true" Visible="false" CssClass="settings-dialog">
        <DialogTemplates>
            <Header>Log in to follow</Header>
            <Content>
                <p>Log in to follow @PersonaName and hear about their new music.</p>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Go to Login" IsPrimary="true" OnClick="NavigateToLoginAsync" />
            <DialogButton Content="Cancel" OnClick="CloseLoginDialogAsync" />
        </DialogButtons>
    </SfDialog>
}
