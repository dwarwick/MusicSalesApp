@inherits FollowArtistButtonModel

@*
    A bell rather than a labelled button: this now sits in the same cluster as like, dislike and
    report, which are all icons, and a word among them would read as the odd one out.

    Filled means following. That is the whole state - there is no third value - so it needs no
    label, but it does need a title and an aria-label, because a bell with no text is meaningless
    to a screen reader and ambiguous on hover.

    Renders nothing at all when there is no persona to follow. A song whose artist name came from
    free text has no artist entity, so an inert bell would invite a click that can never work.
*@
@if (CreatorPersonaId > 0)
{
    <div class="follow-artist">
        <AuthorizeView>
            <Authorized>
                <button type="button"
                        class="@GetBellClass()"
                        @onclick="HandleToggleAsync"
                        @onclick:stopPropagation="true"
                        disabled="@_isProcessing"
                        title="@GetButtonTitle()"
                        aria-pressed="@(_isFollowing ? "true" : "false")"
                        aria-label="@GetButtonTitle()">
                    @if (_isFollowing)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="action-icon">
                            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="action-icon">
                            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" />
                        </svg>
                    }
                </button>
            </Authorized>
            <NotAuthorized>
                <button type="button"
                        class="follow-artist-bell"
                        @onclick="ShowLoginDialogAsync"
                        @onclick:stopPropagation="true"
                        title="@($"Follow {PersonaName}")"
                        aria-label="@($"Follow {PersonaName}")">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="action-icon">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" />
                    </svg>
                </button>
            </NotAuthorized>
        </AuthorizeView>

        @if (ShowFollowerCount)
        {
            <span class="follow-artist-count" role="status">
                @FollowerCountText
            </span>
        }
    </div>

    @*
        Both dialogs are kept out of the render tree until something actually needs one. A library
        page renders hundreds of these bells, and a pair of dialog components per card is real
        weight for something almost nobody opens.
    *@
    @if (_dialogsRequested)
    {
        <SfDialog @bind-Visible="_showFollowAsDialog" Width="420px" IsModal="true" ShowCloseIcon="true" CssClass="settings-dialog">
            <DialogTemplates>
                <Header>Follow as</Header>
                <Content>
                    <p class="settings-prose">
                        Which of your artist names should @PersonaName see? They will be able to open your
                        artist page and follow you back.
                    </p>
                    <div class="settings-check">
                        @foreach (var option in _followAsOptions)
                        {
                            <label class="settings-label">
                                <input type="radio"
                                       name="follow-as-persona"
                                       value="@option.Id"
                                       checked="@(_selectedFollowAsPersonaId == option.Id)"
                                       @onchange="@(() => _selectedFollowAsPersonaId = option.Id)" />
                                @option.Name
                            </label>
                        }
                        @* Always available: consenting in general is not consenting to every artist. *@
                        <label class="settings-label">
                            <input type="radio"
                                   name="follow-as-persona"
                                   value="0"
                                   checked="@(_selectedFollowAsPersonaId is null)"
                                   @onchange="@(() => _selectedFollowAsPersonaId = null)" />
                            Follow anonymously
                        </label>
                    </div>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Follow" IsPrimary="true" OnClick="ConfirmFollowAsAsync" />
                <DialogButton Content="Cancel" OnClick="CancelFollowAs" />
            </DialogButtons>
        </SfDialog>

        <SfDialog @ref="_loginDialog" Width="400px" IsModal="true" Visible="false" CssClass="settings-dialog">
        <DialogTemplates>
            <Header>Log in to follow</Header>
            <Content>
                <p>Log in to follow @PersonaName and hear about their new music.</p>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Go to Login" IsPrimary="true" OnClick="NavigateToLoginAsync" />
                <DialogButton Content="Cancel" OnClick="CloseLoginDialogAsync" />
            </DialogButtons>
        </SfDialog>
    }
}
