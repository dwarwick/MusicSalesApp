@inherits FilterPillModel

@* A self-contained pill: button plus an anchored dropdown. Now composed from FilterPillButton and
   FilterPillListBody, which the music library uses separately because its pill row scrolls. The
   rendered markup is unchanged - the Creator Dashboard still gets exactly this. *@

<div class="filter-pill-container">
    <FilterPillButton Label="@Label"
                      IsActive="SelectedItems.Count > 0"
                      Count="SelectedItems.Count"
                      IsOpen="_dropdownOpen"
                      OnClick="ToggleDropdown"
                      OnClear="HandleClear" />
    @if (_dropdownOpen)
    {
        <div class="filter-pill-dropdown">
            <FilterPillListBody @ref="_body"
                                SearchPlaceholder="@SearchPlaceholder"
                                Items="Items"
                                SelectedItems="SelectedItems"
                                OnItemToggled="HandleToggle" />
        </div>
    }
</div>
