@inherits FollowedArtistsSectionModel
@using MusicSalesApp.Common.Helpers

<section class="settings-card" id="@AppPageRoutes.ManageAccountFollowingSection">
    <div class="settings-section-head">
        <div>
            <p class="settings-eyebrow">Following</p>
            <h2 class="settings-title">Artists you follow</h2>
            <p class="settings-note">
                We tell you when these artists release something new. Mute one to stay a follower without the
                notifications, or unfollow to stop hearing from them entirely. Blocking goes further.
            </p>

            @* Blocking is the one action here that cannot be guessed from its name: it also
               unfollows, it is silent, and it deliberately leaves the music alone. Collapsed
               because most people never need it, but present without leaving the page. *@
            <details class="settings-explainer">
                <summary>What happens when you block an artist?</summary>
                <ul>
                    <li>They can no longer send you messages.</li>
                    <li>You stop hearing from them completely &mdash; no new release alerts, no messages.</li>
                    <li>Blocking also unfollows them, so you leave their follower list.</li>
                    <li>
                        They are not told. All they see is their follower count change, exactly as if
                        you had simply unfollowed.
                    </li>
                    <li>
                        Their music is not affected. You can still play it, like it and add it to your
                        playlists.
                    </li>
                    <li>
                        You can undo it here with Unblock. That on its own does not start following
                        them again &mdash; if you want that back, follow them again afterwards.
                    </li>
                </ul>
            </details>
        </div>
    </div>

    @if (_loading)
    {
        <div class="settings-loading" role="status">
            <span class="settings-spinner" aria-hidden="true"></span>
            <span>Loading&hellip;</span>
        </div>
    }
    else if (_artists.Count == 0)
    {
        <div class="settings-empty">
            <p class="settings-prose">You are not following anyone yet. Look for Follow on an artist's page.</p>
            <a class="e-btn settings-btn settings-btn-violet" href="@AppPageRoutes.MusicLibrary">Browse music</a>
        </div>
    }
    else
    {
        <ul class="follow-list">
            @foreach (var artist in _artists)
            {
                <li class="follow-row persona-row">
                    <div class="follow-row-main">
                        <a class="follow-row-artist" href="@ArtistUrl(artist.ArtistName)">@artist.ArtistName</a>

                        @if (artist.IsBlocked)
                        {
                            @* A blocked row is not a follow any more - blocking unfollows - so
                               "Following since" would be untrue. Say the state instead, in the
                               words someone would use to describe it themselves. *@
                            <span class="settings-hint">
                                They cannot message you, and you no longer follow them.
                                Their music still plays normally.
                            </span>
                        }
                        else
                        {
                            <span class="settings-hint">Following since @FollowedSince(artist)</span>
                        }

                        @if (artist.LatestReleaseTitle is not null)
                        {
                            <span class="settings-hint">
                                Latest release:
                                <a href="@SongUrl(artist.LatestReleaseTitle)">@artist.LatestReleaseTitle</a>
                            </span>
                        }

                        @if (artist.UnreadMessageCount > 0)
                        {
                            <span class="status-pill">@artist.UnreadMessageCount unread</span>
                        }

                        @if (artist.IsBlocked)
                        {
                            <span class="status-pill status-pill-warn">Blocked</span>
                        }
                    </div>

                    <div class="settings-actions follow-row-actions">
                        @if (!artist.IsBlocked)
                        {
                            <SfButton CssClass="e-btn settings-btn settings-btn-small"
                                      OnClick="@(() => ToggleReleaseNotificationsAsync(artist))">
                                @(artist.ReleaseNotificationsEnabled ? "Mute new releases" : "Unmute new releases")
                            </SfButton>
                            <SfButton CssClass="e-btn settings-btn settings-btn-small"
                                      OnClick="@(() => ToggleArtistMessagesAsync(artist))">
                                @(artist.ArtistMessagesEnabled ? "Mute messages" : "Unmute messages")
                            </SfButton>

                            <SfButton CssClass="e-btn settings-btn settings-btn-danger-outline settings-btn-small"
                                      OnClick="@(() => UnfollowAsync(artist))">
                                Unfollow
                            </SfButton>
                        }

                        <SfButton CssClass="e-btn settings-btn settings-btn-danger-outline settings-btn-small"
                                  OnClick="@(() => ToggleBlockedAsync(artist))">
                            @(artist.IsBlocked ? "Unblock" : "Block")
                        </SfButton>
                    </div>
                </li>
            }
        </ul>

        @*
            The page-level banner renders above the first section and this one is several sections
            down, so a save from here would move nothing on screen and the button would read as
            dead. The status is also DIRECTIONAL - "Muted" versus "Unmuted" - because a bare "Saved"
            leaves the reader unable to tell which way the switch went.
        *@
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <p class="settings-inline-status" role="status">@_statusMessage</p>
        }
    }
</section>
