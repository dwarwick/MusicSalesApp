@namespace MusicSalesApp.Components.Shared

@* Static stand-in for a song with no cover art.

   This was a <dotlottie-wc> per card/row, which meant one live animation player -
   canvas, WASM renderer instance and requestAnimationFrame loop - for every art-less
   song, on surfaces that render the whole filtered list at once. The animation is a
   stock LottieFiles piece literally named "Loading"; used as permanent artwork it was
   both semantically wrong and off-palette (its #871c86 purple is nowhere in the theme).

   The SVG is inline rather than <img src="....svg"> deliberately: currentColor does not
   resolve inside an image-referenced SVG document, so an <img> would paint black and
   lose light/dark theming. Inline also costs no request at all, which is the whole
   point on a grid of N cards. Colour comes from .song-art-placeholder in app.css.

   Renders only the glyph - every caller keeps its own sizing wrapper. *@
<svg class="song-art-placeholder @CssClass" style="@Style"
     viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
</svg>

@code {
    /// <summary>Extra classes, e.g. the sizing class the surface already used for the animation.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    /// <summary>Inline sizing, for the Syncfusion grid cells that size their art that way.</summary>
    [Parameter] public string Style { get; set; } = string.Empty;
}
