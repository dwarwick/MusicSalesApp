@inherits FilterPillListBodyModel

@* The searchable checkbox list that fills a filter pill's dropdown. Split out of FilterPill so the
   music library can render it in a panel below its scrolling pill row. *@

<div class="filter-pill-search-container">
    <input type="text" class="filter-pill-search-input" placeholder="@SearchPlaceholder"
           @bind="_searchText" @bind:event="oninput" />
</div>
@foreach (var item in GetFilteredItems())
{
    <label class="filter-pill-dropdown-item" @key="item">
        <input type="checkbox" checked="@SelectedItems.Contains(item)"
               @onchange="(e) => HandleToggle(item, (bool)(e.Value ?? false))" />
        <span>@item (@GetItemCount(item))</span>
    </label>
}
