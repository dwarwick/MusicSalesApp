@inherits SubscribeCtaDialogModel

<SfDialog @bind-Visible="_showDialog" Width="400px" IsModal="true" ShowCloseIcon="true" CssClass="subscribe-cta-dialog">
    <DialogEvents OnClose="@OnDialogClosing" />
    <DialogTemplates>
        <Content>
            <div class="subscribe-cta-dialog-content">
                <h2 class="cta-title">@DialogTitle</h2>
                <p class="cta-description">
                    Support independent music and stream the full catalog with no limits.
                </p>
                <p class="cta-price-highlight">
                    @if (HasFreeTrialOffer)
                    {
                        <span class="price">@TrialDurationDisplay free</span><br />
                        <text>Then @OfferPriceDisplay @OfferCadenceDisplay through PayPal. Cancel anytime.</text>
                    }
                    else if (_offerQuote != null)
                    {
                        <text>Just <span class="price">@OfferPriceDisplay</span> @OfferCadenceDisplay through PayPal.<br />Cancel anytime.</text>
                    }
                    else
                    {
                        <text>Subscribe through PayPal. Cancel anytime.</text>
                    }
                </p>
                @if (!IsAuthenticated)
                {
                    <p class="cta-auth-text">
                        @(HasFreeTrialOffer ? "Log In or Register to Start Your Free Trial" : "Log In or Register to Get Started")
                    </p>
                    <div class="cta-button-group">
                        <SfButton CssClass="cta-button cta-button-login" OnClick="@NavigateToLogin">
                            Log In
                        </SfButton>
                        <SfButton CssClass="cta-button cta-button-register" OnClick="@NavigateToRegister">
                            @RegisterButtonLabel
                        </SfButton>
                    </div>
                }
                else
                {
                    <div class="cta-button-group">
                        <SfButton CssClass="cta-button" OnClick="@NavigateToSubscribe">
                            @SubscribeButtonLabel
                        </SfButton>
                    </div>
                }
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>
