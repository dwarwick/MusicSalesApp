@inherits SubscribeCtaDialogModel

<SfDialog @bind-Visible="_showDialog" Width="480px" IsModal="true" ShowCloseIcon="true" CssClass="subscribe-cta-dialog">
    <DialogTemplates>
        <Content>
            <div class="cta-card subscriber-cta subscribe-cta-dialog-content">
                <div class="cta-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
                <h2 class="cta-title">Unlimited Music Streaming</h2>
                <p class="cta-description">
                    Stream all songs with no limits. Access our entire catalog for less than $5 per month.
                </p>
                <ul class="cta-benefits">
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Full-length streaming of all songs
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Create unlimited playlists
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Personalized recommendations
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        No ads, no interruptions
                    </li>
                </ul>
                <p class="cta-price-highlight">
                    Just <span class="price">$@_subscriptionPrice</span> per month
                </p>
                @if (!IsAuthenticated)
                {
                    <p class="cta-auth-text">Log In or Register to Get Started</p>
                    <div class="cta-button-group">
                        <SfButton CssClass="cta-button cta-button-login" OnClick="@NavigateToLogin">
                            Log In
                        </SfButton>
                        <SfButton CssClass="cta-button cta-button-register" OnClick="@NavigateToRegister">
                            Register
                        </SfButton>
                    </div>
                }
                else
                {
                    <div class="cta-button-group">
                        <SfButton CssClass="cta-button" OnClick="@NavigateToSubscribe">
                            Subscribe
                        </SfButton>
                    </div>
                }
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>
