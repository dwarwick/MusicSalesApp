@using MusicSalesApp.Common.Helpers
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@inherits NavMenuModel

<SfAppBar>
    <SfButton OnClick="@ToggleMenu" IsToggle="true"><SfIcon Name="IconName.Menu" /></SfButton>

    @if (_isDarkTheme)
    {
        <img src="images/logo-dark-small.png" alt="Website Logo" class="app-logo" />
    }
    else
    {
        <img src="images/logo-light-small.png" alt="Website Logo" class="app-logo" />
    }

    <AppBarSpacer></AppBarSpacer>
    <div class="theme-switcher">
        <span class="theme-label">@(_isDarkTheme ? "Dark" : "Light")</span>
        <SfSwitch @bind-Checked="_isDarkTheme" ValueChange="@OnThemeChanged" TChecked="bool" />
    </div>
</SfAppBar>

@if (ShowTestingServerBanner)
{
    <div class="test-server-banner">
        <span class="test-server-banner-label">@TestingServerBannerText</span>
        <a class="test-server-banner-link"
           href="@ProductionServerUrl"
           target="_blank"
           rel="noopener noreferrer">@ProductionServerUrl</a>
    </div>
}

@if (_showMaintenanceWarning)
{
    <div class="maintenance-banner">
        <span class="maintenance-warning-label">
            &#9888; Planned maintenance: @_maintenanceStartLocal &ndash; @_maintenanceEndLocal @_maintenanceTzAbbr
        </span>
    </div>
}

@if (_showMaintenanceDialog)
{
    <SfDialog @bind-Visible="_showMaintenanceDialog" Width="450px" IsModal="true" ShowCloseIcon="false"
              CssClass="maintenance-notice-dialog" AllowDragging="false">
        <DialogTemplates>
            <Header>
                <span class="maintenance-dialog-header">&#9888; Planned Maintenance Notice</span>
            </Header>
            <Content>
                <div class="maintenance-dialog-content">
                    <p>We have scheduled maintenance during the following time:</p>
                    <p class="maintenance-dialog-times">
                        <strong>@_maintenanceStartLocal</strong> &ndash; <strong>@_maintenanceEndLocal</strong> @_maintenanceTzAbbr
                    </p>
                    <p>The site may be temporarily unavailable during this period. We apologize for any inconvenience.</p>
                </div>
            </Content>
            <FooterTemplate>
                <SfButton OnClick="AcknowledgeMaintenance" IsPrimary="true" CssClass="e-btn e-primary maintenance-ack-button">
                    I Understand
                </SfButton>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

<SfSidebar @ref="_sidebar"
           @bind-IsOpen="_isMenuOpen"
           Width="220px"
           Type="SidebarType.Over"
           Position="SidebarPosition.Left"
           CloseOnDocumentClick="true">
    <ChildContent>
        <div class="sidebar-content">
            <div class="sidebar-menu">
                <SfMenu CssClass="e-inherit ms-2 mt-2" TValue="MenuItem" Orientation="Orientation.Vertical">
                    <MenuItems>
                        <MenuItem Url="/" Text="Home" IconCss="fas fa-house"></MenuItem>
                        <MenuItem Url="/music-library" Text="Music Library" IconCss="fas fa-music"></MenuItem>

                        <AuthorizeView Policy="@Permissions.NonValidatedUser">
                            <Authorized>
                                <MenuItem Url="/validate-email" Text="Validate my Email" IconCss="fas fa-envelope-circle-check"></MenuItem>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Policy="@Permissions.ValidatedUser">
                            <Authorized>
                                <MenuItem Url="/my-playlists" Text="My Playlists" IconCss="fas fa-list"></MenuItem>
                                <MenuItem Url="/manage-account" Text="Manage Account" IconCss="fas fa-user-gear"></MenuItem>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Policy="@Permissions.UploadFiles">
                            <Authorized>
                                <MenuItem Url="/upload-files" Text="  Upload Music" IconCss="fas fa-cloud-arrow-up"></MenuItem>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Policy="@Permissions.ManageOwnSongs">
                            <Authorized>
                                <MenuItem Url="/creator/dashboard" Text="  Dashboard" IconCss="fas fa-chart-column"></MenuItem>
                                <MenuItem Url="/creator/songs" Text="  Manage My Songs" IconCss="fas fa-file-audio"></MenuItem>
                                <MenuItem Url="/creator/personas" Text="  Manage My Personas" IconCss="fas fa-person-rays"></MenuItem>
                            </Authorized>
                        </AuthorizeView>

                <AuthorizeView Policy="@Permissions.ManageUsers">
                    <Authorized>
                        <MenuItem Separator="true"></MenuItem>
                        <MenuItem Text="Admin" IconCss="fas fa-shield-halved" Disabled="true"></MenuItem>
                        <MenuItem Url="/admin/users" Text="  Manage Users" IconCss="fas fa-users-gear"></MenuItem>                        
                        <MenuItem Url="/admin/messages" Text="  User Messages" IconCss="fas fa-envelope-open-text"></MenuItem>
                        <MenuItem Url="/admin/contact-messages" Text="  Contact Messages" IconCss="fas fa-inbox"></MenuItem>
                        <MenuItem Url="/admin/songs" Text="  Song Management" IconCss="fas fa-file-audio"></MenuItem>
                        <MenuItem Url="/admin/song-status-history" Text="  Song Status History" IconCss="fas fa-clock-rotate-left"></MenuItem>
                        <MenuItem Url="/admin/personas" Text="  Persona Management" IconCss="fas fa-person-rays"></MenuItem>
                        <MenuItem Url="/admin/user-history" Text="  User History" IconCss="fas fa-user-clock"></MenuItem>
                        <MenuItem Url="/admin/payouts" Text="  Payouts" IconCss="fas fa-money-bill-transfer"></MenuItem>
                        <MenuItem Url="/admin/tip-fraud" Text="  Tip Fraud Monitor" IconCss="fas fa-shield-virus"></MenuItem>
                        <MenuItem Url="/admin/reported-songs" Text="  Reported Songs" IconCss="fas fa-flag"></MenuItem>
                        <MenuItem Url="/admin/logs" Text="  View Logs" IconCss="fas fa-file-lines"></MenuItem>
                        <MenuItem Url="/hangfire" Text="  Hangfire Dashboard" IconCss="fas fa-gauge-high"></MenuItem>
                        <MenuItem Url="/admin/settings" Text="  Settings" IconCss="fas fa-solid fa-gear"></MenuItem>
                        <MenuItem Separator="true"></MenuItem>
                    </Authorized>
                </AuthorizeView>

                        <AuthorizeView>
                            <Authorized>
                                <MenuItem Url="/logout" Text="Logout" IconCss="fas fa-arrow-right-from-bracket"></MenuItem>
                            </Authorized>
                            <NotAuthorized>
                                <MenuItem Url="/login" Text="Login" IconCss="fas fa-arrow-right-to-bracket"></MenuItem>
                                <MenuItem Url="/register" Text="Register" IconCss="fas fa-user-plus"></MenuItem>
                            </NotAuthorized>
                        </AuthorizeView>
                    </MenuItems>
                    <MenuEvents TValue="MenuItem" ItemSelected="CloseMenu"></MenuEvents>
                </SfMenu>
            </div>
            <div class="sidebar-footer">
                <SfMenu CssClass="e-inherit ms-2" TValue="MenuItem" Orientation="Orientation.Vertical">
                    <MenuItems>
                        <MenuItem Url="mailto://customerservice@streamtunes.net" Text="Contact Us" IconCss="fas fa-solid fa-paper-plane"></MenuItem>
                        <MenuItem Url="/terms-of-use" Text="Terms of Use" IconCss="fas fa-file-contract"></MenuItem>
                        <MenuItem Url="/privacy-policy" Text="Privacy Policy" IconCss="fas fa-shield-halved"></MenuItem>
                        <MenuItem Url="/account-deletion" Text="Account Deletion" IconCss="fas fa-user-slash"></MenuItem>
                        <MenuItem Url="/creator-agreement" Text="Creator Agreement" IconCss="fas fa-file-signature"></MenuItem>
                        <MenuItem Url="/user-refund-policy" Text="User Refund Policy" IconCss="fas fa-money-bill-wave"></MenuItem>
                    </MenuItems>
                    <MenuEvents TValue="MenuItem" ItemSelected="CloseMenu"></MenuEvents>
                </SfMenu>
                <div class="copyright-notice">
                    © @DateTime.Now.Year Streamtunes
                </div>
                @if (!string.IsNullOrEmpty(_appVersion))
                {
                    <div class="copyright-notice">
                        version: @_appVersion
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</SfSidebar>
