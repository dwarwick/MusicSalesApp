@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Hosting
@using MusicSalesApp.Components.Shared
@inject IWebHostEnvironment HostEnvironment

<ThemeProvider @rendermode="InteractiveServer" />
<AdminMessageDialogHost @rendermode="InteractiveServer" />

<div class="page">
    <NavMenu @rendermode="InteractiveServer" />

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @if (HostEnvironment.IsDevelopment() || HostEnvironment.IsEnvironment("Test"))
    {
        <span>An unhandled error has occurred.</span>
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    }
</div>
